{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=ollama_benchmark.db"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "DefaultContextLength": 2048,
    "HistoryBudgetFraction": 0.60,
    "ContextReserveFraction": 0.25,
    "BaseTokensGpu": 1800,
    "BaseTokensCpu": 1200,
    "RepeatPenalty": 1.1,
    "TopKLow": 40,
    "TopKHigh": 600,
    "TopPLow": 0.85,
    "TopPHigh": 0.92,
    "ModelLoadOverheadFactor": 1.2,
    "WindowsOverheadMb": 350,
    "VramReserveFraction": 0.10,
    "MaxContextCap": 32768
  },
  "JudgeScoreWeights": {
    "Factual": 20,
    "Formatting": 10,
    "Compliance": 10,
    "Relevance": 10,
    "Tone": 5,
    "Conciseness": 5,
    "Clarity": 10,
    "Readability": 10,
    "HaloEffect": 0,
    "Safety": 10,
    "LanguageConsistency": 5,
    "LoopDetection": 5
  },
  "AllowedHosts": "*",
  "DetailedErrors": false,
  "Security": {
    "EnableHttpsRedirection": true
  }
}
