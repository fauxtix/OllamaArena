@page "/modelos-ollama"
@using System.Text.Json
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaArena.Components.Pages.Components
@using OllamaArena.Resources
@using OllamaArena.Services.Interfaces.Services
@using static OllamaArena.Models.DTO.OllamaModels
@inject IStringLocalizer<SharedResources> L
@inject IOllamaGpuService OllamaGpuService
@inject IJSRuntime JS
@inject ILogger<ModelosOllama>? Logger
@rendermode InteractiveServer

<PageTitle>@L["Modelos.PageTitle"]</PageTitle>

<div class="page">

<PageHeader Title="@L["Modelos.LocalInstalled"]"
             Subtitle="@L["Modelos.IntroText"]" />

<div class="toolbar">
    <div class="toolbar-content">
        <div class="toolbar-row">
            <FluentLabel Typo="Typography.Body"
                        Style="color: var(--neutral-foreground-hint);">
                @L["Modelos.HelpCount", _localModels?.Count ?? 0]
            </FluentLabel>
            <FluentSpacer />
            <FluentButton Appearance="Appearance.Outline"
                          IconStart="@(new Icons.Regular.Size20.Info())"
                          OnClick="@(() => _showColumnHelp = true)">
                @L["Modelos.HelpButton"]
            </FluentButton>
        </div>
    </div>
</div>

<div style="margin-top: 15px;">
    @if (_isLoading)
    {
        <FluentProgressRing />
    }
    else if (_localModels is null || !_localModels.Any())
    {
        <FluentBadge Appearance="Appearance.Accent">
            @L["Modelos.NoLocalModels"]
        </FluentBadge>
    }
    else
    {
        <div class="table-scroll">
            <FluentDataGrid Items="@_localModels.AsQueryable()" TGridItem="ModelDetails" ResizableColumns="true">
            <PropertyColumn Property="@(m => m.Name)" Title="@L["Modelos.ColName"]" Sortable="true"
                            Style="color:steelblue; font-weight:700; font-size: 1rem;" />

            <TemplateColumn Title="@L["Modelos.ColFamily"]" Width="180px">
                @context.Details?.Family
            </TemplateColumn>

            <TemplateColumn Title="@L["Modelos.ColParameters"]" Align="Align.Center" Width="120px">
                @context.Details?.ParameterSize
            </TemplateColumn>

            <TemplateColumn Title="@L["Modelos.ColQuantization"]" Width="130px" Align="Align.Center">
                @context.Details?.QuantizationLevel
            </TemplateColumn>

            <TemplateColumn Title="@L["Modelos.ColTrainingYear"]" Align="Align.Center" Width="140px"
                            Style="color:cadetblue; font-weight:500; font-size: 0.9rem;">
                @context.TrainingYear
            </TemplateColumn>

            <TemplateColumn Title="@L["Modelos.ColMaxContext"]" Width="170px">
                <FluentStack Orientation="Orientation.Horizontal"
                             HorizontalAlignment="HorizontalAlignment.Right"
                             VerticalAlignment="VerticalAlignment.Center"
                             Style="gap: 6px;">
                    <span>@L["Modelos.ContextTokens", context.ContextLength.ToString("N0")]</span>
                </FluentStack>
            </TemplateColumn>

            <TemplateColumn Title="@L["Modelos.ColDiskSize"]" Align="Align.Center" Width="170px">
                @L["Modelos.SizeInGB", context.SizeInGB]
            </TemplateColumn>

            <TemplateColumn Title="@L["Modelos.ColReasoning"]" Align="Align.Center" Width="130px">
                @switch (context.SupportsThinking)
                {
                    case true:
                        <FluentBadge Fill="success">@L["Modelos.ReasoningYes"]</FluentBadge>
                        break;
                    case false:
                        <FluentBadge Appearance="Appearance.Neutral">@L["Modelos.ReasoningNo"]</FluentBadge>
                        break;
                    default:
                        <FluentBadge Appearance="Appearance.Neutral">@L["Modelos.ReasoningUnknown"]</FluentBadge>
                        break;
                }
            </TemplateColumn>

            <TemplateColumn Title="@L["Modelos.ColGpuCompat"]" Width="180px">
                @{
                    if (!_gpuChecks.TryGetValue(context.Name, out var gpuCheck) || gpuCheck.AvailableVramGB == 0)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">@L["Modelos.VramUnavailable"]</FluentBadge>
                    }
                    else if (gpuCheck.FitsInGpu)
                    {
                        <FluentBadge Appearance="Appearance.Accent" Fill="success">
                            @L["Modelos.GpuCompatible", gpuCheck.EstimatedRequiredMemoryGB]
                        </FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Fill="warning">
                            @L["Modelos.ExceedsVram", gpuCheck.EstimatedRequiredMemoryGB]
                        </FluentBadge>
                    }
                }
            </TemplateColumn>
        </FluentDataGrid>
        </div>
    }
</div>

</div>

<ModelColumnsInfoDialog Visible="@_showColumnHelp"
                        VisibleChanged="@(v => _showColumnHelp = v)" />

@code {
    private List<ModelDetails>? _localModels;
    private Dictionary<string, GpuStatus> _gpuChecks = new(StringComparer.OrdinalIgnoreCase);
    private bool _isLoading = true;
    private bool _showColumnHelp = false;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = false
    };

    private const string NamesKey = "ollamaModels"; 
    private const string FullKey = "ollamaModelsFullV2"; 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            if (_localModels is null || !_localModels.Any())
            {
                // 1. Tentar carregar a cache completa guardada pela Home (localStorage)
                _localModels = await LoadFullFromStorageAsync();

                if (_localModels is null || !_localModels.Any())
                {
                    // Cache vazia → ir ao Ollama, filtrar, enriquecer e gravar
                    var names = await LoadNamesFromStorageAsync() ?? [];

                    var response = await OllamaGpuService.GetLocalModelsAsync();
                    var allModels = response.Models ?? [];

                    // Filtrar só os que estão nos nomes guardados (ou usar todos se a lista de nomes estiver vazia)
                    _localModels = names.Any()
                        ? allModels.Where(m => names.Contains(m.Model)).ToList()
                        : allModels;

                    // Enriquecer
                    foreach (var model in _localModels)
                    {
                        var metadata = await OllamaGpuService.GetExtendedModelMetadataAsync(model.Model);
                        model.ContextLength = metadata.ContextLength;
                        model.TrainingYear = metadata.TrainingYear;
                        model.SupportsThinking = metadata.SupportsThinking;
                    }

                    // Guardar a versão completa para próximas visitas
                    await SaveFullToStorageAsync(_localModels);
                }
            }

            // Compatibilidade GPU calculada de forma assíncrona para todas as linhas
            _gpuChecks = new Dictionary<string, GpuStatus>(StringComparer.OrdinalIgnoreCase);
            if (_localModels is not null)
            {
                foreach (var model in _localModels)
                {
                    _gpuChecks[model.Name] = await OllamaGpuService.CheckGpuCompatibility(model.SizeInBytes);
                }
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Erro ao carregar modelos na página Modelos Ollama");
            _localModels = [];
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<List<string>?> LoadNamesFromStorageAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", NamesKey);
            if (string.IsNullOrWhiteSpace(json)) return null;
            return JsonSerializer.Deserialize<List<string>>(json);
        }
        catch { return null; }
    }

    private async Task<List<ModelDetails>?> LoadFullFromStorageAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", FullKey);
            if (string.IsNullOrWhiteSpace(json)) return null;
            return JsonSerializer.Deserialize<List<ModelDetails>>(json, JsonOptions);
        }
        catch { return null; }
    }

    private async Task SaveFullToStorageAsync(List<ModelDetails> models)
    {
        var json = JsonSerializer.Serialize(models, JsonOptions);
        await JS.InvokeVoidAsync("localStorage.setItem", FullKey, json);
    }
}

<style>
    .page {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--fill-color);
    }

    .toolbar {
        flex: 0 0 auto;
        padding: 4px 12px;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        background: var(--fill-color);
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .toolbar-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .toolbar-row {
        display: flex;
        gap: 10px;
        align-items: center;
        width: 100%;
        margin: 6px 0;
        flex-wrap: wrap;
    }

    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        text-align: center;
        min-height: 120px;
    }

    fluent-badge {
        --badge-fill-warning: #ff3c2e;
        --badge-color-warning: blue;
    }

    fluent-badge {
        --badge-fill-success: green;
        --badge-color-success: #fff;
    }

    .table-scroll {
        overflow-x: auto;
        min-width: 0;
    }

        .table-scroll fluent-data-grid {
            min-width: 720px;
        }

    @@media (max-width: 768px) {
        .toolbar-row {
            margin: 8px 0 !important;
            gap: 8px !important;
        }

        .toolbar-row fluent-spacer,
        .toolbar-row div.spacer {
            flex: 0 0 100%;
            height: 0;
        }
    }

</style>