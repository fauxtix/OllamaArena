@page "/plano-de-testes"
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaArena.Resources
@rendermode InteractiveServer

<PageTitle>@L["TestPlan.PageTitle"]</PageTitle>

<div class="testplan-main">
    <div class="testplan-card">

        <div class="testplan-header-row">
            <div class="testplan-title">
                <FluentHeader Style="background-color:transparent; color: #2ecc71; font-size:1.5rem; margin: 0; padding: 0;">
                    @L["TestPlan.Title"]
                </FluentHeader>
            </div>

            <div class="testplan-badge">
                <FluentIcon Value="@(new Icons.Regular.Size16.Eye())" />
                <span>@L["TestPlan.ReadOnly"]</span>
            </div>
        </div>
        <hr class="card-divider" />

        @if (_isLoading)
        {
            <FluentProgressRing>@L["TestPlan.Loading"]</FluentProgressRing>
        }
        else if (_planFile is null)
        {
            <div class="testplan-empty-state">
                <span>@L["TestPlan.EmptyState"]</span>
            </div>
        }
        else
        {
            <div class="testplan-markdown">
                @((MarkupString)RenderedHtml)
            </div>

            <div class="testplan-footer-exit">
                <FluentButton Appearance="Appearance.Lightweight"
                              Style="border-radius:10px"
                              IconStart="@(new Icons.Regular.Size16.ArrowExit())"
                              OnClick="@(() => NavigationManager.NavigateTo("/"))">
                    @L["TestPlan.Exit"]
                </FluentButton>
            </div>
        }
    </div>
</div>

<style>
    .testplan-main {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        box-sizing: border-box;
        max-width: 100%;
        align-items: stretch;
        padding: 1rem;
        height: calc(100vh - 80px);
    }

    .testplan-card {
        background-color: var(--neutral-layer-2);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 12px;
        padding: 1.5rem !important;
        box-shadow: var(--elevation-shadow-card-rest, 0 4px 12px rgba(0, 0, 0, 0.15));
        display: flex;
        flex-direction: column;
        height: 100%;
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
    }

    .card-divider {
        border: 0;
        border-top: 1px solid var(--neutral-stroke-rest);
        margin: 1rem 0;
        flex: 0 0 auto;
    }

    .testplan-header-row {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex: 0 0 auto;
    }

    .testplan-title {
        flex: 1;
        display: flex;
        justify-content: flex-start;
    }

    .testplan-badge {
        flex: 1;
        display: flex;
        gap: 0.4rem;
        justify-content: flex-end;
        align-items: center;
        color: var(--neutral-foreground-hint);
        font-size: 0.9rem;
    }

    .testplan-markdown {
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
        max-width: 62rem;
        margin: 0 auto;
        padding: 0 .25rem;
        overflow-y: auto;
        overflow-x: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 1rem;
        line-height: 1.65;
        color: var(--neutral-foreground-rest);
    }

    .testplan-markdown h1 {
        font-size: 1.55rem;
        margin: 0 0 1rem;
        padding-bottom: .4rem;
        border-bottom: 2px solid var(--neutral-stroke-rest);
    }

    .testplan-markdown h2 {
        font-size: 1.3rem;
        margin: 2rem 0 .75rem;
        padding-bottom: .3rem;
        border-bottom: 1px solid var(--neutral-stroke-rest);
    }

    .testplan-markdown h3 {
        font-size: 1.12rem;
        margin: 1.5rem 0 .5rem;
    }

    .testplan-markdown p {
        margin: .5rem 0;
    }

    .testplan-markdown ul,
    .testplan-markdown ol {
        margin: .5rem 0;
        padding-left: 1.5rem;
    }

    .testplan-markdown li {
        margin: .3rem 0;
    }

    .testplan-markdown input[type="checkbox"] {
        margin-right: .5rem;
        accent-color: var(--accent-fill-rest);
    }

    .testplan-markdown table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
        font-size: .95rem;
    }

    .testplan-markdown th,
    .testplan-markdown td {
        border: 1px solid var(--neutral-stroke-rest);
        padding: .5rem .8rem;
        text-align: left;
        vertical-align: top;
    }

    .testplan-markdown th {
        background: rgba(128, 128, 128, .10);
        font-weight: 600;
    }

    .testplan-markdown code {
        font-family: Consolas, 'Cascadia Mono', monospace;
        font-size: .88em;
        padding: .1em .38em;
        border-radius: 5px;
        background: rgba(128, 128, 128, .14);
    }

    .testplan-markdown pre {
        background: rgba(128, 128, 128, .12);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 8px;
        padding: .85rem 1rem;
        margin: .75rem 0;
        overflow-x: auto;
    }

    .testplan-markdown pre code {
        background: transparent;
        padding: 0;
        font-size: .9em;
    }

    .testplan-markdown blockquote {
        margin: 1rem 0;
        padding: .65rem 1rem;
        border-left: 4px solid var(--accent-fill-rest);
        border-radius: 0 8px 8px 0;
        background: rgba(128, 128, 128, .07);
    }

    .testplan-markdown blockquote p {
        margin: .25rem 0;
    }

    .testplan-markdown hr {
        border: 0;
        border-top: 1px solid var(--neutral-stroke-rest);
        margin: 1.75rem 0;
    }

    .testplan-markdown a {
        color: var(--accent-fill-rest);
    }

    .testplan-markdown strong {
        font-weight: 600;
    }

    .testplan-empty-state {
        flex: 1 1 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--neutral-foreground-hint);
        font-size: 1.1rem;
    }

    .testplan-footer-exit {
        display: flex;
        justify-content: flex-end;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
        flex: 0 0 auto;
    }

    @@media (max-width: 900px) {
        .testplan-main {
            flex-direction: column;
            gap: 1rem;
            height: auto;
        }

        .testplan-header-row {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }

        .testplan-badge, .testplan-footer-exit {
            justify-content: flex-end;
        }
    }
</style>
