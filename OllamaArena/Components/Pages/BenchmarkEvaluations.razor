@page "/benchmark-evaluations"
@rendermode InteractiveServer

@using Models.DTO
@using OllamaArena.Components.Pages.Components
@using OllamaArena.Services.Interfaces.Repositories
@using OllamaArena.Services.Interfaces.Services
@using OllamaArena.Services.Helpers
@using Microsoft.Extensions.Localization
@using OllamaArena.Resources
@inject IStringLocalizer<SharedResources> L
@inject IBenchmarkQueryRepository QueryRepo
@inject IBenchmarkCommandRepository CommandRepo
@inject IDialogService DialogService
@inject ILogger<App> Logger
@inject IAnalysisService AnalysisService
@inject IJSRuntime JS
@* Gera e serve a folha de cálculo. Vive num serviço (e não na página) porque a
   geração é CPU-bound e precisa de existir também no endpoint HTTP. *@
@inject IBenchmarkExcelExporter ExcelExporter

<PageTitle>@L["BenchmarkEvaluations.PageTitle"]</PageTitle>

<div class="page">
    <PageHeader Title="@L["BenchmarkEvaluations.PageTitle"]" />

    <div class="toolbar">

        <div class="toolbar-content">

            <div class="toolbar-row" style="display: flex; gap: 10px; align-items: center; width: 100%; margin:10px; flex-wrap: wrap;">
                @* Value/ValueChanged explícitos: o reset da paginação é assíncrono
               (SetCurrentPageIndexAsync), por isso não pode ser um setter de
               propriedade. *@
                <FluentSearch Value="@Pesquisa"
                              ValueChanged="@PesquisaAlterada"
                              Placeholder="@L["Benchmarks.SearchPlaceholder"]"
                              class="search-box" />
                    <FluentSpacer />
                    <FluentButton Appearance="Appearance.Outline"
                                  Disabled="@(_quantidadeFiltrados == 0 || _isExporting)"
                                  IconStart="@(new Icons.Regular.Size24.ArrowDownload())"
                                  @onclick="ExportarParaExcel">
                        @L["Common.ExportExcel"]
                    </FluentButton>
                    @* <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 8px;"> *@
                        <FluentButton Appearance="Appearance.Outline"
                                      Disabled="@(!_podeExportarPdf || _isExporting)"
                                      IconStart="@(new Icons.Regular.Size24.DocumentText())"
                                      @onclick="ExportarParaPdfAsync">
                            @L["Benchmarks.ExportPdf"]
                        </FluentButton>
                        @if (!_podeExportarPdf && _quantidadePorAvaliar > 0)
                        {
                            <FluentLabel Style="color: var(--neutral-foreground-hint); font-size: 12px; max-width: 280px;">
                                @L["Benchmarks.ExportPdfHint", _quantidadePorAvaliar]
                            </FluentLabel>
                        }
                    @* </FluentStack> *@
                    <FluentButton Appearance="Appearance.Accent"
                                  Disabled="@(_quantidadeFiltrados == 0 || _isAnalyzing || _isExporting)"
                                  IconStart="@(new Icons.Regular.Size24.BrainCircuit())"
                                  @onclick="AnalisarResultadosComModeloLocal">
                        @L["Benchmarks.AnalysisLocal"]
                    </FluentButton>

                    <FluentButton Id="@DeleteMenuAnchorId"
                                  Appearance="Appearance.Lightweight"
                                  Disabled="@(_benchmarks.Count == 0 || _isExporting)"
                                  Color="rgba(255, 255,255, 1)"
                                  BackgroundColor="rgba(231, 54, 24, 1)" Style="color:white"
                                  IconStart="@(new Icons.Regular.Size16.Delete())">
                        @L["Benchmarks.DeleteAll"]
                    </FluentButton>
                    <FluentMenu Anchor="@DeleteMenuAnchorId" Trigger="MouseButton.Left">
                        <FluentMenuItem OnClick="@(() => DeleteByScopeAsync(DeleteScope.Filtrados))"
                                        Disabled="@(_quantidadeFiltrados == 0)">
                            @L["Benchmarks.DeleteFiltered", _quantidadeFiltrados]
                        </FluentMenuItem>
                        <FluentMenuItem OnClick="@(() => DeleteByScopeAsync(DeleteScope.PorAvaliar))"
                                        Disabled="@(_quantidadePorAvaliar == 0)">
                            @L["Benchmarks.DeleteUnevaluated", _quantidadePorAvaliar]
                        </FluentMenuItem>
                        <FluentMenuItem OnClick="@(() => DeleteByScopeAsync(DeleteScope.Avaliados))"
                                        Disabled="@(_quantidadeAvaliadas == 0)">
                            @L["Benchmarks.DeleteEvaluated", _quantidadeAvaliadas]
                        </FluentMenuItem>
                        <FluentMenuItem OnClick="@(() => DeleteByScopeAsync(DeleteScope.Todos))"
                                        Disabled="@(_benchmarks.Count == 0)">
                            @L["Benchmarks.DeleteAllWithCount", _benchmarks.Count]
                        </FluentMenuItem>
                    </FluentMenu>

            </div>

            <div class="filter-bar">
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.Todos)"
                              IconStart="@(new Icons.Regular.Size20.Grid())"
                              @onclick="@(() => SelecionarFiltroAsync(BenchmarkFilter.Todos))">
                    @L["Benchmarks.FilterAll"]
                </FluentButton>
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.PorAvaliar)"
                              IconStart="@(new Icons.Regular.Size20.Warning())"
                              @onclick="@(() => SelecionarFiltroAsync(BenchmarkFilter.PorAvaliar))">
                    @L["Benchmarks.FilterToEvaluate"]
                </FluentButton>
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.Avaliados)"
                              IconStart="@(new Icons.Regular.Size20.Checkmark())"
                              @onclick="@(() => SelecionarFiltroAsync(BenchmarkFilter.Avaliados))">
                    @L["Benchmarks.FilterEvaluated"]
                </FluentButton>
            </div>

        </div>

    </div>
    <div class="grid-container">

        <FluentDataGrid Items="@_filtroConsulta"
                        TGridItem="BenchmarkEvaluationModel"
                        Pagination="@_pagination" OnRowDoubleClick="OnDoubleClick"
                        RowSize="DataGridRowSize.Medium"
                        DisplayMode="DataGridDisplayMode.Grid"
                        class="benchmark-grid">


            <PropertyColumn Property="@(b => b.ResponseId)" Width="110px" Align="Align.Center" Sortable="true" >
                <HeaderCellTitleTemplate>
                    <span class="header-columns">@L["SystemLogs.ColId"]</span>
                </HeaderCellTitleTemplate>

            </PropertyColumn>
            <PropertyColumn Property="@(b => b.NomeModelo)" Title="@L["Benchmarks.ColModel"]" Sortable="true" Width="200px">
                <HeaderCellTitleTemplate>
                    <span class="header-columns">@L["Benchmarks.ColModel"]</span>
                </HeaderCellTitleTemplate>
            </PropertyColumn>

            <TemplateColumn Title="@L["Benchmarks.ColDescription"]" Tooltip="true" Width="290px" Align="Align.Start">
                <HeaderCellTitleTemplate>
                    <span class="header-columns">@L["Benchmarks.ColDescription"]</span>
                </HeaderCellTitleTemplate>
                <ChildContent Context="context">
                    <div class="prompt-cell">
                        @context.Descricao
                    </div>
                </ChildContent>
            </TemplateColumn>

            <PropertyColumn Property="@(b => b.GeminiRating)" Title="@L["Evaluation.Judge1"]" Align="Align.Center" Width="90px" Sortable="true">
                <HeaderCellTitleTemplate>
                    <span class="header-blue">@L["Evaluation.Judge1"]</span>
                </HeaderCellTitleTemplate>
            </PropertyColumn>
            <PropertyColumn Property="@(b => b.OpenRouterRating)" Title="@L["Evaluation.Judge2"]" Align="Align.Center" Width="130px" Sortable="true">
                <HeaderCellTitleTemplate>
                    <span class="header-blue">@L["Evaluation.Judge2"]</span>
                </HeaderCellTitleTemplate>
            </PropertyColumn>
            <PropertyColumn Property="@(b => b.TokensPorSegundo)" Title="@L["Benchmarks.ColTokensPerSecond"]" Align="Align.Center" Width="110px" Format="F2" Sortable="true">
                <HeaderCellTitleTemplate>
                    <span class="header-columns">@L["Benchmarks.ColTokensPerSecond"]</span>
                </HeaderCellTitleTemplate>
            </PropertyColumn>
            @* TempoPuroFormatado/TempoCargaFormatado são "m:ss": sem um comparador
               próprio a grelha ordenava-os como texto ("10:00" antes de "1:05"). *@
            <PropertyColumn Property="@(b => b.TempoPuroFormatado)" Title="@L["Benchmarks.ColTime"]" Align="Align.Center" Width="90px" Sortable="true" Comparer="@DurationTextComparer.Instance">
                <HeaderCellTitleTemplate>
                    <span class="header-columns">@L["Benchmarks.ColTime"]</span>
                </HeaderCellTitleTemplate>

            </PropertyColumn>
            <PropertyColumn Property="@(b => b.TempoCargaFormatado)" Title="@L["Benchmarks.ColLoad"]" Align="Align.Center" Width="100px" Sortable="true" Comparer="@DurationTextComparer.Instance">
                <HeaderCellTitleTemplate>
                    <span class="header-columns">@L["Benchmarks.ColLoad"]</span>
                </HeaderCellTitleTemplate>

            </PropertyColumn>
            <PropertyColumn Property="@(b => b.TamanhoTokens)" Title="@L["Benchmarks.ColTokens"]" Align="Align.Center" Width="100px" Sortable="true">
                <HeaderCellTitleTemplate>
                    <span class="header-columns">@L["Benchmarks.ColTokens"]</span>
                </HeaderCellTitleTemplate>
            </PropertyColumn>

            <TemplateColumn Title="@L["Benchmarks.ColActions"]" Align="Align.Center" Width="100px">
                <FluentButton Appearance="Appearance.Outline"
                              IconStart="@(new Icons.Regular.Size24.Eye())"
                              OnClick="@(() => OpenDetailDialog(context))"
                              Title="@L["Benchmarks.ViewDetails"]" />
                <FluentButton Appearance="Appearance.Outline"
                              Color="rgba(255, 255,255, 1)"
                              BackgroundColor="rgba(231, 54, 24, 1)" Style="color:white"
                              IconStart="@(new Icons.Regular.Size16.Delete())"
                              OnClick="@(() => DeleteBenchmark(context.ResponseId))"
                              Title="@L["Benchmarks.Delete"]" />
            </TemplateColumn>


        </FluentDataGrid>

    </div>

    <div class="pager">
        <FluentPaginator State="@_pagination" />
    </div>
    @if (_mostrarPainelAnalise)
    {
        <FluentDialog Hidden="@(!_mostrarPainelAnalise)"
                      Modal="true"
                      Class="evaluation-detail-benchmark analysis-dialog"
                      Style="--dialog-width: 800px; --dialog-height: auto;"
                      TrapFocus="true"
                      AriaLabel="@L["Benchmarks.AriaLabelDetail"]">
            <FluentDialogBody>
                @* O viewer só recebe o estado: a análise corre no componente pai, que é quem
               tem o CancellationTokenSource. *@
                <BenchmarkAnalysisViewer IsAnalyzing="@_isAnalyzing"
                                         AnaliseResultado="@_resultadoLocal"
                                         OnCancelarAnalise="@CancelarAnaliseDoPai" />
            </FluentDialogBody>
            <FluentDialogFooter>
                <FluentSpacer />
                <FluentButton Appearance="Appearance.Outline" Color="Color.Neutral"
                              Disabled="@_isAnalyzing"
                              OnClick="@(() => _mostrarPainelAnalise = false)">
                    @L["Common.Close"]
                </FluentButton>
            </FluentDialogFooter>
        </FluentDialog>
    }

</div>

<BenchmarkEvaluationDetail Response="@_selectedBenchmarkResponse"
                           Visible="@_isDialogVisible"
                           VisibleChanged="@((v) => _isDialogVisible = v)"
                           OnClose="@(() => _isDialogVisible = false)" />



<style>
    .page {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: var(--fill-color);
    }

    /* Cabeçalho partilhado: afasta-o das margens da página (a .page não tem padding) */
    .page > .page-header-block {
        width: auto;
        margin: 16px 16px 18px 16px;
    }
    .toolbar {
        flex: 0 0 auto;
        padding: 10px 12px;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        background: var(--fill-color);
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .search-box {
        width: 100%;
        max-width: 520px;
    }

    .grid-container {
        margin-top: 1rem;
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
        display: flex;
    }

    fluent-data-grid {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
    }

    .prompt-cell {
        display: block;
        white-space: pre-wrap !important;
        overflow-wrap: break-word !important;
        word-break: break-word !important;
        min-width: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        color: var(--neutral-foreground-rest);
    }

    fluent-data-grid-cell {
        white-space: normal !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }

        fluent-data-grid-cell[grid-column="Prompt"] {
            white-space: normal !important;
            overflow: visible !important;
            text-overflow: unset !important;
        }

    .pager {
        flex: 0 0 auto;
        position: sticky;
        bottom: 0;
        z-index: 30;
        display: flex;
        gap: 6px;
        justify-content: center;
        padding: 8px 0;
        background: var(--fill-color);
        border-top: 1px solid var(--neutral-stroke-rest);
        backdrop-filter: blur(6px);
    }

    .toolbar-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .filter-bar {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

        .filter-bar fluent-button {
            border-radius: 999px;
            min-width: 140px;
            transition: all .15s ease;
        }

    .filter-icon {
        margin-right: 6px;
    }

    @@media (max-width: 768px) {
        .filter-bar {
            flex-wrap: wrap;
        }

            .filter-bar fluent-button {
                min-width: auto;
            }

        .toolbar-row {
            margin: 12px 8px !important;
            gap: 8px !important;
        }

        .search-box {
            max-width: 100%;
            flex: 1 1 100%;
        }

        .toolbar-row fluent-spacer,
        .toolbar-row div.spacer {
            flex: 0 0 100%;
            height: 0;
        }
    }

    .header-blue {
        display: flex;
        justify-content: center;
        color: var(--accent-fill-rest, #0078d4) !important;
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 3px;
        border: 1px solid var(--neutral-stroke-rest);
        align-items: center;
        padding: 2px 8px;
        white-space: nowrap;
    }

    .header-columns {
        color: var(--accent-fill-rest, #0078d4);
        font-weight: 700;
    }

    fluent-dialog.analysis-dialog::part(control) {
        max-height: calc(100vh - 48px);
    }

    fluent-dialog.analysis-dialog .fluent-dialog-body {
        min-height: 0;
        overflow-y: auto;
        scrollbar-gutter: stable;
    }

</style>
