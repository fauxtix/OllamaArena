@page "/dashboard"
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaArena.Models.DTO
@using OllamaArena.Resources
@using OllamaArena.Services.Interfaces.Repositories
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject IBenchmarkRepository BenchmarkRepo
@inject IJSRuntime JS

<PageTitle>@L["Dashboard.PageTitle"]</PageTitle>

<h2 class="fluent-h2" style="margin-bottom: 4px;">@L["Dashboard.Title"]</h2>
<p class="fluent-body" style="margin-bottom: 20px; color: var(--neutral-foreground-hint);">
    @L["Dashboard.Intro"]
</p>

@if (_isLoading)
{
    <FluentProgressRing />
}
else
{
    <FluentStack Orientation="Orientation.Horizontal" Style="gap: 16px; flex-wrap: wrap; margin-bottom: 20px;">
        <FluentCard Style="min-width: 260px; padding: 16px;">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--neutral-foreground-hint);">@L["Dashboard.BestModel"]</div>
            <div style="font-size: 20px; font-weight: 700; margin-top: 6px;">@(BestModel?.Model ?? L["Dashboard.NoEvaluations"])</div>
            @if (BestModel is not null)
            {
                <div style="color: var(--accent-fill-rest); font-weight: 600; margin-top: 4px;">@L["Dashboard.Score", BestModel.Score.ToString("F1")]</div>
            }
        </FluentCard>

        <FluentCard Style="min-width: 200px; padding: 16px;">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--neutral-foreground-hint);">@L["Dashboard.ModelsCount"]</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 6px;">@_ranking.Count</div>
        </FluentCard>

        <FluentCard Style="min-width: 200px; padding: 16px;">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--neutral-foreground-hint);">@L["Dashboard.EvaluationsCount"]</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 6px;">@_ranking.Sum(r => r.JudgedResponses)</div>
        </FluentCard>
    </FluentStack>

    @if (_chartData.Count > 0)
    {
        <h3 class="fluent-h3" style="margin: 24px 0 4px 0;">@L["Dashboard.QualityTitle"]</h3>
        <p class="fluent-body" style="margin: 0 0 16px 0; color: var(--neutral-foreground-hint);">
            @L["Dashboard.ScatterHint"]
        </p>

        <div class="dashboard-graficos">

            <div class="grafico-card">
                <div class="grafico-header">
                    <span class="grafico-titulo">@L["Dashboard.RadarGeminiTitle"]</span>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                  OnClick="@(() => DownloadGraficoAsync("graficoRadarDashboardGemini", "dashboard_radar_gemini"))" />
                </div>
                @if (_chartData.Any(c => c.GeminiCount > 0))
                {
                    <div class="canvas-container-radar">
                        <canvas id="graficoRadarDashboardGemini"></canvas>
                    </div>
                }
                else
                {
                    <p class="radar-sem-dados">@L["ChartDialog.RadarNoData"]</p>
                }
            </div>

            <div class="grafico-card">
                <div class="grafico-header">
                    <span class="grafico-titulo">@L["Dashboard.RadarOpenRouterTitle"]</span>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                  OnClick="@(() => DownloadGraficoAsync("graficoRadarDashboardOpenRouter", "dashboard_radar_openrouter"))" />
                </div>
                @if (_chartData.Any(c => c.OpenRouterCount > 0))
                {
                    <div class="canvas-container-radar">
                        <canvas id="graficoRadarDashboardOpenRouter"></canvas>
                    </div>
                }
                else
                {
                    <p class="radar-sem-dados">@L["ChartDialog.RadarNoData"]</p>
                }
            </div>

            <div class="grafico-card grafico-card-scatter">
                <div class="grafico-header">
                    <span class="grafico-titulo">@L["Dashboard.ScatterTitle"]</span>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                  OnClick="@(() => DownloadGraficoAsync("graficoScatterTokens", "dashboard_scatter_tokens_score"))" />
                </div>
                <div class="canvas-container-scatter">
                    <canvas id="graficoScatterTokens"></canvas>
                </div>
            </div>

        </div>
    }

    @if (_ranking.Count == 0)
    {
        <FluentBadge Appearance="Appearance.Accent">@L["Dashboard.NoEvaluations"]</FluentBadge>
    }
    else
    {
        <div class="table-scroll">
            <FluentDataGrid Items="@_ranking.AsQueryable()" TGridItem="ModelRanking" ResizableColumns="true" GenerateHeader="GenerateHeaderOption.Sticky">
                <TemplateColumn Title="#" Align="Align.Center" Width="60px">
                    @(_ranking.IndexOf(context) + 1)
                </TemplateColumn>

                <PropertyColumn Property="@(r => r.Model)" Title="@L["Dashboard.ColModel"]" Sortable="true" Style="font-weight:600;" />

                <TemplateColumn Title="@L["Dashboard.ColScore"]" Width="280px" SortBy="@(SortScore)">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 8px; width: 100%;">
                        <FluentProgress Min="0" Max="5" Value="@((int)context.Score)" Width="100%" />
                        <span style="min-width: 44px; font-weight: 600;">@context.Score.ToString("F1")</span>
                    </FluentStack>
                </TemplateColumn>

                <PropertyColumn Property="@(r => r.GeminiScore)" Title="@L["Dashboard.ColGemini"]" Align="Align.Center" Width="110px" Sortable="true" />
                <PropertyColumn Property="@(r => r.OpenRouterScore)" Title="@L["Dashboard.ColOpenRouter"]" Align="Align.Center" Width="130px" Sortable="true" />
                <PropertyColumn Property="@(r => r.TotalResponses)" Title="@L["Dashboard.ColResponses"]" Align="Align.Center" Width="120px" Sortable="true" />
                <PropertyColumn Property="@(r => r.JudgedResponses)" Title="@L["Dashboard.ColJudged"]" Align="Align.Center" Width="130px" Sortable="true" />
            </FluentDataGrid>
        </div>
    }
}

@code {
    private List<ModelRanking> _ranking = new();
    private List<ModelChartData> _chartData = new();
    private ModelRanking? BestModel => _ranking.FirstOrDefault();
    private bool _isLoading = true;
    private bool _graficosRenderizados = false;
    private readonly Dictionary<string, string> _coresDosModelos = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ranking = await BenchmarkRepo.GetModelRankingAsync();
            _chartData = await BenchmarkRepo.GetModelChartDataAsync();
        }
        catch
        {
            _ranking = new();
            _chartData = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && _chartData.Count > 0 && !_graficosRenderizados)
        {
            _graficosRenderizados = true;
            await Task.Delay(200);
            await RenderizarGraficosAsync();

            StateHasChanged();
        }
    }

    private async Task RenderizarGraficosAsync()
    {
        if (_chartData.Count == 0)
            return;

        _coresDosModelos.Clear();
        foreach (var modelo in _chartData.Select(c => c.Model))
        {
            if (!_coresDosModelos.ContainsKey(modelo))
                _coresDosModelos[modelo] = GerarCorAleatoria();
        }

        var radarGemini = GerarDadosRadar(juizGemini: true);
        if (radarGemini != null)
            await RenderizarComRetryAsync("graficoRadarDashboardGemini", radarGemini, "pts", "radar");

        var radarOpenRouter = GerarDadosRadar(juizGemini: false);
        if (radarOpenRouter != null)
            await RenderizarComRetryAsync("graficoRadarDashboardOpenRouter", radarOpenRouter, "pts", "radar");

        await RenderizarScatterComRetryAsync("graficoScatterTokens", GerarDadosScatter());
    }

    private string[] MetricasLabels => new[]
    {
    L["Evaluation.MetricFactual"].Value,
    L["Evaluation.MetricFormatting"].Value,
    L["Evaluation.MetricCompliance"].Value,
    L["Evaluation.MetricRelevance"].Value,
    L["Evaluation.MetricTone"].Value,
    L["Evaluation.MetricConciseness"].Value,
    L["Evaluation.MetricClarity"].Value,
    L["Evaluation.MetricReadability"].Value,
    L["Evaluation.MetricHaloEffect"].Value,
    L["Evaluation.MetricSafety"].Value,
    L["Evaluation.MetricLanguageConsistency"].Value,
    L["Evaluation.MetricLoopDetection"].Value
};

    private object? GerarDadosRadar(bool juizGemini)
    {
        var modelos = _chartData
            .Where(c => juizGemini ? c.GeminiCount > 0 : c.OpenRouterCount > 0)
            .ToList();

        if (modelos.Count == 0)
            return null;

        var datasets = modelos.Select(c =>
        {
            var cor = _coresDosModelos[c.Model];
            return new
            {
                label = c.Model,
                data = juizGemini ? c.GeminiMetrics : c.OpenRouterMetrics,
                borderColor = cor,
                backgroundColor = CorPreenchimento(cor),
                borderWidth = 2,
                pointBackgroundColor = cor,
                pointRadius = 3,
                fill = true
            };
        }).ToList();

        return new { labels = MetricasLabels, datasets };
    }

    private object GerarDadosScatter()
    {
        var datasets = _chartData.Select(c =>
        {
            var cor = _coresDosModelos[c.Model];
            return new
            {
                label = c.Model,
                data = new[] { new { x = c.TokensPorSegundo, y = c.Score } },
                backgroundColor = cor,
                borderColor = cor,
                pointRadius = 6,
                pointHoverRadius = 8
            };
        }).ToList();

        return new { datasets };
    }

    private async Task RenderizarComRetryAsync(string canvasId, object dados, string unidade, string tipo)
    {
        for (int tentativa = 0; tentativa < 8; tentativa++)
        {
            var renderizado = await JS.InvokeAsync<bool>("benchmarkCharts.renderGrafico", canvasId, dados, unidade, tipo);
            if (renderizado)
                return;
            await Task.Delay(100);
        }
    }

    private async Task RenderizarScatterComRetryAsync(string canvasId, object dados)
    {
        for (int tentativa = 0; tentativa < 8; tentativa++)
        {
            var renderizado = await JS.InvokeAsync<bool>("benchmarkCharts.renderScatter", canvasId, dados, "tokens/s", "pts");
            if (renderizado)
                return;
            await Task.Delay(100);
        }
    }

    private async Task DownloadGraficoAsync(string canvasId, string nomeFicheiro)
    {
        await JS.InvokeVoidAsync("benchmarkCharts.downloadGrafico", canvasId, nomeFicheiro);
    }

    private static string GerarCorAleatoria()
    {
        var rnd = new Random();
        return $"rgba({rnd.Next(50, 210)}, {rnd.Next(50, 210)}, {rnd.Next(50, 210)}, 0.85)";
    }

    private static string CorPreenchimento(string cor)
    {
        return cor.Replace("0.85)", "0.18)");
    }

    private GridSort<ModelRanking> SortScore => GridSort<ModelRanking>
        .ByDescending(r => r.Score);
}

<style>
    .table-scroll {
        overflow-x: auto;
        min-width: 0;
    }

        .table-scroll fluent-data-grid {
            min-width: 760px;
        }

    .dashboard-graficos {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    .grafico-card {
        background: var(--neutral-layer-1);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 8px;
        padding: 20px;
    }

    .grafico-card-scatter {
        grid-column: 1 / -1;
    }

    .grafico-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .grafico-titulo {
        font-weight: 600;
        font-size: 14px;
        color: var(--neutral-foreground-rest);
    }

    .canvas-container-radar {
        position: relative;
        width: 100%;
        max-width: 480px;
        height: 400px;
        margin: 0 auto;
    }

    .canvas-container-scatter {
        position: relative;
        width: 100%;
        height: 340px;
    }

    .radar-sem-dados {
        color: var(--neutral-foreground-hint);
        font-size: 13px;
        font-style: italic;
        margin: 24px 0;
    }

    @@media (max-width: 768px) {
        .dashboard-graficos {
            grid-template-columns: 1fr;
        }

        .grafico-card-scatter {
            grid-column: 1;
        }

        .canvas-container-radar {
            height: 320px;
        }

        .canvas-container-scatter {
            height: 260px;
        }
    }
</style>
