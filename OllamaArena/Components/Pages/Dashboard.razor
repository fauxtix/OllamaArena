@page "/dashboard"
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaArena.Models.DTO
@using OllamaArena.Resources
@using OllamaArena.Services.Interfaces.Repositories
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject IBenchmarkRepository BenchmarkRepo
@inject IJSRuntime JS

<PageTitle>@L["Dashboard.PageTitle"]</PageTitle>

<h2 class="fluent-h2" style="margin-bottom: 4px;">@L["Dashboard.Title"]</h2>
<p class="fluent-body" style="margin-bottom: 20px; color: var(--neutral-foreground-hint);">
    @L["Dashboard.Intro"]
</p>

@if (_isLoading)
{
    <FluentProgressRing />
}
else
{
    <div class="dashboard-cartoes">
        <FluentCard Class="cartao cartao-accent">
            <div class="cartao-barra"></div>
            <div class="cartao-corpo">
                <div class="cartao-icone">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Trophy())" Color="Color.Custom" CustomColor="var(--accent-fill-rest)" />
                </div>
                <div class="cartao-info">
                    <div class="cartao-rotulo">@L["Dashboard.BestModel"]</div>
                    <div class="cartao-valor">@(BestModel?.Model ?? L["Dashboard.NoEvaluations"])</div>
                    @if (BestModel is not null)
                    {
                        <div class="cartao-destaque">@L["Dashboard.Score", BestModel.Score.ToString("F1")]</div>
                    }
                </div>
            </div>
        </FluentCard>

        <FluentCard Class="cartao cartao-success">
            <div class="cartao-barra"></div>
            <div class="cartao-corpo">
                <div class="cartao-icone">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Database())" Color="Color.Custom" CustomColor="var(--success)" />
                </div>
                <div class="cartao-info">
                    <div class="cartao-rotulo">@L["Dashboard.ModelsCount"]</div>
                    <div class="cartao-valor">@_ranking.Count</div>
                </div>
            </div>
        </FluentCard>

        <FluentCard Class="cartao cartao-warning">
            <div class="cartao-barra"></div>
            <div class="cartao-corpo">
                <div class="cartao-icone">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Checkmark())" Color="Color.Custom" CustomColor="var(--warning)" />
                </div>
                <div class="cartao-info">
                    <div class="cartao-rotulo">@L["Dashboard.CoverageLabel"]</div>
                    <div class="cartao-valor">@(Stats?.CoberturaPercentual is not null ? $"{Stats.CoberturaPercentual.Value}%" : "—")</div>
                    @if (Stats is not null && Stats.TotalRespostas > 0)
                    {
                        <div class="cartao-destaque">@L["Dashboard.CoverageDetail", Stats.RespostasAvaliadasAmbosJuizes, Stats.TotalRespostas]</div>
                    }
                </div>
            </div>
        </FluentCard>

        <FluentCard Class="cartao cartao-accent">
            <div class="cartao-barra"></div>
            <div class="cartao-corpo">
                <div class="cartao-icone">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ClipboardCode())" Color="Color.Custom" CustomColor="var(--accent-fill-rest)" />
                </div>
                <div class="cartao-info">
                    <div class="cartao-rotulo">@L["Dashboard.PromptsCount"]</div>
                    <div class="cartao-valor">@(Stats?.TotalPrompts ?? 0)</div>
                    @if (Stats?.UltimaAtividade is not null)
                    {
                        <div class="cartao-destaque">@L["Dashboard.LastActivity", Stats.UltimaAtividade.Value.ToLocalTime().ToString("g")]</div>
                    }
                </div>
            </div>
        </FluentCard>

        <FluentCard Class="cartao cartao-success">
            <div class="cartao-barra"></div>
            <div class="cartao-corpo">
                <div class="cartao-icone">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Flash())" Color="Color.Custom" CustomColor="var(--success)" />
                </div>
                <div class="cartao-info">
                    <div class="cartao-rotulo">@L["Dashboard.FastestModel"]</div>
                    <div class="cartao-valor">@(FastestModel?.Model ?? L["Dashboard.NoEvaluations"])</div>
                    @if (FastestModel is not null)
                    {
                        <div class="cartao-destaque">@L["Dashboard.FastestSpeed", FastestModel.TokensPerSecond.ToString("F1")]</div>
                    }
                </div>
            </div>
        </FluentCard>

        <FluentCard Class="cartao cartao-warning">
            <div class="cartao-barra"></div>
            <div class="cartao-corpo">
                <div class="cartao-icone">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ArrowSwap())" Color="Color.Custom" CustomColor="var(--warning)" />
                </div>
                <div class="cartao-info">
                    <div class="cartao-rotulo">@L["Dashboard.JudgeDivergence"]</div>
                    <div class="cartao-valor">@(MostDivergentModel?.Model ?? L["Dashboard.NoEvaluations"])</div>
                    @if (MostDivergentModel is not null)
                    {
                        <div class="cartao-destaque">@L["Dashboard.DivergenceValue", MostDivergentModel.JudgeDivergence!.Value.ToString("F2")]</div>
                    }
                </div>
            </div>
        </FluentCard>
    </div>

    @if (_chartData.Count > 0)
    {
        <h3 class="fluent-h3" style="margin: 24px 0 4px 0;">@L["Dashboard.QualityTitle"]</h3>
        <p class="fluent-body" style="margin: 0 0 16px 0; color: var(--neutral-foreground-hint);">
            @L["Dashboard.ScatterHint"]
        </p>

        <div class="dashboard-graficos">

            <div class="grafico-card">
                <div class="grafico-header">
                    <span class="grafico-titulo">@L["Dashboard.RadarGeminiTitle"]</span>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                  OnClick="@(() => DownloadGraficoAsync("graficoRadarDashboardGemini", "dashboard_radar_gemini"))" />
                </div>
                @if (_chartData.Any(c => c.GeminiCount > 0))
                {
                    <div class="canvas-container-radar">
                        <canvas id="graficoRadarDashboardGemini"></canvas>
                    </div>
                }
                else
                {
                    <p class="radar-sem-dados">@L["ChartDialog.RadarNoData"]</p>
                }
            </div>

            <div class="grafico-card">
                <div class="grafico-header">
                    <span class="grafico-titulo">@L["Dashboard.RadarOpenRouterTitle"]</span>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                  OnClick="@(() => DownloadGraficoAsync("graficoRadarDashboardOpenRouter", "dashboard_radar_openrouter"))" />
                </div>
                @if (_chartData.Any(c => c.OpenRouterCount > 0))
                {
                    <div class="canvas-container-radar">
                        <canvas id="graficoRadarDashboardOpenRouter"></canvas>
                    </div>
                }
                else
                {
                    <p class="radar-sem-dados">@L["ChartDialog.RadarNoData"]</p>
                }
            </div>

            <div class="grafico-card grafico-card-scatter">
                <div class="grafico-header">
                    <span class="grafico-titulo">@L["Dashboard.ScatterTitle"]</span>
                    <FluentButton Appearance="Appearance.Stealth"
                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                  OnClick="@(() => DownloadGraficoAsync("graficoScatterTokens", "dashboard_scatter_tokens_score"))" />
                </div>
                <div class="canvas-container-scatter">
                    <canvas id="graficoScatterTokens"></canvas>
                </div>
            </div>

            @if (_timeline.Count > 0)
            {
                <div class="grafico-card grafico-card-scatter">
                    <div class="grafico-header">
                        <span class="grafico-titulo">@L["Dashboard.TimelineTitle"]</span>
                        <FluentButton Appearance="Appearance.Stealth"
                                      IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                      OnClick="@(() => DownloadGraficoAsync("graficoEvolucaoScore", "dashboard_evolucao_score"))" />
                    </div>
                    <div class="canvas-container-scatter">
                        <canvas id="graficoEvolucaoScore"></canvas>
                    </div>
                </div>
            }

        </div>
    }

    @if (_ranking.Count == 0)
    {
        <FluentBadge Appearance="Appearance.Accent">@L["Dashboard.NoEvaluations"]</FluentBadge>
    }
    else
    {
        <div class="table-scroll">
            <FluentDataGrid Items="@_ranking.AsQueryable()" TGridItem="ModelRanking" ResizableColumns="true" GenerateHeader="GenerateHeaderOption.Sticky">
                <TemplateColumn Title="#" Align="Align.Center" Width="60px">
                    @(_ranking.IndexOf(context) + 1)
                </TemplateColumn>

                <PropertyColumn Property="@(r => r.Model)" Title="@L["Dashboard.ColModel"]" Sortable="true" Style="font-weight:600;" />

                <TemplateColumn Title="@L["Dashboard.ColScore"]" Width="280px" SortBy="@(SortScore)">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Style="gap: 8px; width: 100%;">
                        <FluentProgress Min="0" Max="5" Value="@((int)context.Score)" Width="100%" />
                        <span style="min-width: 44px; font-weight: 600;">@context.Score.ToString("F1")</span>
                    </FluentStack>
                </TemplateColumn>

                <PropertyColumn Property="@(r => r.GeminiScore)" Title="@L["Dashboard.ColGemini"]" Align="Align.Center" Width="110px" Sortable="true" />
                <PropertyColumn Property="@(r => r.OpenRouterScore)" Title="@L["Dashboard.ColOpenRouter"]" Align="Align.Center" Width="130px" Sortable="true" />
                <PropertyColumn Property="@(r => r.TokensPerSecond)" Title="@L["Dashboard.ColTokensPerSecond"]" Align="Align.Center" Width="110px" Format="F2" Sortable="true" />
                <TemplateColumn Title="@L["Dashboard.ColAvgTime"]" Align="Align.Center" Width="110px" SortBy="@(SortAvgTime)">
                    @FormatarTempoMedio(context.AvgResponseTimeMs)
                </TemplateColumn>
                <TemplateColumn Title="@L["Dashboard.ColDivergence"]" Align="Align.Center" Width="120px" SortBy="@(SortDivergence)">
                    @(context.JudgeDivergence?.ToString("F2") ?? "—")
                </TemplateColumn>
                <PropertyColumn Property="@(r => r.AvgResponseTokens)" Title="@L["Dashboard.ColAvgTokens"]" Align="Align.Center" Width="140px" Format="F0" Sortable="true" />
            </FluentDataGrid>
        </div>
    }
}

@code {
    private List<ModelRanking> _ranking = new();
    private List<ModelChartData> _chartData = new();
    private List<ModelScoreTimeline> _timeline = new();
    private DashboardStats? Stats;
    private ModelRanking? BestModel => _ranking.FirstOrDefault();
    private ModelRanking? FastestModel => _ranking.OrderByDescending(r => r.TokensPerSecond).FirstOrDefault();
    private ModelRanking? MostDivergentModel => _ranking
        .Where(r => r.JudgeDivergence.HasValue)
        .OrderByDescending(r => r.JudgeDivergence!.Value)
        .FirstOrDefault();
    private bool _isLoading = true;
    private bool _graficosRenderizados = false;
    private readonly Dictionary<string, string> _coresDosModelos = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ranking = await BenchmarkRepo.GetModelRankingAsync();
            _chartData = await BenchmarkRepo.GetModelChartDataAsync();
            Stats = await BenchmarkRepo.GetDashboardStatsAsync();
            _timeline = await BenchmarkRepo.GetScoreTimelineAsync();
        }
        catch
        {
            _ranking = new();
            _chartData = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && _chartData.Count > 0 && !_graficosRenderizados)
        {
            _graficosRenderizados = true;
            await Task.Delay(200);
            await RenderizarGraficosAsync();

            StateHasChanged();
        }
    }

    private async Task RenderizarGraficosAsync()
    {
        if (_chartData.Count == 0)
            return;

        _coresDosModelos.Clear();
        foreach (var modelo in _chartData.Select(c => c.Model))
        {
            if (!_coresDosModelos.ContainsKey(modelo))
                _coresDosModelos[modelo] = GerarCorAleatoria();
        }

        var radarGemini = GerarDadosRadar(juizGemini: true);
        if (radarGemini != null)
            await RenderizarComRetryAsync("graficoRadarDashboardGemini", radarGemini, "pts", "radar");

        var radarOpenRouter = GerarDadosRadar(juizGemini: false);
        if (radarOpenRouter != null)
            await RenderizarComRetryAsync("graficoRadarDashboardOpenRouter", radarOpenRouter, "pts", "radar");

        await RenderizarScatterComRetryAsync("graficoScatterTokens", GerarDadosScatter());

        var evolucao = GerarDadosEvolucao();
        if (evolucao != null)
            await RenderizarLinhaComRetryAsync("graficoEvolucaoScore", evolucao);
    }

    private string[] MetricasLabels => new[]
    {
    L["Evaluation.MetricFactual"].Value,
    L["Evaluation.MetricFormatting"].Value,
    L["Evaluation.MetricCompliance"].Value,
    L["Evaluation.MetricRelevance"].Value,
    L["Evaluation.MetricTone"].Value,
    L["Evaluation.MetricConciseness"].Value,
    L["Evaluation.MetricClarity"].Value,
    L["Evaluation.MetricReadability"].Value,
    L["Evaluation.MetricHaloEffect"].Value,
    L["Evaluation.MetricSafety"].Value,
    L["Evaluation.MetricLanguageConsistency"].Value,
    L["Evaluation.MetricLoopDetection"].Value
};

    private object? GerarDadosRadar(bool juizGemini)
    {
        var modelos = _chartData
            .Where(c => juizGemini ? c.GeminiCount > 0 : c.OpenRouterCount > 0)
            .ToList();

        if (modelos.Count == 0)
            return null;

        var datasets = modelos.Select(c =>
        {
            var cor = _coresDosModelos[c.Model];
            return new
            {
                label = c.Model,
                data = juizGemini ? c.GeminiMetrics : c.OpenRouterMetrics,
                borderColor = cor,
                backgroundColor = CorPreenchimento(cor),
                borderWidth = 2,
                pointBackgroundColor = cor,
                pointRadius = 3,
                fill = true
            };
        }).ToList();

        return new { labels = MetricasLabels, datasets };
    }

    private object GerarDadosScatter()
    {
        var datasets = _chartData.Select(c =>
        {
            var cor = _coresDosModelos[c.Model];
            return new
            {
                label = c.Model,
                data = new[] { new { x = c.TokensPorSegundo, y = c.Score } },
                backgroundColor = cor,
                borderColor = cor,
                pointRadius = 6,
                pointHoverRadius = 8
            };
        }).ToList();

        return new { datasets };
    }

    // Linha temporal: labels = união das datas de benchmark (todas as séries alinhadas
    // no mesmo eixo); cada modelo leva null nas datas em que não foi avaliado.
    private object? GerarDadosEvolucao()
    {
        var modelos = _timeline.Where(t => t.Points.Count > 0).ToList();
        if (modelos.Count == 0)
            return null;

        var datas = modelos
            .SelectMany(t => t.Points)
            .Select(p => p.Data)
            .Distinct()
            .OrderBy(d => d)
            .ToList();

        var datasets = modelos.Select(t =>
        {
            var cor = _coresDosModelos[t.Model];
            var porData = t.Points.GroupBy(p => p.Data).ToDictionary(g => g.Key, g => g.Last().ScoreAcumulado);
            return new
            {
                label = t.Model,
                data = datas.Select(d => porData.TryGetValue(d, out var v) ? (double?)v : null).ToArray(),
                borderColor = cor,
                backgroundColor = cor,
                borderWidth = 2,
                pointRadius = 3,
                pointHoverRadius = 6,
                tension = 0.3,
                fill = false
            };
        }).ToList();

        return new { labels = datas.Select(d => d.ToLocalTime().ToString("dd/MM HH:mm")).ToList(), datasets };
    }

    private async Task RenderizarComRetryAsync(string canvasId, object dados, string unidade, string tipo)
    {
        for (int tentativa = 0; tentativa < 8; tentativa++)
        {
            var renderizado = await JS.InvokeAsync<bool>("benchmarkCharts.renderGrafico", canvasId, dados, unidade, tipo);
            if (renderizado)
                return;
            await Task.Delay(100);
        }
    }

    private async Task RenderizarScatterComRetryAsync(string canvasId, object dados)
    {
        for (int tentativa = 0; tentativa < 8; tentativa++)
        {
            var renderizado = await JS.InvokeAsync<bool>("benchmarkCharts.renderScatter", canvasId, dados, "tokens/s", "pts");
            if (renderizado)
                return;
            await Task.Delay(100);
        }
    }

    private async Task RenderizarLinhaComRetryAsync(string canvasId, object dados)
    {
        for (int tentativa = 0; tentativa < 8; tentativa++)
        {
            var renderizado = await JS.InvokeAsync<bool>("benchmarkCharts.renderLinha", canvasId, dados, "pts");
            if (renderizado)
                return;
            await Task.Delay(100);
        }
    }

    private async Task DownloadGraficoAsync(string canvasId, string nomeFicheiro)
    {
        await JS.InvokeVoidAsync("benchmarkCharts.downloadGrafico", canvasId, nomeFicheiro);
    }

    private static string GerarCorAleatoria()
    {
        var rnd = new Random();
        return $"rgba({rnd.Next(50, 210)}, {rnd.Next(50, 210)}, {rnd.Next(50, 210)}, 0.85)";
    }

    private static string CorPreenchimento(string cor)
    {
        return cor.Replace("0.85)", "0.18)");
    }

    private GridSort<ModelRanking> SortScore => GridSort<ModelRanking>
        .ByDescending(r => r.Score);

    private GridSort<ModelRanking> SortAvgTime => GridSort<ModelRanking>
        .ByDescending(r => r.AvgResponseTimeMs);

    private GridSort<ModelRanking> SortDivergence => GridSort<ModelRanking>
        .ByDescending(r => r.JudgeDivergence ?? -1);

    // Mesmo formato curto de TempoProcessamentoCurtoFormatado ("96,5s" / "3,42s")
    private static string FormatarTempoMedio(double ms)
    {
        var segundos = ms / 1000.0;
        return segundos < 10 ? $"{segundos:F2}s" : $"{segundos:F1}s";
    }
}

<style>
    .table-scroll {
        overflow-x: auto;
        min-width: 0;
    }

    .dashboard-cartoes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .dashboard-cartoes fluent-card {
        margin: 0;
    }

    .dashboard-cartoes .cartao {
        display: flex;
        align-items: stretch;
        padding: 0;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--neutral-stroke-rest);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .dashboard-cartoes .cartao:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    }

    .cartao-barra {
        flex: 0 0 6px;
        width: 6px;
        align-self: stretch;
    }

    .cartao-corpo {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        min-width: 0;
    }

    .cartao-icone {
        flex: 0 0 44px;
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .cartao-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .cartao-rotulo {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--neutral-foreground-hint);
    }

    .cartao-valor {
        font-size: 22px;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cartao-destaque {
        font-size: 13px;
        font-weight: 600;
        color: var(--accent-fill-rest);
    }

    .cartao-accent .cartao-barra {
        background: var(--accent-fill-rest);
    }

    .cartao-accent .cartao-icone {
        background: color-mix(in srgb, var(--accent-fill-rest) 14%, transparent);
    }

    .cartao-success .cartao-barra {
        background: var(--success);
    }

    .cartao-success .cartao-icone {
        background: color-mix(in srgb, var(--success) 16%, transparent);
    }

    .cartao-warning .cartao-barra {
        background: var(--warning);
    }

    .cartao-warning .cartao-icone {
        background: color-mix(in srgb, var(--warning) 16%, transparent);
    }

        .table-scroll fluent-data-grid {
            min-width: 1080px;
        }

    .dashboard-graficos {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    .grafico-card {
        background: var(--neutral-layer-1);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 8px;
        padding: 20px;
    }

    .grafico-card-scatter {
        grid-column: 1 / -1;
    }

    .grafico-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .grafico-titulo {
        font-weight: 600;
        font-size: 14px;
        color: var(--neutral-foreground-rest);
    }

    .canvas-container-radar {
        position: relative;
        width: 100%;
        max-width: 480px;
        height: 400px;
        margin: 0 auto;
    }

    .canvas-container-scatter {
        position: relative;
        width: 100%;
        height: 340px;
    }

    .radar-sem-dados {
        color: var(--neutral-foreground-hint);
        font-size: 13px;
        font-style: italic;
        margin: 24px 0;
    }

    @@media (max-width: 768px) {
        .dashboard-graficos {
            grid-template-columns: 1fr;
        }

        .dashboard-cartoes {
            grid-template-columns: 1fr;
        }

        .grafico-card-scatter {
            grid-column: 1;
        }

        .canvas-container-radar {
            height: 320px;
        }

        .canvas-container-scatter {
            height: 260px;
        }
    }
</style>
