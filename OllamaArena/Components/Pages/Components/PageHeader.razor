<div class="page-header-block">
    <div class="page-header-main">

        <div class="page-header-texts">
            <h2 class="fluent-h2 page-header-title">@Title</h2>

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="page-header-subtitle">@Subtitle</p>
            }
        </div>

        @if (Actions is not null)
        {
            <div class="page-header-actions">
                @Actions
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
<style>
    .page-header-block {
        position: relative;
        width: 100%;
        margin: 4px 0 30px 0;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--neutral-stroke-rest);
    }

    .page-header-main {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .page-header-texts {
        min-width: 0;
    }

    .page-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 0 0 auto;
        padding-top: 4px;
    }

    .page-header-title {
        margin: 0;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 800;
        letter-spacing: .01em;
        line-height: 1.15;
        color: #38BDF8;
        background-image: linear-gradient(90deg, #38BDF8, #A78BFA);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .page-header-subtitle {
        margin: 10px 0 0 0;
        max-width: 78ch;
        font-size: .95rem;
        line-height: 1.5;
        color: var(--neutral-foreground-hint);
    }

    .page-header-block::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -2px;
        width: 88px;
        height: 4px;
        border-radius: 999px;
        background-image: linear-gradient(90deg, #38BDF8, #A78BFA);
    }

    body[data-theme="light"] .page-header-title {
        color: #0284C7;
        background-image: linear-gradient(90deg, #0284C7, #7C3AED);
    }

    body[data-theme="light"] .page-header-block::after {
        background-image: linear-gradient(90deg, #0284C7, #7C3AED);
    }
</style>
