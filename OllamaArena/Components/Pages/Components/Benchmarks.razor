@page "/benchmarks"
@rendermode InteractiveServer

@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaArena.Resources
@using OllamaArena.Services.Helpers
@inject IStringLocalizer<SharedResources> L
@inject IDialogService DialogService
@inject ILogger<App> Logger
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<div class="analise-container-horizontal">

    <PageHeader Title="@L["Benchmarks.PageTitle"]" />

    <div class="pagina-header">
        <!-- Botão de Refrescar aqui -->
        <FluentButton Appearance="Appearance.Outline"
                      IconStart="@(new Icons.Regular.Size24.ArrowClockwise())"
                      OnClick="RefreshPage"
                      Title="@L["Benchmarks.ReloadPageTitle"]">
            @L["Common.Refresh"]
        </FluentButton>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <FluentProgressRing></FluentProgressRing>
            <p>@L["Benchmarks.LoadingHistory"]</p>
        </div>
    }
    else if (_promptsList == null || !_promptsList.Any())
    {
        <div class="empty-state">
            <p>@L["Benchmarks.EmptyDatabase"]</p>
        </div>
    }
    else
    {
        <FluentSplitter Orientation="@_splitterOrientation"
                        BarSize="6"
                        Panel1Size="@_panel1Size"
                        Panel1MinSize="@_panel1MinSize"
                        Panel2MinSize="@_panel2MinSize"
                        Class="benchmarks-splitter">

            <Panel1>
                <div class="painel-esquerdo-scroll">

                    @if (_mostrarGrafico && _promptGrafico != null)
                    {
                        <div class="grafico-container">
                            <h4>@L["Benchmarks.ChartPromptTitle", _promptGrafico.Id]</h4>
                            @* <canvas id="graficoModelos"></canvas> *@
                        </div>
                    }
                    else
                    {
                        <div class="lista-cards-prompts">
                            @foreach (var prompt in _promptsList)
                            {
                                <FluentCard MinimalStyle="true"
                                            Class="@($"card-prompt-item {(prompt == _selectedPrompt ? "card-selecionado" : "")}")"
                                            @onclick="@(() => SelectPrompt(prompt))">

                                    <div class="card-prompt-header">
                                        <span class="prompt-id-badge">#@prompt.Id</span>
                                        <span class="prompt-data">@prompt.DataCriacaoFormatada</span>
                                    </div>

                                    <p class="prompt-texto-curto"
                                       title="@prompt.TextoPrompt">
                                        @prompt.TextoPrompt
                                    </p>
                                    <div class="separator-line"></div>

                                    <div class="card-prompt-footer">

                                        <FluentBadge Appearance="Appearance.Neutral">
                                            @L["Benchmarks.ModelCount", prompt.Answers?.Count ?? 0]
                                        </FluentBadge>

                                        <FluentButton Appearance="Appearance.Outline"
                                                      IconStart="@(new Icons.Regular.Size24.LayoutInfographic())"
                                                      OnClick="@(() => OpenChartDialog(prompt))"
                                                      Title="@L["Benchmarks.ShowChartTitle"]"
                                                      StopPropagation="true">
                                            @L["Benchmarks.Chart"]
                                        </FluentButton>

                                        <FluentButton Appearance="Appearance.Outline"
                                                      Color="Color.Error"
                                                      IconStart="@(new Icons.Regular.Size24.Delete())"
                                                      OnClick="@( async () => await DeletePromptAsync(prompt))"
                                                      Title="@L["Benchmarks.DeletePromptTitle"]"
                                                      Style="--neutral-stroke-rest: #d32f2f; --neutral-stroke-hover: #c62828; color: #d32f2f;"
                                                      StopPropagation="true">
                                        </FluentButton>

                                    </div>
                                </FluentCard>
                            }
                        </div>
                    }
                </div>
            </Panel1>

            <Panel2>
                <div class="painel-direito-container">  
                    @if (_selectedPrompt == null)
                    {
                        <div class="placeholder-direito">
                            <FluentIcon Value="@(new Icons.Regular.Size32.DocumentSearch())" Color="Color.Neutral" />
                            <p>@L["Benchmarks.SelectPromptPlaceholder"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="detalhe-header">
                            <h3>@L["Benchmarks.ResponsesTitle", _selectedPrompt.Id]</h3>

                            <div style="display: flex; align-items: flex-start; gap: 10px; margin-top: 10px;">
                                <div class="recommendation-box prompt-collapse-box @(_promptOpen ? "open" : string.Empty)" style="flex: 1; margin: 0;">
                                    <div class="recommendation-box-header" role="button" tabindex="0"
                                         aria-expanded="@_promptOpen"
                                         @onclick="() => _promptOpen = !_promptOpen"
                                         @onkeydown="(e) => TogglePromptTecla(e, () => _promptOpen = !_promptOpen)">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.DocumentText())" Color="Color.Accent" />
                                        <span>@L["Benchmarks.ShowPromptLabel"]</span>
                                        <FluentIcon Class="recommendation-box-chevron"
                                                    Value="@(GetPromptChevron(_promptOpen))" />
                                    </div>
                                    @if (_promptOpen)
                                    {
                                        <div class="recommendation-box-text">"@_selectedPrompt.TextoPrompt"</div>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!_selectedPrompt.Answers.Any())
                        {
                            <FluentMessageBar Intent="MessageIntent.Warning" AllowClose="false">
                                @L["Benchmarks.NoAnswersWarning"]
                            </FluentMessageBar>
                        }
                        else
                        {
                            @if (_avaliacaoEmCurso is not null)
                            {
                                var progresso = _avaliacaoEmCurso;
                                <div class="barra-avaliacao" role="status" aria-live="polite">
                                    <FluentProgressRing Class="barra-avaliacao-ring" />

                                    <div class="barra-avaliacao-conteudo">
                                        <div class="barra-avaliacao-titulo">
                                            <span>@L["Benchmarks.ProgressTitle", progresso.Modelo]</span>
                                            <span class="barra-avaliacao-tempo">@L["Benchmarks.ProgressElapsed", progresso.Segundos]</span>
                                        </div>

                                        <ol class="barra-avaliacao-passos">
                                            @foreach (var passo in progresso.Passos)
                                            {
                                                <li class="passo passo-@passo.Estado.ToString().ToLowerInvariant()"
                                                    title="@passo.Detalhe">
                                                    <span class="passo-marca">@MarcadorPasso(passo.Estado)</span>
                                                    <span class="passo-rotulo">@passo.Rotulo</span>
                                                    <span class="passo-estado">
                                                        @TextoPasso(passo.Estado)@if (!string.IsNullOrWhiteSpace(passo.DetalheResumido))
                                                        {
                                                            <span class="passo-detalhe">— @passo.DetalheResumido</span>
                                                        }
                                                    </span>
                                                    @if (passo.MostrarTempo)
                                                    {
                                                        <span class="passo-tempo">@L["Benchmarks.ProgressElapsed", passo.Segundos]</span>
                                                    }
                                                </li>
                                            }
                                        </ol>
                                    </div>

                                    <FluentButton Class="barra-avaliacao-cancelar"
                                                  Appearance="Appearance.Outline"
                                                  Color="Color.Error"
                                                  Disabled="@progresso.ACancelar"
                                                  OnClick="CancelarAvaliacao"
                                                  Title="@L["Benchmarks.CancelEvaluationTitle"]">
                                        @(progresso.ACancelar ? L["Benchmarks.CancellingEvaluation"] : L["Benchmarks.CancelEvaluation"])
                                    </FluentButton>
                                </div>
                            }
                            else if (isCreatingPrompt)
                            {
                                <div class="loading-state">
                                    <FluentProgressRing></FluentProgressRing>
                                    <p>@L["Benchmarks.CreatingPrompt"]</p>
                                </div>
                            }

                            <div class="conteudo-respostas-scroll">
                                <div class="cartoes-respostas-container">
                                    @foreach (var resp in _selectedPrompt.Answers)
                                    {
                                        var avaliando = AvaliacaoDesteModelo(resp.Id);
                                        <div class="cartao-resposta @(avaliando ? "cartao-avaliando" : "")">
                                            <div class="cartao-header">
                                                <div class="modelo-info">
                                                    <FluentIcon Value="@(new Icons.Regular.Size20.Bot())" Color="Color.Neutral" />
                                                    <h4>@resp.NomeModelo</h4>
                                                </div>
                                                <div class="metricas-tags" style="display: flex; justify-content: space-around; align-items: center; gap:8px">
                                                    <FluentBadge Appearance="Appearance.Accent">@L["Benchmarks.TokensPerSecond", resp.TokensPorSegundo]</FluentBadge>
                                                    <FluentBadge Appearance="Appearance.Accent">@L["Benchmarks.EvalTime", resp.TempoPuroFormatado]</FluentBadge>
                                                    <FluentBadge Appearance="Appearance.Accent">@L["Benchmarks.LoadTime", resp.TempoCargaFormatado]</FluentBadge>
                                                    <FluentBadge Appearance="Appearance.Accent">@L["Benchmarks.Tokens", resp.TamanhoTokens]</FluentBadge>
                                                </div>
                                                <div style="display: flex; gap: 4px; align-items: center;padding:2px;">
                                                    <FluentButton Appearance="Appearance.Accent"
                                                                  Disabled="@OperacaoEmCurso"
                                                                  IconStart="@(avaliando ? null : new Icons.Regular.Size20.Sparkle())"
                                                                  OnClick="() => AvaliarAutomaticamenteAsync(resp, _selectedPrompt.TextoPrompt, resp.NomeModelo)"
                                                                  Title="@L["Benchmarks.AutomateEvaluationTitle"]"
                                                                  Color="rgba(255,255,255, 0.9)"
                                                                  BackgroundColor="rgba(25, 116, 210, 1.0)">
                                                        @if (avaliando)
                                                        {
                                                            <FluentProgressRing Class="botao-avaliando-ring" />
                                                            @L["Benchmarks.EvaluatingNow"]
                                                        }
                                                        else
                                                        {
                                                            @L["Benchmarks.AutomateEvaluation"]
                                                        }
                                                    </FluentButton>

                                                    <FluentButton Appearance="Appearance.Stealth"
                                                                  Disabled="@OperacaoEmCurso"
                                                                  IconStart="@(new Icons.Regular.Size20.ClipboardCode())"
                                                                  OnClick="() => CopiarPromptAvaliacaoAsync(resp, _selectedPrompt.TextoPrompt, resp.NomeModelo)"
                                                                  Title="@L["Benchmarks.CopyPromptTitle"]">
                                                        @L["Benchmarks.CopyForEvaluation"]
                                                    </FluentButton>
                                                </div>
                                            </div>

                                            <div class="cartao-corpo">
                                                @{ var avisoIdioma = LanguageWarningFor(resp.TextoResposta); }
                                                @if (!string.IsNullOrWhiteSpace(avisoIdioma))
                                                {
                                                    <div class="aviso-idioma" title="@avisoIdioma">⚠ @avisoIdioma</div>
                                                }
                                                <div class="recommendation-box resposta-collapse-box @(RespostaAberta(resp) ? "open" : string.Empty)">
                                                    <div class="recommendation-box-header" role="button" tabindex="0"
                                                         aria-expanded="@RespostaAberta(resp)"
                                                         @onclick="() => AlternarResposta(resp.Id)"
                                                         @onkeydown="(e) => TogglePromptTecla(e, () => AlternarResposta(resp.Id))">
                                                        <FluentIcon Value="@(new Icons.Regular.Size16.DocumentText())" Color="Color.Neutral" />
                                                        <span>@L["Benchmarks.ShowResponseLabel"]</span>
                                                        <FluentIcon Class="recommendation-box-chevron"
                                                                    Value="@GetPromptChevron(RespostaAberta(resp))" />
                                                    </div>
                                                    @if (RespostaAberta(resp))
                                                    {
                                                        <div class="texto-resposta-raw">
                                                            @((MarkupString)MessageFormatter.FormatMessagePlus(resp.TextoResposta))
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <div style="display: flex; flex-direction: column; align-items: stretch; gap: 8px;">

                                                <div class="separator-line"></div>

                                                <div class="avaliacao-footer">

                                                    <div class="rating-box @(SemRespostaColuna(true, resp) ? "judge-label-muted" : string.Empty)">
                                                        <FluentIcon Value="@(new Icons.Regular.Size16.Sparkle())" />
                                                        <span>@RotuloColuna(true, resp)</span>
                                                        <strong>@(resp.GeminiRating > 0 ? resp.GeminiRating : 0)</strong>
                                                    </div>
                                                    <div class="rating-box @(SemRespostaColuna(false, resp) ? "judge-label-muted" : string.Empty)">
                                                        <FluentIcon Value="@(new Icons.Regular.Size16.Chat())" />
                                                        <span>@RotuloColuna(false, resp)</span>
                                                        <strong>@(resp.OpenRouterRating > 0 ? resp.OpenRouterRating : 0)</strong>
                                                    </div>
                                                    <FluentSpacer />
                                                    <div>
                                                    <FluentButton Appearance="Appearance.Accent" Color="Color.Success"
                                                                      Disabled="@OperacaoEmCurso"
                                                                      IconStart="@(new Icons.Regular.Size16.Edit())"
                                                                      OnClick="@(() => OpenEvaluation(resp.Id))">
                                                            @L["Benchmarks.Evaluate"]
                                                        </FluentButton>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </Panel2>

        </FluentSplitter>
    }
</div>

<BenchmarkChartDialog Prompt="@_chartPrompt"
                      Visible="@_chartDialogVisible"
                      VisibleChanged="@((v) => _chartDialogVisible = v)" />

<BenchmarkEvaluationDialog Response="@_selectedEvaluation"
                           Visible="@_evaluationDialogVisible"
                           VisibleChanged="@((v) => _evaluationDialogVisible = v)"
                           IsAlreadySaved="@_evaluationIsSaved"
                           OnSave="SaveEvaluationAsync"
                           OnClose="CloseDialogAsync" />



<style>
    .analise-container-horizontal {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 40px);
        overflow: hidden;
    }

    .pagina-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        padding: 10px 16px;
        background-color: var(--neutral-layer-1);
        flex: 0 0 auto;
    }

    .painel-esquerdo-scroll {
        height: 100%;
        overflow-y: auto;
        padding: 16px;
        box-sizing: border-box;
        background-color: var(--neutral-layer-2);
        border-right: 1px solid var(--neutral-stroke-rest);
    }

    .painel-direito-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px;
        box-sizing: border-box;
        overflow: hidden;
    }

    .detalhe-header {
        flex: 0 0 auto;
        background-color: var(--neutral-layer-1);
        padding-bottom: 8px;
        border-bottom: 1px solid var(--neutral-stroke-divider);
        margin-bottom: 12px;
    }

    .conteudo-respostas-scroll {
        flex: 1 1 auto;
        overflow-y: auto;
        padding-right: 4px;
    }

    .lista-cards-prompts {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .card-prompt-item {
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease;
        padding: 12px;
        border: 1px solid var(--neutral-stroke-rest);
        width: 100%;
        box-sizing: border-box;
    }

        .card-prompt-item:hover {
            transform: translateY(-2px);
            box-shadow: var(--elevation-shadow-card-hover);
        }

    .card-selecionado {
        border-left: 4px solid var(--accent-fill-rest) !important;
        background-color: var(--neutral-layer-3) !important;
    }

    .card-prompt-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .prompt-id-badge {
        font-weight: bold;
        color: var(--accent-fill-rest);
    }

    .prompt-data {
        font-size: 11px;
        color: var(--neutral-foreground-hint);
    }

    .card-prompt-body {
        margin-bottom: 10px;
        min-height: 40px;
    }

    .prompt-texto-curto {
        margin: 4px 0 10px 0;
        font-size: 13px;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-prompt-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .placeholder-direito {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 70%;
        color: var(--neutral-foreground-hint);
    }

    .cartoes-respostas-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 4px;
    }

    .cartao-resposta {
        background: var(--neutral-layer-1);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 4px;
        padding: 16px;
    }

    .cartao-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--neutral-stroke-divider);
        padding-bottom: 8px;
        margin-bottom: 12px;
    }

    .modelo-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .modelo-info h4 {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
            border-radius: 9px;
            padding: 4px 10px;
            background: var(--neutral-fill-secondary);
            border: 1px solid var(--neutral-stroke-rest);
        }

    .metricas-tags {
        display: flex;
        font-size: 14px;
        gap: 6px;
    }

    .detalhe-header h3 {
        margin-top: 0;
    }

    /* Caixa de recomendação/colapsável (padrão das recomendações do diálogo de avaliação) */
    .recommendation-box {
        background-color: rgba(255, 183, 77, 0.12);
        border: 1px solid rgba(209, 158, 0, 0.45);
        border-left: 4px solid #d19e00;
        border-radius: 4px;
        padding: 10px 12px;
    }

        .recommendation-box-header {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #d19e00;
            margin-bottom: 0;
            cursor: pointer;
            user-select: none;
        }

        .recommendation-box-header:focus-visible {
            outline: 1px solid var(--accent-fill-rest, #0078d4);
            outline-offset: 2px;
        }

        .recommendation-box.open .recommendation-box-header {
            margin-bottom: 6px;
        }

        .recommendation-box-chevron {
            margin-left: auto;
            flex: 0 0 auto;
        }

        .recommendation-box-text {
            font-size: 13px;
            line-height: 1.5;
            color: var(--neutral-foreground-rest);
            white-space: pre-wrap;
        }

    .prompt-collapse-box .recommendation-box-text {
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* Variante neutra para o texto da resposta (a base âmbar é para avisos/recomendações) */
    .resposta-collapse-box {
        background-color: var(--neutral-layer-2);
        border: 1px solid var(--neutral-stroke-rest);
        border-left: 4px solid var(--accent-fill-rest);
    }

        .resposta-collapse-box .recommendation-box-header {
            color: var(--neutral-foreground-hint);
            transition: color 0.1s ease;
        }

        .resposta-collapse-box:hover .recommendation-box-header,
        .resposta-collapse-box.open .recommendation-box-header {
            color: var(--accent-fill-rest);
        }

    .cartao-corpo {
        font-size: 13.5px;
        line-height: 1.5;
    }

    .aviso-idioma {
        display: inline-block;
        margin-bottom: 6px;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85em;
        font-weight: 600;
        background-color: rgba(245, 158, 11, 0.15);
        border: 1px solid rgba(245, 158, 11, 0.6);
        color: #b45309;
    }

    body[data-theme="dark"] .aviso-idioma {
        color: #fbbf24;
    }

    .texto-resposta-raw {
        word-break: break-word;
        max-width: 850px;
    }

    .divisor-avaliacao {
        border: 0;
        border-top: 1px dashed var(--neutral-stroke-divider);
        margin: 16px 0 12px 0;
    }

    .zona-avaliacao-editavel h5 {
        margin: 0 0 12px 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--neutral-foreground-hint);
    }

    .grelha-avaliacao {
        display: flex;
        gap: 20px;
        margin-bottom: 12px;
    }

    .coluna-juiz {
        flex: 1;
        background-color: var(--neutral-layer-2);
        padding: 12px;
        border-radius: 4px;
        border: 1px solid var(--neutral-stroke-divider);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .juiz-titulo {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: bold;
    }

    .acoes-avaliacao {
        display: flex;
        justify-content: flex-end;
        margin-top: 8px;
    }

    .separator-line {
        width: 100%;
        height: 1px;
        margin: 0;
        background-color: #d1d1d1;
        margin: 10px 0 5px 0;
    }

    .avaliacao-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .rating-box {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 120px;
        padding: 4px 10px;
        border-radius: 9px;
        background: var(--neutral-fill-secondary);
        border: 1px solid var(--neutral-stroke-rest);
    }

        .rating-box strong {
            margin-left: auto;
            color: var(--accent-fill-rest);
        }

        .rating-box.judge-label-muted {
            opacity: 0.55;
            font-style: italic;
            border-style: dashed;
        }

    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        text-align: center;
    }

    /* Feedback de progresso da avaliação automática (3 fases + tempo decorrido) */
    .barra-avaliacao {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 10px 12px;
        margin-bottom: 12px;
        border: 1px solid var(--accent-stroke-rest);
        border-left-width: 3px;
        border-radius: 6px;
        background-color: var(--neutral-layer-1);
    }

    .barra-avaliacao-ring {
        flex: 0 0 auto;
        width: 18px;
        height: 18px;
    }

    .barra-avaliacao-conteudo {
        flex: 1 1 auto;
        min-width: 0;
    }

    .barra-avaliacao-titulo {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .barra-avaliacao-tempo {
        flex: 0 0 auto;
        font-variant-numeric: tabular-nums;
        font-weight: 400;
        color: var(--neutral-foreground-hint);
    }

    .barra-avaliacao-passos {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin: 6px 0 0;
        padding: 0;
        list-style: none;
        font-size: 0.75rem;
        color: var(--neutral-foreground-hint);
    }

    .barra-avaliacao-passos .passo {
        display: flex;
        align-items: baseline;
        gap: 6px;
    }

    .barra-avaliacao-passos .passo-marca {
        flex: 0 0 auto;
        width: 12px;
        text-align: center;
    }

    .barra-avaliacao-passos .passo-rotulo {
        flex: 0 0 auto;
        min-width: 130px;
        color: var(--neutral-foreground-rest);
    }

    .barra-avaliacao-passos .passo-estado {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
