@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaArena.Models.DTO
@using OllamaArena.Models.Entities
@using OllamaArena.Resources
@using OllamaArena.Services.Interfaces.Repositories
@using OllamaArena.Services.Helpers
@using System.Text.Json
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS
@inject ILogger<App> _logger
@inject IDialogService DialogService

@if (IsOpen)
{
    <div class="history-overlay" @onclick="Close"></div>
}

@* `inert` enquanto fechado: o painel está fora do ecrã (translateX) mas os seus
   botões continuavam focáveis pelo Tab e expostos aos leitores de ecrã. *@
<div class="history-aside @(IsOpen ? "open" : "")" inert="@(!IsOpen)">
    <div class="header">
        <h3>@L["HistoryPanel.Title"]</h3>
        <div class="header-actions">
            <FluentButton Appearance="Appearance.Stealth" OnClick="@Close">@L["Common.Close"]</FluentButton>
        </div>
    </div>

    <div class="tabs">
        <FluentButton Appearance="@(_showConversations ? Appearance.Accent : Appearance.Stealth)" OnClick="@(() => _showConversations = false)">@L["HistoryPanel.TabBenchmarks"]</FluentButton>
        <FluentButton Appearance="@(_showConversations ? Appearance.Stealth : Appearance.Accent)" OnClick="@(() => _showConversations = true)">@L["HistoryPanel.TabConversations"]</FluentButton>
    </div>

    @if (_showConversations)
    {
        @if (Conversations == null)
        {
            <p>@L["Common.Loading"]</p>
        }
        else
        {
            <div class="panel-actions">
                <FluentButton Appearance="Appearance.Outline" OnClick="@ExportConversationsAsync">@L["HistoryPanel.Export"]</FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="@ImportConversationsAsync">@L["HistoryPanel.Import"]</FluentButton>
                @* Destrutivo sempre no fim da linha de acções. Fica desativado
                   enquanto o chat tiver uma conversa aberta: apagar as conversas
                   deixaria o `_conversationId` do chat a apontar para uma linha
                   inexistente e o próximo turno falhava na FK de
                   `ConversaMensagens.ConversationId`. *@
               @*  <FluentButton Appearance="Appearance.Accent"
                              Style="@ClearButtonStyle"
                              Disabled="@HasOpenConversation"
                              Title="@ClearConversationsTooltip"
                              OnClick="@ClearConversationsAsync">@L["HistoryPanel.ClearHistory"]</FluentButton> *@
            </div>

            @if (Conversations.Count == 0)
            {
                <p>@L["HistoryPanel.NoConversations"]</p>
            }
            else
            {
                @foreach (var conv in Conversations)
                {
                    <div class="conv-row" @onclick="() => LoadConversation(conv.Id)">
                        <div class="conv-info">
                            <span class="conv-title">@conv.Titulo</span>
                            @if (!string.IsNullOrWhiteSpace(conv.Descricao))
                            {
                                <span class="conv-descricao">@conv.Descricao</span>
                            }
                            <span class="conv-meta">@conv.NomeModelo · @conv.DataUltimaAtividadeFormatada</span>
                        </div>
                        <FluentButton Appearance="Appearance.Stealth" Icon="@(new Icons.Regular.Size20.ArrowClockwise())" Title="@L["HistoryPanel.LoadConversation"]"></FluentButton>
                    </div>
                }
            }
        }
    }
    else if (History == null)
    {
        <p>@L["Common.Loading"]</p>
    }
    else if (History.Count() == 0)
    {
        <p>@L["HistoryPanel.NoHistory"]</p>
    }
    else
    {
        @* <div class="panel-actions">
            <FluentButton Appearance="Appearance.Accent"
                          Style="@ClearButtonStyle"
                          OnClick="@ClearBenchmarksHistoryAsync">@L["HistoryPanel.ClearHistory"]</FluentButton>
        </div> *@
        <FluentPaginator State="@pagination" SummaryTemplate="@template" />
        <FluentDivider Style="width: 100%;" Role="DividerRole.Separator"></FluentDivider>
        <div class="history-grid-wrap">
            <FluentDataGrid Items="@History.AsQueryable()"
                            Pagination="@pagination">
                <PropertyColumn Property="@(h => h.Descricao)"
                                Title="@L["HistoryPanel.ColPrompt"]"
                                Width="250px"
                                Tooltip="true" />
                <PropertyColumn Property="@(h => h.Modelo)"
                                Title="@L["HistoryPanel.ColModel"]" />
                <PropertyColumn Property="@(h => h.DateDisplay)" Align="Align.Center"
                                Title="@L["HistoryPanel.ColDate"]" />
                @* DurationDisplay/ProcessDurationDisplay são "HH:mm:ss": sem um
                   comparador próprio a grelha ordenava-os como texto ("00:59" depois
                   de "00:100"). A data é "yyyy-MM-dd HH:mm", que já ordena
                   corretamente como texto. *@
                <PropertyColumn Property="@(h => h.DurationDisplay)" Align="Align.Center"
                                Title="@L["HistoryPanel.ColEvalTime"]" Comparer="@DurationTextComparer.Instance" />
                <PropertyColumn Property="@(h => h.ProcessDurationDisplay)" Align="Align.Center"
                                Title="@L["HistoryPanel.ColProcessTime"]" Comparer="@DurationTextComparer.Instance" />
            </FluentDataGrid>
        </div>
    }
</div>

@code {

    /// <summary>Estilo do botão destrutivo, partilhado pelas duas tabs.</summary>
    private const string ClearButtonStyle =
        "background-color: var(--color-neutral-stroke-alert-rest); color: var(--color-neutral-foreground-on-alert);";

    [Inject]
    public required IBenchmarkQueryRepository BenchmarksRepo { get; set; }

    /// <summary>Só o repositório de comandos, para a eliminação do histórico de benchmarks.</summary>
    [Inject]
    public required IBenchmarkCommandRepository BenchmarksCommands { get; set; }

    [Inject]
    public required IConversationRepository ConversationsRepo { get; set; }
    private IEnumerable<HistoryResponse> History { get; set; } = [];
    private List<ChatConversation> Conversations { get; set; } = [];
    private bool _showConversations;

    [Parameter]
    public EventCallback<int> OnLoadConversation { get; set; }

    /// <summary>
    /// O chat tem uma conversa aberta. Impede apagar as conversas todas: o
    /// <c>_conversationId</c> do chat ficaria a apontar para uma linha apagada e o
    /// próximo turno falharia na chave estrangeira de <c>ConversaMensagens</c>.
    /// </summary>
    [Parameter]
    public bool HasOpenConversation { get; set; }

    /// <summary>Motivo mostrado no tooltip enquanto o botão está desativado.</summary>
    private string? ClearConversationsTooltip =>
        HasOpenConversation ? L["HistoryPanel.ClearHistoryDisabledTooltip"].Value : null;

    public bool IsOpen { get; set; }

    PaginationState pagination = new PaginationState() { ItemsPerPage = 12 };
    private RenderFragment template = @<span />;

    public async Task Open()
    {
        try
        {
            History = await BenchmarksRepo.HistoryResponseAsync() ?? [];
            Conversations = await ConversationsRepo.GetConversationsAsync() ?? [];
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "ERRO em Open() - HistoryPanel");
        }

        IsOpen = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsOpen = false;
    }

    private async Task LoadConversation(int conversationId)
    {
        if (OnLoadConversation.HasDelegate)
            await OnLoadConversation.InvokeAsync(conversationId);
        Close();
    }

    private async Task ExportConversationsAsync()
    {
        try
        {
            var itens = await ConversationsRepo.GetAllForExportAsync();
            var options = new JsonSerializerOptions { WriteIndented = true };
            string json = JsonSerializer.Serialize(itens, options);
            string nomeFicheiro = $"conversas_{DateTime.Now:yyyyMMdd_HHmmss}.json";
            await JS.InvokeVoidAsync("conversations.downloadJson", nomeFicheiro, json);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "ERRO em ExportConversationsAsync()");
        }
    }

    private async Task ImportConversationsAsync()
    {
        try
        {
            string? conteudo = await JS.InvokeAsync<string>("conversations.pickJsonFile");
            if (string.IsNullOrWhiteSpace(conteudo)) return;

            var itens = JsonSerializer.Deserialize<List<ConversationExportItem>>(conteudo);
            if (itens is null || itens.Count == 0) return;

            var (conversas, mensagens) = await ConversationsRepo.ImportAsync(itens);
            _logger.LogInformation("Importadas {Conversas} conversas e {Mensagens} mensagens", conversas, mensagens);

            Conversations = await ConversationsRepo.GetConversationsAsync() ?? [];
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "ERRO em ImportConversationsAsync()");
        }
    }

    private async Task ClearBenchmarksHistoryAsync()
    {
        var dialog = await DialogService.ShowConfirmationAsync(
            L["HistoryPanel.ConfirmClearHistory"],
            primaryText: L["HistoryPanel.ClearHistory"],
            secondaryText: L["Common.Cancel"],
            title: L["HistoryPanel.ClearHistory"]);

        if (dialog != null)
        {
            await BenchmarksCommands.DeleteAllPromptsAsync();
            History = [];
            StateHasChanged();
        }
    }

    private async Task ClearConversationsAsync()
    {
        // O botão já vem desativado; a guarda cobre o caso de o chat ter ganho uma
        // conversa enquanto o painel estava aberto.
        if (HasOpenConversation) return;

        var dialog = await DialogService.ShowConfirmationAsync(
            L["HistoryPanel.ConfirmClearConversations"],
            primaryText: L["HistoryPanel.ClearHistory"],
            secondaryText: L["Common.Cancel"],
            title: L["HistoryPanel.ClearHistory"]);

        if (dialog != null)
        {
            await ConversationsRepo.ClearAllConversationsAsync();
            Conversations = [];
            StateHasChanged();
        }
    }
}

<style>
    .history-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.35);
        z-index: var(--z-panel-overlay);
        animation: fadeIn 0.25s ease;
    }

    .history-aside {
        position: fixed;
        top: 0;
        right: 0;
        width: min(92vw, 860px);
        height: 100dvh;
        background: var(--neutral-layer-1);
        color: var(--neutral-foreground-rest);
        box-shadow: -4px 0 12px rgba(0,0,0,0.2);
        padding: 16px;
        overflow-y: auto;
        overflow-x: hidden;
        z-index: var(--z-panel);
        transform: translateX(100%);
        transition: transform 0.35s ease;
    }

        .history-aside.open {
            transform: translateX(0);
        }

        .history-aside fluent-data-grid {
            min-width: 520px;
        }

        /* A grelha tem min-width própria e o painel esconde o overflow-x: sem este
           contentor as colunas da direita ficavam cortadas e inacessíveis. */
        .history-aside .history-grid-wrap {
            overflow-x: auto;
        }

        .history-aside .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .history-aside .header-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .history-aside .tabs {
            display: flex;
            gap: 8px;
            margin: 12px 0;
        }

        /* Linha de acções de cada tab (Conversas: exportar/importar/apagar).
           O botão destrutivo é o último; `wrap` evita transbordo em ecrãs estreitos. */
        .history-aside .panel-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 12px;
        }

        .history-aside .conv-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 8px;
            border-bottom: 1px solid var(--neutral-stroke-divider-rest);
            cursor: pointer;
        }

            .history-aside .conv-row:hover {
                background: var(--neutral-fill-secondary-hover);
            }

        .history-aside .conv-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .history-aside .conv-title {
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .history-aside .conv-descricao {
            font-size: 12px;
            color: var(--neutral-foreground-hint);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-style: italic;
        }

        .history-aside .conv-meta {
            font-size: 12px;
            color: var(--neutral-foreground-hint);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>