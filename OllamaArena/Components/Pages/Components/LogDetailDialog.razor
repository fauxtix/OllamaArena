@using System.Text.Json
@using Microsoft.Extensions.Localization
@using OllamaArena.Models.Entities
@using OllamaArena.Resources
@inject IStringLocalizer<SharedResources> L

<FluentDialog Hidden="@(!Visible)"
              Modal="true"
              TrapFocus="true" Class="dialog-size"
              AriaLabel="@L["LogDetail.AriaLabel"]">

    <FluentDialogHeader Visible="true">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.DocumentText())" />
            <FluentLabel Typo="Typography.PaneHeader">@L["LogDetail.Title", Log?.Id ?? 0]</FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        @if (Log != null)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                <div>
                    <FluentLabel Weight="FontWeight.Bold">@L["LogDetail.Message"]</FluentLabel>
                    <p style="background: var(--neutral-layer-2); padding: 12px; border-radius: 4px; white-space: pre-wrap; word-break: break-word; margin: 6px 0 0 0; font-size: 14px; line-height: 1.4;">
                        @Log.RenderedMessage
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(Log.Exception))
                {
                    <div>
                        <FluentLabel Weight="FontWeight.Bold" Color="Color.Error">@L["LogDetail.Exception"]</FluentLabel>
                        <pre style="background: var(--log-danger-bg); color: var(--log-danger-text); padding: 12px; border-radius: 4px; max-height: 250px; overflow-y: auto; font-family: monospace; font-size: 11px; margin: 6px 0 0 0; white-space: pre-wrap; word-break: break-all;">@Log.Exception</pre>
                    </div>
                }
            </FluentStack>
        }
    </FluentDialogBody>

    <FluentDialogFooter>
        <FluentSpacer />
        <FluentButton Appearance="Appearance.Accent" OnClick="Fechar">@L["Common.Close"]</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter, EditorRequired] public LogEntity? Log { get; set; }
    [Parameter, EditorRequired] public bool Visible { get; set; } = false;
    [Parameter, EditorRequired] public EventCallback<bool> VisibleChanged { get; set; }

    private async Task OnVisibleChanged(bool value)
    {
        Visible = value;
        await VisibleChanged.InvokeAsync(value);
    }

    private async Task Fechar()
    {
        await OnVisibleChanged(false);
    }

    private string FormatarJson(string jsonBruto)
    {
        try
        {
            using var jsonDoc = JsonDocument.Parse(jsonBruto);
            return JsonSerializer.Serialize(jsonDoc, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return jsonBruto;
        }
    }
}
<style>
    fluent-dialog.dialog-size::part(control) {
        --dialog-width: 40vw !important;
        --dialog-height: 65vh !important;
        max-width: 100% !important;
    }

    body[data-theme="light"] {
        --log-danger-bg: #ffdcdc;
        --log-danger-text: #b00020;
    }

    body[data-theme="dark"] {
        --log-danger-bg: #541d1d;
        --log-danger-text: #ff9b9b;
    }

    @@media (max-width: 768px) {
        fluent-dialog.dialog-size::part(control) {
            --dialog-width: 94vw !important;
        }
    }
</style>