@using Microsoft.Extensions.Localization
@using OllamaArena.Resources
@inject IStringLocalizer<SharedResources> L

<FluentDialog Hidden="@(!Visible)"
              Modal="true"
              Width="600px"
              Class="model-columns-info-dialog">

    <FluentDialogHeader Visible="true">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" Gap="10">
            <FluentIcon Value="@(new Icons.Regular.Size24.QuestionCircle())" Color="Color.Warning" />
            <FluentLabel Size="IconSize.Large"><b>@L["Modelos.HelpDialogTitle"]</b></FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        <div class="help-sections">

            <div>
                <h4>@L["Modelos.HelpNameTitle"]</h4>
                <p>@L["Modelos.HelpNameBody"]</p>
            </div>

            <div>
                <h4>@L["Modelos.HelpFamilyTitle"]</h4>
                <p>@L["Modelos.HelpFamilyBody"]</p>
            </div>

            <div>
                <h4>@L["Modelos.HelpParamsTitle"]</h4>
                <p>@L["Modelos.HelpParamsBody"]</p>
            </div>

            <div>
                <h4>@L["Modelos.HelpQuantTitle"]</h4>
                <p>@L["Modelos.HelpQuantBody"]</p>
            </div>

            <div>
                <h4>@L["Modelos.HelpYearTitle"]</h4>
                <p>@L["Modelos.HelpYearBody"]</p>
            </div>

            <div>
                <h4>@L["Modelos.HelpContextTitle"]</h4>
                <p>@L["Modelos.HelpContextBody"]</p>
                <ul>
                    <li>@L["Modelos.HelpContextItem1"]</li>
                    <li>@L["Modelos.HelpContextItem2"]</li>
                    <li>@L["Modelos.HelpContextItem3"]</li>
                </ul>
            </div>

            <div>
                <h4>@L["Modelos.HelpSizeTitle"]</h4>
                <p>@L["Modelos.HelpSizeBody"]</p>
            </div>

            <div>
                <h4>@L["Modelos.HelpReasoningTitle"]</h4>
                <p>@L["Modelos.HelpReasoningBody"]</p>
                <ul>
                    <li>@L["Modelos.HelpReasoningItem1"]</li>
                    <li>@L["Modelos.HelpReasoningItem2"]</li>
                    <li>@L["Modelos.HelpReasoningItem3"]</li>
                </ul>
            </div>

            <div>
                <h4>@L["Modelos.HelpGpuTitle"]</h4>
                <p>@L["Modelos.HelpGpuBody"]</p>
                <ul>
                    <li>@L["Modelos.HelpGpuItem1"]</li>
                    <li>@L["Modelos.HelpGpuItem2"]</li>
                    <li>@L["Modelos.HelpGpuItem3"]</li>
                </ul>
                <p class="help-note">@L["Modelos.HelpGpuNote"]</p>
            </div>

        </div>
    </FluentDialogBody>

    <FluentDialogFooter>
        <div class="dialog-footer-right">
            <FluentButton Appearance="Appearance.Stealth"
                          OnClick="Close"
                          class="btn-fechar">
                @L["Common.Close"]
            </FluentButton>
        </div>
    </FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter, EditorRequired]
    public bool Visible { get; set; } = false;

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    public async Task Close()
    {
        await VisibleChanged.InvokeAsync(false);
    }
}
<style>
    .model-columns-info-dialog .help-sections {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        line-height: 1.5;
    }

    .model-columns-info-dialog .help-sections h4 {
        margin: 0 0 4px 0;
        color: var(--neutral-foreground-rest);
    }

    .model-columns-info-dialog .help-sections p {
        margin: 0;
    }

    .model-columns-info-dialog .help-sections p.help-note {
        margin-top: 6px;
        font-size: 0.875rem;
        color: var(--neutral-foreground-hint);
    }

    .model-columns-info-dialog .help-sections ul {
        margin: 6px 0 0 0;
        padding-left: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .dialog-footer-right {
        width: 100%;
        display: flex;
        justify-content: flex-end;
        padding: 8px 0;
    }

    .btn-fechar {
        border-radius: 6px;
        border: 1px solid var(--neutral-stroke-rest);
        padding: 8px 20px;
        min-width: 90px;
    }

    .btn-fechar:hover {
        background-color: var(--neutral-layer-3);
        border-color: var(--neutral-stroke-strong);
    }

    fluent-dialog.model-columns-info-dialog::part(control) {
        max-width: 95vw !important;
        width: min(600px, 95vw) !important;
        max-height: calc(100vh - 48px);
    }

    fluent-dialog.model-columns-info-dialog .fluent-dialog-body {
        min-height: 0;
        overflow-y: auto;
        scrollbar-gutter: stable;
    }
</style>
