@using Microsoft.Extensions.Localization
@using OllamaArena.Models.Entities
@using OllamaArena.Resources
@using System.Linq
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS

<FluentDialog Hidden="@(!Visible)"
              Modal="true"
              Class="dialog-largo"
              TrapFocus="true"
              AriaLabel="@L["ChartDialog.AriaLabel"]">

    <FluentDialogHeader Visible="true">
        <FluentStack Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.DataHistogram())" />
            <FluentLabel Typo="Typography.PaneHeader">
                @L["ChartDialog.Title", Prompt?.Id ?? 0]
            </FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody Style="max-height: 70vh; overflow-y: auto; padding-right: 12px;">

        @if (Prompt != null)
        {
            <FluentTabs ActiveTabId=@_tabAtiva ActiveTabIdChanged="OnTabChanged">

                <FluentTab Id="tab-desempenho">
                    <Header>
                        <FluentIcon Value="@(new Icons.Regular.Size16.DataHistogram())" Style="margin-right: 6px;" />
                        <span>@L["ChartDialog.TabPerformance"]</span>
                    </Header>
                    <Content>
                        <div class="benchmark-lista-cards">

                            <div class="grafico-card">
                                <div class="grafico-header">
                                    <span class="grafico-titulo">@L["ChartDialog.EvalChartTitle"]</span>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                                  OnClick="@(() => DownloadImageAsync("graficoEval", $"benchmark_eval_prompt_{Prompt.Id}"))" />
                                </div>
                                <div class="canvas-container">
                                    <canvas id="graficoEval"></canvas>
                                </div>
                            </div>

                            <div class="grafico-card">
                                <div class="grafico-header">
                                    <span class="grafico-titulo">@L["ChartDialog.LoadChartTitle"]</span>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                                  OnClick="@(() => DownloadImageAsync("graficoLoad", $"benchmark_load_prompt_{Prompt.Id}"))" />
                                </div>
                                <div class="canvas-container">
                                    <canvas id="graficoLoad"></canvas>
                                </div>
                            </div>

                            <div class="grafico-card">
                                <div class="grafico-header">
                                    <span class="grafico-titulo">@L["ChartDialog.SpeedChartTitle"]</span>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                                  OnClick="@(() => DownloadImageAsync("graficoVelocidade", $"benchmark_tokens_seg_prompt_{Prompt.Id}"))" />
                                </div>
                                <div class="canvas-container">
                                    <canvas id="graficoVelocidade"></canvas>
                                </div>
                            </div>

                            <div class="grafico-card">
                                <div class="grafico-header">
                                    <span class="grafico-titulo">@L["ChartDialog.TotalTokensTitle"]</span>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                                  OnClick="@(() => DownloadImageAsync("graficoTotalTokens", $"benchmark_total_tokens_prompt_{Prompt.Id}"))" />
                                </div>
                                <div class="canvas-container">
                                    <canvas id="graficoTotalTokens"></canvas>
                                </div>
                            </div>

                        </div>
                    </Content>
                </FluentTab>

                <FluentTab Id="tab-qualidade">
                    <Header>
                        <FluentIcon Value="@(new Icons.Regular.Size16.Sparkle())" Style="margin-right: 6px;" />
                        <span>@L["ChartDialog.TabQuality"]</span>
                    </Header>
                    <Content>
                        <div class="benchmark-lista-cards">

                            <div class="grafico-card">
                                <div class="grafico-header">
                                    <span class="grafico-titulo">@L["ChartDialog.RadarGeminiTitle"]</span>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                                  OnClick="@(() => DownloadImageAsync("graficoRadarGemini", $"benchmark_radar_gemini_prompt_{Prompt.Id}"))" />
                                </div>
                                @if (!_radarGeminiVazio)
                                {
                                    <div class="canvas-container-radar">
                                        <canvas id="graficoRadarGemini"></canvas>
                                    </div>
                                }
                                else
                                {
                                    <p class="radar-sem-dados">@L["ChartDialog.RadarNoData"]</p>
                                }
                            </div>

                            <div class="grafico-card">
                                <div class="grafico-header">
                                    <span class="grafico-titulo">@L["ChartDialog.RadarOpenRouterTitle"]</span>
                                    <FluentButton Appearance="Appearance.Stealth"
                                                  IconEnd="@(new Icons.Regular.Size16.ArrowDownload())"
                                                  OnClick="@(() => DownloadImageAsync("graficoRadarOpenRouter", $"benchmark_radar_openrouter_prompt_{Prompt.Id}"))" />
                                </div>
                                @if (!_radarOpenRouterVazio)
                                {
                                    <div class="canvas-container-radar">
                                        <canvas id="graficoRadarOpenRouter"></canvas>
                                    </div>
                                }
                                else
                                {
                                    <p class="radar-sem-dados">@L["ChartDialog.RadarNoData"]</p>
                                }
                            </div>

                        </div>
                    </Content>
                </FluentTab>

            </FluentTabs>
        }
        else
        {
            <p>@L["ChartDialog.NoPrompt"]</p>
        }

    </FluentDialogBody>

    <FluentDialogFooter>
        <FluentSpacer />
        <FluentButton Appearance="Appearance.Outline" OnClick="Fechar">
            @L["Common.Close"]
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter, EditorRequired] public BenchmarkPrompt? Prompt { get; set; }
    [Parameter, EditorRequired] public bool Visible { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> VisibleChanged { get; set; }

    private Dictionary<string, string> _coresDosModelos = new();
    private bool _graficoJaRenderizado = false;
    private bool _renderizarRadarPendente = false;
    private string _tabAtiva = "tab-desempenho";
    private bool _radarGeminiVazio = false;
    private bool _radarOpenRouterVazio = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // O conteúdo do tab "Qualidade" só está montado no DOM depois da re-renderização
        // que se segue ao OnTabChanged — por isso o render do radar é feito aqui.
        if (_renderizarRadarPendente && Visible && Prompt != null)
        {
            _renderizarRadarPendente = false;
            await Task.Delay(200); // Aguarda a animação do tab para evitar falhas de tamanho no Canvas
            await RenderizarRadarAsync();
        }

        if (Visible && Prompt != null && !_graficoJaRenderizado)
        {
            _graficoJaRenderizado = true;
            await Task.Delay(200); // Aguarda a animação de abertura do diálogo para evitar falhas de tamanho no Canvas
            await RenderizarGraficosAsync();
        }
        else if (!Visible)
        {
            _graficoJaRenderizado = false;
            _renderizarRadarPendente = false;
        }
    }

    private void OnTabChanged(string tabId)
    {
        _tabAtiva = tabId;

        if (tabId == "tab-qualidade")
        {
            _renderizarRadarPendente = true;
        }
    }

    private async Task RenderizarGraficosAsync()
    {
        if (Prompt?.Answers == null || !Prompt.Answers.Any())
            return;

        _coresDosModelos.Clear();

        foreach (var NomeModelo in Prompt.Answers.Select(a => a.NomeModelo).Distinct())
        {
            _coresDosModelos[NomeModelo] = GerarCorAleatoria();
        }

        var labelsModelos = Prompt.Answers.Select(a => a.NomeModelo).ToList();

        var dadosEval = GerarDatasetUnico(labelsModelos, a => a.TempoPuroMs);
        var dadosLoad = GerarDatasetUnico(labelsModelos, a => a.TempoCargaMs);
        var dadosVelocidade = GerarDatasetUnico(labelsModelos, a => a.TokensPorSegundo);
        var dadosTotalTokens = GerarDatasetUnico(labelsModelos, a => a.TamanhoTokens);

        await JS.InvokeVoidAsync("benchmarkCharts.renderGrafico", "graficoEval", dadosEval, "ms");
        await JS.InvokeVoidAsync("benchmarkCharts.renderGrafico", "graficoLoad", dadosLoad, "ms");
        await JS.InvokeVoidAsync("benchmarkCharts.renderGrafico", "graficoVelocidade", dadosVelocidade, "tokens/s");
        await JS.InvokeVoidAsync("benchmarkCharts.renderGrafico", "graficoTotalTokens", dadosTotalTokens, "tokens");
    }

    private async Task RenderizarRadarAsync()
    {
        if (Prompt?.Answers == null || !Prompt.Answers.Any())
            return;

        var dadosRadarGemini = GerarDadosRadar(openRouter: false, out _radarGeminiVazio);
        var dadosRadarOpenRouter = GerarDadosRadar(openRouter: true, out _radarOpenRouterVazio);

        if (!_radarGeminiVazio)
        {
            await RenderizarRadarComRetryAsync("graficoRadarGemini", dadosRadarGemini);
        }

        if (!_radarOpenRouterVazio)
        {
            await RenderizarRadarComRetryAsync("graficoRadarOpenRouter", dadosRadarOpenRouter);
        }

        StateHasChanged();
    }

    private async Task RenderizarRadarComRetryAsync(string canvasId, object dados)
    {
        // Garante o render mesmo que o canvas ainda esteja a ser montado pelo FluentTabs
        for (int tentativa = 0; tentativa < 8; tentativa++)
        {
            var renderizado = await JS.InvokeAsync<bool>("benchmarkCharts.renderGrafico", canvasId, dados, "pts", "radar");
            if (renderizado)
                return;
            await Task.Delay(100);
        }
    }

    private object GerarDadosRadar(bool openRouter, out bool vazio)
    {
        var metricas = new (string Nome, Func<BenchmarkResponse, float?> Valor)[]
        {
            (L["Evaluation.MetricFactual"], a => openRouter ? a.OpenRouterFactualRating : a.GeminiFactualRating),
            (L["Evaluation.MetricFormatting"], a => openRouter ? a.OpenRouterFormattingRating : a.GeminiFormattingRating),
            (L["Evaluation.MetricCompliance"], a => openRouter ? a.OpenRouterComplianceRating : a.GeminiComplianceRating),
            (L["Evaluation.MetricRelevance"], a => openRouter ? a.OpenRouterRelevanceRating : a.GeminiRelevanceRating),
            (L["Evaluation.MetricTone"], a => openRouter ? a.OpenRouterToneRating : a.GeminiToneRating),
            (L["Evaluation.MetricConciseness"], a => openRouter ? a.OpenRouterConcisenessRating : a.GeminiConcisenessRating),
            (L["Evaluation.MetricClarity"], a => openRouter ? a.OpenRouterClarityRating : a.GeminiClarityRating),
            (L["Evaluation.MetricReadability"], a => openRouter ? a.OpenRouterReadabilityRating : a.GeminiReadabilityRating),
            (L["Evaluation.MetricHaloEffect"], a => openRouter ? a.OpenRouterHaloEffectRating : a.GeminiHaloEffectRating),
            (L["Evaluation.MetricSafety"], a => openRouter ? a.OpenRouterSafetyRating : a.GeminiSafetyRating),
            (L["Evaluation.MetricLanguageConsistency"], a => openRouter ? a.OpenRouterLanguageConsistencyRating : a.GeminiLanguageConsistencyRating),
            (L["Evaluation.MetricLoopDetection"], a => openRouter ? a.OpenRouterLoopDetectionRating : a.GeminiLoopDetectionRating)
        };

        Func<BenchmarkResponse, float?> seletorGlobal =
            a => openRouter ? a.OpenRouterRating : a.GeminiRating;

        var gruposModelos = Prompt!.Answers
            .Where(a => seletorGlobal(a).HasValue)
            .GroupBy(a => a.NomeModelo)
            .OrderBy(g => g.Key)
            .ToList();

        vazio = gruposModelos.Count == 0;

        var datasets = gruposModelos.Select(grupo =>
        {
            var cor = _coresDosModelos.ContainsKey(grupo.Key) ? _coresDosModelos[grupo.Key] : GerarCorAleatoria();
            var valores = metricas.Select(m => MediarRatings(grupo, m.Valor)).ToArray();

            return new
            {
                label = grupo.Key,
                data = valores,
                borderColor = cor,
                backgroundColor = CorPreenchimento(cor),
                borderWidth = 2,
                pointBackgroundColor = cor,
                pointRadius = 3,
                fill = true
            };
        }).ToList();

        return new
        {
            labels = metricas.Select(m => m.Nome).ToArray(),
            datasets = datasets
        };
    }

    private static double MediarRatings(IEnumerable<BenchmarkResponse> respostas, Func<BenchmarkResponse, float?> seletor)
    {
        var valores = respostas.Where(r => seletor(r).HasValue).Select(r => (double)seletor(r)!.Value).ToList();
        return valores.Count > 0 ? valores.Average() : 0;
    }

    private static string CorPreenchimento(string cor)
    {
        return cor.Replace("0.85)", "0.18)");
    }

    private object GerarDatasetUnico(List<string> labelsModelos, Func<BenchmarkResponse, double> seletorValor)
    {
        var cores = labelsModelos.Select(nome => _coresDosModelos[nome]).ToList();
        var valores = Prompt!.Answers.Select(seletorValor).ToList();

        var labelsPartidas = labelsModelos.Select(nome =>
        {
            if (nome.Contains(':'))
            {
                var partes = nome.Split(':');
                return new[] { partes[0], ":" + partes[1] };
            }
            if (nome.Contains('-') && nome.Length > 10)
            {
                var partes = nome.Split('-');
                return new[] { partes[0], "-" + string.Join("-", partes.Skip(1)) };
            }
            return new[] { nome };
        }).ToList();

        return new
        {
            labels = labelsPartidas,
            datasets = new[]
            {
                new {
                    backgroundColor = cores,
                    borderColor = cores,
                    borderWidth = 1,
                    data = valores
                }
            }
        };
    }

    private async Task DownloadImageAsync(string canvasId, string nomeFicheiro)
    {
        await JS.InvokeVoidAsync("benchmarkCharts.downloadGrafico", canvasId, nomeFicheiro);
    }

    private string GerarCorAleatoria()
    {
        var rnd = new Random();
        return $"rgba({rnd.Next(50, 210)}, {rnd.Next(50, 210)}, {rnd.Next(50, 210)}, 0.85)";
    }

    private async Task Fechar()
    {
        await VisibleChanged.InvokeAsync(false);
    }
}

<style>
    fluent-dialog.dialog-largo::part(control) {
        --dialog-width: 50vw !important;
        --dialog-height: 85vh !important;
        max-width: 100% !important;
    }

    .benchmark-lista-cards {
        display: block;
        width: 100%;
    }

    .grafico-card {
        background: var(--neutral-layer-1);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 8px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .grafico-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .grafico-titulo {
        font-weight: 600;
        font-size: 14px;
        color: var(--neutral-foreground-rest);
    }

    .canvas-container {
        position: relative;
        width: 100%;
        height: 320px;
    }

    .canvas-container-radar {
        position: relative;
        width: 100%;
        max-width: 480px;
        height: 440px;
        margin: 0 auto;
    }

    .radar-sem-dados {
        color: var(--neutral-foreground-hint);
        font-size: 13px;
        font-style: italic;
        margin: 24px 0;
    }

    @@media (max-width: 768px) {
        fluent-dialog.dialog-largo::part(control) {
            --dialog-width: 94vw !important;
        }

        .canvas-container {
            height: 240px;
        }

        .canvas-container-radar {
            height: 340px;
        }
    }
</style>