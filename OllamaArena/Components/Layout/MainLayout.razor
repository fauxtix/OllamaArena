@using OllamaArena.Components.Pages.Components
@using OllamaArena.Services.Helpers
@using OllamaArena.Resources
@inject IStringLocalizer<SharedResources> L
@inject IDialogService DialogService
@inject InternetConnectivityService Internet
@inject NavigationManager Navigation

@inherits LayoutComponentBase

<CascadingValue Value="this">
    <FluentLayout Style="background-color: var(--neutral-fill-layer-rest);">

        <FluentHeader Style="background-color: var(--neutral-layer-2); color: var(--neutral-foreground-rest);">
            <div class="header-content">
                <div class="header-left">
                    <input type="checkbox" id="navmenu-toggle" class="navmenu-toggle" aria-label="@L["Nav.ExpandToggle"]" />
                    <label for="navmenu-toggle" class="navmenu-icon" title="@L["Nav.ExpandToggle"]">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Neutral" />
                    </label>
                    <div class="app-title">🤖 @L["AppTitle"]</div>
                </div>

                <div class="header-actions">
                    <FluentButton Appearance="Appearance.Stealth"
                                  OnClick="ShowReadme"
                                  Title="@L["ReadmeViewer"]"
                                  aria-label="@L["ReadmeViewer"]"
                                  Style="min-width: 32px; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <FluentIcon Value="@(new Icons.Regular.Size16.DocumentBulletList())" />
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth"
                                  OnClick="@(() => Navigation.NavigateTo("/plano-de-testes"))"
                                  Title="@L["TestPlan"]"
                                  aria-label="@L["TestPlan"]"
                                  Style="min-width: 32px; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
                        <FluentIcon Value="@(new Icons.Regular.Size16.CheckmarkCircle())" />
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Stealth"
                                  OnClick="ToggleTheme"
                                  Title="@(Mode == DesignThemeModes.Light ? L["Theme.ToDark"] : L["Theme.ToLight"])"
                                  Style="font-size: 1.1rem; padding: 4px 8px;">
                        @(Mode == DesignThemeModes.Light ? "🌙" : "☀️")
                    </FluentButton>
                    <CultureSelector />
                </div>
            </div>
        </FluentHeader>

        <label for="navmenu-toggle" class="nav-overlay" aria-hidden="true"></label>

        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
            <NavMenu />

            <FluentBodyContent Class="body-content">
                <div class="content">
                    @Body
                </div>
            </FluentBodyContent>
        </FluentStack>

        <FluentFooter Style="background-color: var(--neutral-layer-2); color: var(--neutral-foreground-rest);">
            <div class="footer-content">
                <a href="https://github.com/fauxtix/OllamaArena" target="_blank"
                   rel="noopener noreferrer" class="footer-link">@L["Repository"]</a>
                <a href="https://docs.ollama.com/" target="_blank"
                   rel="noopener noreferrer" class="footer-link">@L["OllamaDocumentation"]</a>
            </div>
        </FluentFooter>
    </FluentLayout>
</CascadingValue>

<FluentToastProvider />
<FluentDialogProvider />
<FluentDesignTheme @bind-Mode="@Mode"
                   OnLoaded="@OnLoaded"
                   OnLuminanceChanged="@OnLuminanceChanged"
                   StorageName="theme" />
<FluentTooltipProvider />
<FluentMenuProvider />
<ReadmePreview @ref="preview" />

<style>
    /* --- TEMA CLARO: canvas ardósia + superfícies brancas ---
       O FluentDesignTheme define document.body.dataset.theme ("light"/"dark").
       Fazemos override dos design-tokens, que todos os componentes FluentUI usam,
       para que o modo claro não fique "preto e branco" puro. */
    body[data-theme="light"] {
        --neutral-fill-layer-rest: #F8FAFC;   /* canvas geral */
        --neutral-layer-1: #FFFFFF;           /* cards, tabelas, bubbles */
        --neutral-layer-2: #F1F5F9;           /* header/footer */
        --neutral-layer-3: #E2E8F0;
        --neutral-layer-4: #E2E8F0;
        --neutral-foreground-rest: #0F172A;   /* texto */
        --neutral-foreground-hint: #475569;
        --neutral-stroke-layer-rest: #E2E8F0; /* bordas */
        --neutral-stroke-rest: #CBD5E1;
    }

    /* --- ESTILOS COMPLEMENTARES --- */
    .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 12px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .app-title {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 0 0 auto;
    }

    .footer-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 32px;
        width: 100%;
    }

    .footer-link {
        color: var(--neutral-foreground-hint);
        text-decoration: none;
        font-size: .85rem;
        font-weight: 600;
        padding: 4px 14px;
        border-radius: 999px;
        border: 1px solid transparent;
        transition: color .2s ease, background-color .2s ease, border-color .2s ease;
    }

    .footer-link:hover,
    .footer-link:focus-visible {
        color: var(--accent-fill-rest);
        background-color: var(--neutral-layer-3);
        border-color: var(--neutral-stroke-layer-rest);
        text-decoration: none;
    }

</style>

@code {
    public DesignThemeModes Mode { get; set; }
    private ReadmePreview? preview;

    void OnLoaded(LoadedEventArgs e) => Mode = e.Mode;
    void OnLuminanceChanged(LuminanceChangedEventArgs e) => Mode = e.Mode;

    void ToggleTheme() =>
        Mode = Mode == DesignThemeModes.Light ? DesignThemeModes.Dark : DesignThemeModes.Light;

    private async Task ShowReadme()
    {
        var hasInternet = await Internet.HasInternetAsync();
        if (!hasInternet)
        {
            await DialogService.ShowErrorAsync(L["Home.NoInternetError"], L["Home.ReadmeTitle"]);
            return;
        }

        if (preview is not null)
        {
            await preview.OpenAsync();
        }
    }
}
