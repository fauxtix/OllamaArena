@using OllamaFluentUIChat.Components.Pages
@inherits LayoutComponentBase


<CascadingValue Value="this">
    <FluentLayout Style="background-color: var(--neutral-layer-1);
        color: var(--neutral-foreground-rest);">

        <FluentHeader Style="background-color: var(--neutral-layer-2); color: var(--neutral-foreground-rest);">
            Usando Ollama localmente
        </FluentHeader>

        <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
            <NavMenu />

            <FluentBodyContent Class="body-content">
                <div class="content">
                    @Body
                </div>
            </FluentBodyContent>
        </FluentStack>

        <FluentFooter Style="background-color: var(--neutral-layer-2); color: var(--neutral-foreground-rest);">
            <div>
                <a href="https://github.com/fauxtix/OllamaFluentUIChat" target="_blank">Repositório</a>
                <a href="https://docs.ollama.com/" target="_blank">Documentação do Ollama</a>
            </div>
        </FluentFooter>
    </FluentLayout>

</CascadingValue>

<FluentToastProvider />
<FluentDialogProvider />
<FluentDesignTheme StorageName="theme" />
<FluentTooltipProvider />
<FluentMenuProvider />


