@page "/settings2"
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using System.Text.Json
@inject IJSRuntime JS
@rendermode InteractiveServer

<FluentDesignTheme @bind-Mode="@Mode"
                   @bind-OfficeColor="@OfficeColor"
                   OnLoaded="@OnLoaded"
                   OnLuminanceChanged="@OnLuminanceChanged"
                   StorageName="theme" />

<div style="padding: 10px; max-width: 700px;">

    <FluentGrid>

        <div hidden="true">
            <FluentGridItem xs="12" Style="margin-top: 8px;">
                <FluentLabel Style="font-size: 18px; font-weight: bold;">
                    Configuração do Juiz de IA (Prompt System)
                </FluentLabel>
                <p style="font-size: 13px; opacity: 0.8; margin-top: 4px; margin-bottom: 12px;">
                    Personalize as instruções que envia para o Gemini/ChatGPT quando vai avaliar as respostas dos modelos locais.
                </p>

                <FluentTextArea @bind-Value="JuizPrompt"
                                Rows="10"
                                Style="width: 100%; max-width: 600px; margin-top:8px; resize: vertical;" />

                <FluentStack Orientation="Orientation.Horizontal" Gap="10" Style="margin-top: 12px;">
                    <FluentButton Appearance="Appearance.Accent"
                                  IconStart="@(new Icons.Regular.Size16.Save())"
                                  OnClick="SaveJuizPrompt">
                        Gravar Instruções
                    </FluentButton>

                    <FluentButton Appearance="Appearance.Lightweight"
                                  IconStart="@(new Icons.Regular.Size16.Copy())"
                                  OnClick="CopiarPromptParaClipboard">
                        Copiar para o Clipboard
                    </FluentButton>

                    <FluentButton Appearance="Appearance.Neutral"
                                  OnClick="ResetJuizPrompt">
                        Restaurar Padrão
                    </FluentButton>
                </FluentStack>
            </FluentGridItem>
        </div>
        <!-- Gestão de Modelos -->
        <FluentGridItem xs="12" Style="margin-top: 30px;">
            <FluentLabel Style="font-size: 18px; font-weight: bold;">
                Gestão de Modelos Ollama
            </FluentLabel>

            <FluentStack Orientation="Orientation.Horizontal" Gap="10" Style="margin-top: 12px;">
                <FluentTextField Placeholder="Nome do modelo (ex: phi4:latest)" Style="width: 300px;"
                                 @bind-Value="NewModel" />

                <FluentButton Appearance="Appearance.Accent" OnClick="AddModel">
                    Adicionar
                </FluentButton>
            </FluentStack>

            <FluentStack Orientation="Orientation.Vertical" Gap="8" Style="margin-top: 20px;">
                @if (Models.Count == 0)
                {
                    <FluentLabel Style="opacity: 0.6;">Nenhum modelo adicionado.</FluentLabel>
                }
                else
                {
                    @foreach (var model in Models)
                    {
                        <FluentCard Style="width:400px;padding: 10px; display: flex; justify-content: space-between; align-items: center;">
                            <FluentLabel>@model</FluentLabel>

                            <FluentButton Appearance="Appearance.Neutral"
                                          OnClick="@(() => RemoveModel(model))">
                                Remover
                            </FluentButton>
                        </FluentCard>
                    }
                }
            </FluentStack>
        </FluentGridItem>

    </FluentGrid>
</div>

@code {
    public DesignThemeModes Mode { get; set; }
    public OfficeColor? OfficeColor { get; set; }

    private List<string> Models = new();
    private string NewModel = "";

    private string JuizPrompt = "";
    private const string DefaultJuizPrompt = @"Age como um juiz rigoroso de Inteligência Artificial. Analisa a qualidade factual, lógica e gramatical da resposta gerada por um modelo local pequeno para o prompt fornecido.

Prompt Original Submetido: [Colar aqui o 'Prompt Executado' da sua app]

Resposta Gerada pelo Modelo Local: [Colar aqui o texto da resposta do cartão da sua app]

Instruções de Resposta: Dá-me estritamente uma nota de 1 a 5 (onde 1 é péssimo/alucinação total e 5 é perfeito/factual) seguido de uma descrição muito breve, com um máximo de duas frases, apontando onde estão os principais problemas (alucinações, inversão de datas, omissões ou erros de tradução). Se não houver problemas, elogia de forma concisa.";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string>("localStorage.getItem", "ollama_models");

            if (!string.IsNullOrEmpty(stored))
                Models = JsonSerializer.Deserialize<List<string>>(stored) ?? new();
        }
        catch
        {
            Models = new();
        }

        try
        {
            var storedPrompt = await JS.InvokeAsync<string>("localStorage.getItem", "juiz_ai_prompt");
            JuizPrompt = string.IsNullOrEmpty(storedPrompt) ? DefaultJuizPrompt : storedPrompt;
        }
        catch
        {
            JuizPrompt = DefaultJuizPrompt;
        }
    }

    private async Task SaveJuizPrompt()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "juiz_ai_prompt", JuizPrompt);
    }

    private async Task CopiarPromptParaClipboard()
    {
        if (!string.IsNullOrWhiteSpace(JuizPrompt))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", JuizPrompt);
        }
    }

    private async Task ResetJuizPrompt()
    {
        JuizPrompt = DefaultJuizPrompt;
        await SaveJuizPrompt();
    }

    private async Task AddModel()
    {
        if (string.IsNullOrWhiteSpace(NewModel))
            return;

        if (!Models.Contains(NewModel))
        {
            Models.Add(NewModel);
            await SaveModels();
        }

        NewModel = "";
    }

    private async Task RemoveModel(string model)
    {
        Models.Remove(model);
        await SaveModels();
    }

    private async Task SaveModels()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "ollama_models",
            JsonSerializer.Serialize(Models));
    }

    void OnLoaded(LoadedEventArgs e) => Mode = e.Mode;
    void OnLuminanceChanged(LuminanceChangedEventArgs e) => Mode = e.Mode;
    void PickRandomColor() => OfficeColor = OfficeColorUtilities.GetRandom();
}
