@page "/benchmark-evaluations"
@rendermode InteractiveServer

@using Models.DTO
@using OllamaFluentUIChat.Components.Pages.Components
@using OllamaFluentUIChat.Services.Interfaces.Repositories
@using ClosedXML.Excel
@using System.IO
@using OllamaFluentUIChat.Models.Entities
@inject IBenchmarkRepository BenchmarkRepo
@inject IDialogService DialogService
@inject ILogger<App> Logger


@inject IJSRuntime JS

<div class="page">

    <div class="toolbar">

        <div class="toolbar-content">

            <div style="display: flex; gap: 12px; align-items: center; width: 100%; margin:16px;">
                <FluentSearch @bind-Value="_search"
                              Placeholder="Pesquisa benchmarks (modelo, prompt, ...)"
                              class="search-box" />

                <FluentSpacer />
                <FluentButton Appearance="Appearance.Lightweight"
                              Disabled="@(_benchmarks.Any() == false)"
                              Color="" BackgroundColor="rgba(231, 54, 24, 1)" Style="color:white"
                              IconEnd="@(new Icons.Regular.Size16.Delete())" OnClick="DeleteAllDataAsync">
                    Apagar Benchmarks
                </FluentButton>

                <FluentButton Appearance="Appearance.Outline"
                              Disabled="@(_benchmarks.Any() == false)"
                              IconStart="@(new Icons.Regular.Size24.ArrowDownload())"
                              @onclick="ExportarParaExcel">
                    Exportar para Excel
                </FluentButton>
            </div>

            <div class="filter-bar">
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.Todos)"
                              IconStart="@(new Icons.Regular.Size20.Grid())"
                              @onclick="() => _filtroAtual = BenchmarkFilter.Todos">
                    Todos
                </FluentButton>
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.PorAvaliar)"
                              IconStart="@(new Icons.Regular.Size20.Warning())"
                              @onclick="() => _filtroAtual = BenchmarkFilter.PorAvaliar">
                    Por Avaliar
                </FluentButton>
            </div>

        </div>

    </div>
    <div class="grid-container">

        <FluentDataGrid Items="@FilteredBenchmarks"
                        TGridItem="BenchmarkEvaluationModel"
                        Pagination="@_pagination"
                        DisplayMode="DataGridDisplayMode.Grid"
                        class="benchmark-grid">

            <PropertyColumn Property="@(b => b.PromptId)" Title="ID#" Width="60px" Align="Align.Center" Sortable="true" />
            <PropertyColumn Property="@(b => b.DataCriacaoFormatada)" Title="Data de Criação" Width="150px" Align="Align.Center" Tooltip="true" />
            <PropertyColumn Property="@(b => b.ModeloNome)" Title="Modelo" Sortable="true" Align="Align.Center" Width="150px" Tooltip="true" />

            <TemplateColumn Title="Prompt" Width="350px" Style="justify-content:flex-start;">
                <div class="prompt-cell">
                    @context.TextoPrompt
                </div>
            </TemplateColumn>

            <PropertyColumn Property="@(b => b.GeminiRating)" Title="Gemini" Align="Align.Center" Width="100px" Sortable="true" />
            <PropertyColumn Property="@(b => b.ChatGptRating)" Title="ChatGPT" Align="Align.Center" Width="100px" Sortable="true" />
            <PropertyColumn Property="@(b => b.TokensPorSegundo)" Title="Tokens/s" Align="Align.Center" Width="100px" Format="F2" Sortable="true" />
            <PropertyColumn Property="@(b => b.TempoPuroFormatado)" Title="Tempo" Align="Align.Center" Width="100px" Sortable="true" />
            <PropertyColumn Property="@(b => b.TamanhoTokens)" Title="Tokens" Align="Align.Center" Width="100px" Sortable="true" />

            <TemplateColumn Title="Ações" Align="Align.Center" Width="100px">
                <FluentButton Appearance="Appearance.Stealth"
                              IconStart="@(new Icons.Regular.Size24.Eye())"
                              OnClick="@(() => OpenDetailDialog(context))"
                              Title="Ver Detalhes" />
            </TemplateColumn>


        </FluentDataGrid>

    </div>

    <div class="pager">
        <FluentPaginator State="@_pagination" />
    </div>
</div>

<BenchmarkEvaluationDetail Response="@_selectedBenchmarkResponse"
                           Visible="@_isDialogVisible"
                           VisibleChanged="@((v) => _isDialogVisible = v)"
                           OnClose="@(() => _isDialogVisible = false)" />


<FluentDialogProvider />
<FluentMenuProvider />


@code {
    private IQueryable<BenchmarkEvaluationModel> _benchmarks = Enumerable.Empty<BenchmarkEvaluationModel>().AsQueryable();
    private PaginationState _pagination = new() { ItemsPerPage = 5 };
    private string? _search;
    private BenchmarkEvaluationModel? _selectedBenchmarkResponse;
    private bool _isDialogVisible = false;

    [Inject]
    private IBenchmarkRepository _benchmarkRepository { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var result = await _benchmarkRepository.BenchmarkResponseEvaluationAsync();
        _benchmarks = result.AsQueryable();
    }

    private void AlterarItensPorPagina(int novosItens)
    {
        _pagination.ItemsPerPage = novosItens;
        StateHasChanged();
    }

    private async Task DeleteAllDataAsync()
    {
        if (DialogService == null) return;

        try
        {
            var confirmacao = await DialogService.ShowConfirmationAsync(
                $"Tem a certeza que deseja apagar todos os Prompts?" +
                $"Isto irá remover permanentemente todas as respostas associadas (Cascading Delete).",
                "Sim, Apagar",
                "Cancelar",
                "Apagar");

            if (confirmacao == null) return;
            var resultado = await confirmacao.Result;

            if (resultado != null && !resultado.Cancelled)
            {
                bool eliminados = await BenchmarkRepo.DeleteAllPromptsAndHistoryAsync();
                await InvokeAsync(() =>
                {
                    if (eliminados)
                    {
                        _benchmarks = Enumerable.Empty<BenchmarkEvaluationModel>().AsQueryable();
                        StateHasChanged();
                    }
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Erro ao apagar os Prompts");
        }

    }

    private IQueryable<BenchmarkEvaluationModel> FilteredBenchmarks
    {
        get
        {
            IQueryable<BenchmarkEvaluationModel> query = _benchmarks;

            if (_filtroAtual == BenchmarkFilter.PorAvaliar)
            {
                query = query.Where(b => b.GeminiRating == 0 || b.ChatGptRating == 0);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(b =>
                    (b.ModeloNome != null && b.ModeloNome.Contains(_search)) ||
                    (b.TextoPrompt != null && b.TextoPrompt.Contains(_search)) ||
                    b.TokensPorSegundo.ToString().Contains(_search) ||
                    b.TamanhoTokens.ToString().Contains(_search));
            }

            return query;
        }
    }

    private async Task ExportarParaExcel()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Benchmarks");

        worksheet.Cell(1, 2).Value = "Modelo";
        worksheet.Cell(1, 3).Value = "Gemini";
        worksheet.Cell(1, 4).Value = "ChatGPT";
        worksheet.Cell(1, 5).Value = "Tokens/s";
        worksheet.Cell(1, 6).Value = "Tempo";
        worksheet.Cell(1, 7).Value = "Tokens";

        var headerRow = worksheet.Row(1);
        headerRow.Style.Font.Bold = true;
        headerRow.Style.Fill.BackgroundColor = XLColor.FromHtml("#F2F2F2");
        headerRow.Style.Font.FontColor = XLColor.Black;

        var dadosAgrupados = FilteredBenchmarks
            .ToList()
            .GroupBy(b => b.PromptId)
            .OrderBy(g => g.Key);

        int currentRow = 2;

        foreach (var grupo in dadosAgrupados)
        {
            var primeiroItem = grupo.First();

            worksheet.Cell(currentRow, 1).Value = $"ID #{primeiroItem.PromptId} ({primeiroItem.DataCriacaoFormatada})";
            worksheet.Cell(currentRow, 2).Value = primeiroItem.TextoPrompt;

            worksheet.Range(currentRow, 2, currentRow, 7).Merge();

            var linhaPrompt = worksheet.Row(currentRow);
            linhaPrompt.Style.Font.Bold = true;
            linhaPrompt.Style.Fill.BackgroundColor = XLColor.FromHtml("#0078d4");
            linhaPrompt.Style.Font.FontColor = XLColor.White;
            linhaPrompt.Style.Alignment.WrapText = true;
            linhaPrompt.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            int caracteresPorLinha = 150;
            int tamanhoTexto = primeiroItem.TextoPrompt?.Length ?? 0;

            if (tamanhoTexto > 0)
            {
                int linhasNecessarias = (int)Math.Ceiling((double)tamanhoTexto / caracteresPorLinha);

                linhaPrompt.Height = (linhasNecessarias * 19) + 10;
            }
            else
            {
                linhaPrompt.Height = 25;
            }

            currentRow++;
            int linhaInicialModelos = currentRow;

            foreach (var item in grupo)
            {
                worksheet.Cell(currentRow, 1).Value = "   ↳";
                worksheet.Cell(currentRow, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Right;
                worksheet.Cell(currentRow, 1).Style.Font.FontColor = XLColor.Gray;

                worksheet.Cell(currentRow, 2).Value = item.ModeloNome;
                worksheet.Cell(currentRow, 3).Value = item.GeminiRating;
                worksheet.Cell(currentRow, 4).Value = item.ChatGptRating;

                var cellTokensSeg = worksheet.Cell(currentRow, 5);
                cellTokensSeg.Value = item.TokensPorSegundo;
                cellTokensSeg.Style.NumberFormat.Format = "#,##0";

                worksheet.Cell(currentRow, 6).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                worksheet.Cell(currentRow, 6).Value = item.TempoPuroFormatado;

                worksheet.Cell(currentRow, 7).Value = item.TamanhoTokens;

                currentRow++;
            }

            int linhaFinalModelos = currentRow - 1;

            if (linhaFinalModelos >= linhaInicialModelos)
            {
                worksheet.Rows(linhaInicialModelos, linhaFinalModelos).Group();
            }

            currentRow++;
        }

        worksheet.Columns().AdjustToContents();
        worksheet.Column(2).Width = 80;

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        var content = stream.ToArray();

        var base64 = Convert.ToBase64String(content);
        var fileName = $"Benchmarks_Agrupados_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
    }

    private enum BenchmarkFilter { Todos, PorAvaliar }
    private BenchmarkFilter _filtroAtual = BenchmarkFilter.Todos;

    private Appearance GetAppearance(BenchmarkFilter filtro)
    {
        return _filtroAtual == filtro ? Appearance.Accent : Appearance.Stealth;
    }

    private void OpenDetailDialog(BenchmarkEvaluationModel response)
    {
        _selectedBenchmarkResponse = response;
        _isDialogVisible = true;
    }

}
<style>
    .page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--fill-color);
    }

    .toolbar {
        flex: 0 0 auto;
        padding: 10px 12px;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        background: var(--fill-color);
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .search-box {
        width: 100%;
        max-width: 520px;
    }

    .grid-container {
        margin-top: 1rem;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        display: flex;
    }

    fluent-data-grid {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
    }

    .prompt-cell {
        display: block;
        white-space: pre-wrap !important; 
        overflow-wrap: break-word !important;
        word-break: break-word !important;
        min-width: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        color: var(--neutral-foreground-rest);
    }

    fluent-data-grid-cell {
        white-space: normal !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }

        fluent-data-grid-cell[grid-column="Prompt"] {
            white-space: normal !important;
            overflow: visible !important;
            text-overflow: unset !important;
        }

    .pager {
        flex: 0 0 auto;
        position: sticky;
        bottom: 0;
        z-index: 30;
        display: flex;
        gap: 6px;
        justify-content: center;
        padding: 8px 0;
        background: var(--fill-color);
        border-top: 1px solid var(--neutral-stroke-rest);
        backdrop-filter: blur(6px);
    }

    .toolbar-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .filter-bar {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

        .filter-bar fluent-button {
            border-radius: 999px;
            min-width: 140px;
            transition: all .15s ease;
        }

    .filter-icon {
        margin-right: 6px;
    }

    @@media (max-width: 768px) {
        .filter-bar {
            flex-wrap: wrap;
        }

            .filter-bar fluent-button {
                min-width: auto;
            }
    }
</style>
