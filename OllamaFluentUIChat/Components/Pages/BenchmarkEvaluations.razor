@page "/benchmark-evaluations"
@rendermode InteractiveServer

@using Models.DTO
@using OllamaFluentUIChat.Components.Pages.Components
@using OllamaFluentUIChat.Services.Interfaces.Repositories
@using OllamaFluentUIChat.Services.Interfaces.Services
@using ClosedXML.Excel
@using System.IO
@using Microsoft.Extensions.Localization
@using OllamaFluentUIChat.Resources
@inject IStringLocalizer<SharedResources> L
@inject IBenchmarkRepository BenchmarkRepo
@inject IDialogService DialogService
@inject ILogger<App> Logger
@inject IAnalysisService AnalysisService
@inject IJSRuntime JS

<div class="page">

    <div class="toolbar">

        <div class="toolbar-content">

            <div style="display: flex; gap: 12px; align-items: center; width: 100%; margin:16px;">
                <FluentSearch @bind-Value="_search"
                              Placeholder="@L["Benchmarks.SearchPlaceholder"]"
                              class="search-box" />

                <FluentSpacer />

                <FluentButton Appearance="Appearance.Outline"
                              Disabled="@(_benchmarks.Any() == false)"
                              IconStart="@(new Icons.Regular.Size24.ArrowDownload())"
                              @onclick="ExportarParaExcel">
                    @L["Common.ExportExcel"]
                </FluentButton>
                <FluentButton Appearance="Appearance.Accent"
                              Disabled="@(_benchmarks.Any() == false || _isAnalyzing)"
                              IconStart="@(new Icons.Regular.Size24.BrainCircuit())"
                              @onclick="AnalisarResultadosComModeloLocal">
                    @L["Benchmarks.AnalysisLocal"]
                </FluentButton>

                <FluentButton Appearance="Appearance.Lightweight"
                              Disabled="@(_benchmarks.Any() == false)"
                              Color="rgba(255, 255,255, 1)"
                              BackgroundColor="rgba(231, 54, 24, 1)" Style="color:white"
                              IconStart="@(new Icons.Regular.Size16.Delete())" OnClick="DeleteAllDataAsync">
                    @L["Benchmarks.DeleteAll"]
                </FluentButton>

            </div>

            <div class="filter-bar">
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.Todos)"
                              IconStart="@(new Icons.Regular.Size20.Grid())"
                              @onclick="() => _filtroAtual = BenchmarkFilter.Todos">
                    @L["Benchmarks.FilterAll"]
                </FluentButton>
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.PorAvaliar)"
                              IconStart="@(new Icons.Regular.Size20.Warning())"
                              @onclick="() => _filtroAtual = BenchmarkFilter.PorAvaliar">
                    @L["Benchmarks.FilterToEvaluate"]
                </FluentButton>
                <FluentButton Appearance="@GetAppearance(BenchmarkFilter.Avaliados)"
                              IconStart="@(new Icons.Regular.Size20.Checkmark())"
                              @onclick="() => _filtroAtual = BenchmarkFilter.Avaliados">
                    @L["Benchmarks.FilterEvaluated"]
                </FluentButton>
            </div>

        </div>

    </div>
    <div class="grid-container">

        <FluentDataGrid Items="@FilteredBenchmarks"
                        TGridItem="BenchmarkEvaluationModel"
                        Pagination="@_pagination" OnRowDoubleClick="OnDoubleClick" 
                        RowSize="DataGridRowSize.Medium" 
                        DisplayMode="DataGridDisplayMode.Grid"
                        class="benchmark-grid">


            @* <PropertyColumn Property="@(b => b.DataCriacaoFormatada)" Title="@L["Benchmarks.ColCreationDate"]" Width="160px" Align="Align.Center" Sortable="true" /> *@
            <PropertyColumn Property="@(b => b.NomeModelo)" Title="@L["Benchmarks.ColModel"]" Sortable="true" Width="160px" />

            <TemplateColumn Title="@L["Benchmarks.ColDescription"]" Tooltip="true" Width="200px">
                <div class="prompt-cell">
                    @context.Descricao
                </div>
            </TemplateColumn>

            <PropertyColumn Property="@(b => b.GeminiRating)" Title="@L["Benchmarks.ColGemini"]" Align="Align.Center" Width="100px" Sortable="true">
                <HeaderCellItemTemplate>
                    <span class="header-blue">@L["Benchmarks.ColGemini"]</span>
                </HeaderCellItemTemplate>
            </PropertyColumn>
            <PropertyColumn Property="@(b => b.GeminiFactualRating)" Title="@L["Benchmarks.ColFactual"]" Align="Align.Center" Width="90px" Sortable="true" />
            <PropertyColumn Property="@(b => b.GeminiFormattingRating)" Title="@L["Benchmarks.ColFormatting"]" Align="Align.Center" Width="90px" Sortable="true" />
            <PropertyColumn Property="@(b => b.ChatGptRating)" Title="@L["Benchmarks.ColChatGpt"]" Align="Align.Center" Width="100px" Sortable="true">
                <HeaderCellItemTemplate>
                    <span class="header-blue">@L["Benchmarks.ColChatGpt"]</span>
                </HeaderCellItemTemplate>
            </PropertyColumn>
            <PropertyColumn Property="@(b => b.ChatGptFactualRating)" Title="@L["Benchmarks.ColFactual"]" Align="Align.Center" Width="90px" Sortable="true" />
            <PropertyColumn Property="@(b => b.ChatGptFormattingRating)" Title="@L["Benchmarks.ColFormatting"]" Align="Align.Center" Width="90px" Sortable="true" />
            <PropertyColumn Property="@(b => b.TokensPorSegundo)" Title="@L["Benchmarks.ColTokensPerSecond"]" Align="Align.Center" Width="110px" Format="F2" Sortable="true">
                <HeaderCellItemTemplate>
                    <span class="header-columns">@L["Benchmarks.ColTokensPerSecond"]</span>
                </HeaderCellItemTemplate>
                </PropertyColumn>
            <PropertyColumn Property="@(b => b.TempoPuroFormatado)"  Title="@L["Benchmarks.ColTime"]" Align="Align.Center" Width="100px" Sortable="true" >
                <HeaderCellItemTemplate>
                    <span class="header-columns">@L["Benchmarks.ColTime"]</span>
                </HeaderCellItemTemplate>

            </PropertyColumn>
            <PropertyColumn Property="@(b => b.TempoCargaFormatado)" Title="@L["Benchmarks.ColLoad"]" Align="Align.Center" Width="100px" Sortable="true" >
                <HeaderCellItemTemplate>
                    <span class="header-columns">@L["Benchmarks.ColLoad"]</span>
                </HeaderCellItemTemplate>

            </PropertyColumn>
            <PropertyColumn Property="@(b => b.TamanhoTokens)" Title="@L["Benchmarks.ColTokens"]" Align="Align.Center" Width="100px" Sortable="true" >
                <HeaderCellItemTemplate>
                    <span class="header-columns">@L["Benchmarks.ColTokens"]</span>
                </HeaderCellItemTemplate>
            </PropertyColumn>

            <TemplateColumn Title="@L["Benchmarks.ColActions"]" Align="Align.Center" Width="100px">
                <FluentButton Appearance="Appearance.Outline"
                              IconStart="@(new Icons.Regular.Size24.Eye())"
                              OnClick="@(() => OpenDetailDialog(context))"
                              Title="@L["Benchmarks.ViewDetails"]" />
                <FluentButton Appearance="Appearance.Outline"
                              Color="rgba(255, 255,255, 1)"
                              BackgroundColor="rgba(231, 54, 24, 1)" Style="color:white"
                              IconStart="@(new Icons.Regular.Size16.Delete())"
                              OnClick="@(() => DeleteBenchmark(context.ResponseId))"
                              Title="@L["Benchmarks.Delete"]" />
            </TemplateColumn>


        </FluentDataGrid>

    </div>

    <div class="pager">
        <FluentPaginator State="@_pagination" />
    </div>
    @if (_mostrarPainelAnalise)
    {
        <FluentDialog Hidden="@(!_mostrarPainelAnalise)"
                      Modal="true"
                      Class="evaluation-detail-benchmark"
                      Style="--dialog-width: 800px; --dialog-height: auto;"
                      TrapFocus="true"
                      AriaLabel="@L["Benchmarks.AriaLabelDetail"]">
            <FluentDialogBody>
                <BenchmarkAnalysisViewer IsAnalyzing="@_isAnalyzing"
                                         IsAnalyzingChanged="@((b) => _isAnalyzing = b)"
                                         AnaliseResultado="@_resultadoLocal"
                                         AnaliseResultadoChanged="@((r) => _resultadoLocal = r)"
                                         OnCancelarAnalise="@CancelarAnaliseDoPai" />
            </FluentDialogBody>
            <FluentDialogFooter>
                <FluentSpacer />
                <FluentButton Appearance="Appearance.Outline" Color="Color.Neutral"
                              Disabled="@_isAnalyzing"
                              OnClick="@(() => _mostrarPainelAnalise = false)">
                    @L["Common.Close"]
                </FluentButton>
            </FluentDialogFooter>
        </FluentDialog>
    }

</div>

<BenchmarkEvaluationDetail Response="@_selectedBenchmarkResponse"
                           Visible="@_isDialogVisible"
                           VisibleChanged="@((v) => _isDialogVisible = v)"
                            OnClose="@(() => _isDialogVisible = false)" />


@code {
    private IQueryable<BenchmarkEvaluationModel> _benchmarks = Enumerable.Empty<BenchmarkEvaluationModel>().AsQueryable();
    private PaginationState _pagination = new() { ItemsPerPage = 10 };
    private string? _search;
    private BenchmarkEvaluationModel? _selectedBenchmarkResponse;
    private bool _isDialogVisible = false;
    private bool _isAnalyzing = false;
    private bool _mostrarPainelAnalise = false;
    private BenchmarkAnalysisResult? _resultadoLocal;
    private CancellationTokenSource? _cts;

    private string _streamingLog = "";


    protected override async Task OnInitializedAsync()
    {
        await GetAllBenchmarks();
    }

    private async Task GetAllBenchmarks()
    {
        var result = await BenchmarkRepo.BenchmarkResponseEvaluationAsync();
        _benchmarks = result.AsQueryable();
    }

    private void AlterarItensPorPagina(int novosItens)
    {
        _pagination.ItemsPerPage = novosItens;
        StateHasChanged();
    }

    private async Task DeleteAllDataAsync()
    {
        if (DialogService == null) return;

        try
        {
            string mensagemHtml = $@"
                        <div style='padding: 4px; border-left: 4px solid #e73618;'>
                            <strong style='color: #e73618; font-size: 16px; display: block; margin-bottom: 8px;'>{L["Benchmarks.DeleteAllConfirmTitle"]}</strong>
                            <span style='color: var(--neutral-foreground-rest);'>{L["Benchmarks.DeleteAllConfirmMessage"]}</span>
                        </div>";

            var confirmacao = await DialogService.ShowConfirmationAsync(
                message: mensagemHtml,
                L["Benchmarks.DeleteAllYes"],
                L["Common.Cancel"],
                L["Benchmarks.DeleteAllTitle"]);

            if (confirmacao == null) return;
            var resultado = await confirmacao.Result;

            if (resultado != null && !resultado.Cancelled)
            {
                bool eliminados = await BenchmarkRepo.DeleteAllPromptsAndHistoryAsync();
                await InvokeAsync(() =>
                {
                    if (eliminados)
                    {
                        _benchmarks = Enumerable.Empty<BenchmarkEvaluationModel>().AsQueryable();
                        StateHasChanged();
                    }
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Erro ao apagar os Prompts");
        }

    }

    private async Task DeleteBenchmark(int responseId)
    {

        if (DialogService == null) return;

        try
        {

            string mensagemHtml = $@"
                        <div style='padding: 4px; border-left: 4px solid #e73618;'>
                            <strong style='color: #e73618; font-size: 16px; display: block; margin-bottom: 8px;'>{L["Benchmarks.DeleteAllConfirmTitle"]}</strong>
                            <span style='color: var(--neutral-foreground-rest);'>{L["Benchmarks.DeleteOneConfirmMessage"]}</span>
                        </div>";
            var confirmacao = await DialogService.ShowConfirmationAsync(
                message: mensagemHtml,
                L["Benchmarks.DeleteAllYes"],
                L["Common.Cancel"],
                L["Benchmarks.DeleteOneTitle"]
            );

            await InvokeAsync(StateHasChanged);

            if (confirmacao == null) return;
            var resultado = await confirmacao.Result;

            if (resultado != null && !resultado.Cancelled)
            {
                bool eliminado = await BenchmarkRepo.DeleteSpecificResponseAsync(responseId);
                if (eliminado)
                {
                    _benchmarks = _benchmarks.Where(b => b.ResponseId != responseId).AsQueryable();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Erro ao apagar o Prompt");
        }
    }


    private IQueryable<BenchmarkEvaluationModel> FilteredBenchmarks
    {
        get
        {
            IQueryable<BenchmarkEvaluationModel> query = _benchmarks;

            if (_filtroAtual == BenchmarkFilter.PorAvaliar)
            {
                query = query.Where(b => b.GeminiRating == 0 || b.ChatGptRating == 0);
            }
            else if (_filtroAtual == BenchmarkFilter.Avaliados)
            {
                query = query.Where(b => b.GeminiRating > 0 || b.ChatGptRating > 0);
            }

            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(b =>
                    (b.NomeModelo != null && b.NomeModelo.Contains(_search)) ||
                    (b.TextoPrompt != null && b.TextoPrompt.Contains(_search)) ||
                    b.TokensPorSegundo.ToString().Contains(_search) ||
                    b.TamanhoTokens.ToString().Contains(_search));
            }

            return query;
        }
    }

    private async Task ExportarParaExcel()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Benchmarks");

        worksheet.Cell(1, 2).Value = "Modelo";
        worksheet.Cell(1, 3).Value = "Gemini";
        worksheet.Cell(1, 4).Value = "ChatGpt";
        worksheet.Cell(1, 5).Value = "Tokens/s";
        worksheet.Cell(1, 6).Value = "Tempo";
        worksheet.Cell(1, 7).Value = "Tokens";

        var headerRow = worksheet.Row(1);
        headerRow.Style.Font.Bold = true;
        headerRow.Style.Fill.BackgroundColor = XLColor.FromHtml("#F2F2F2");
        headerRow.Style.Font.FontColor = XLColor.Black;

        var dadosAgrupados = FilteredBenchmarks
            .ToList()
            .GroupBy(b => b.PromptId)
            .OrderBy(g => g.Key);

        int currentRow = 2;

        foreach (var grupo in dadosAgrupados)
        {
            var primeiroItem = grupo.First();

            worksheet.Cell(currentRow, 1).Value = string.Format(L["Benchmarks.ExcelIdGroup"], $"#{primeiroItem.PromptId}", primeiroItem.DataCriacaoFormatada);
            worksheet.Cell(currentRow, 2).Value = primeiroItem.TextoPrompt;

            worksheet.Range(currentRow, 2, currentRow, 7).Merge();

            var linhaPrompt = worksheet.Row(currentRow);
            linhaPrompt.Style.Font.Bold = true;
            linhaPrompt.Style.Fill.BackgroundColor = XLColor.FromHtml("#0078d4");
            linhaPrompt.Style.Font.FontColor = XLColor.White;
            linhaPrompt.Style.Alignment.WrapText = true;
            linhaPrompt.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;

            int caracteresPorLinha = 150;
            int tamanhoTexto = primeiroItem.TextoPrompt?.Length ?? 0;

            if (tamanhoTexto > 0)
            {
                int linhasNecessarias = (int)Math.Ceiling((double)tamanhoTexto / caracteresPorLinha);

                linhaPrompt.Height = (linhasNecessarias * 19) + 10;
            }
            else
            {
                linhaPrompt.Height = 25;
            }

            currentRow++;
            int linhaInicialModelos = currentRow;

            foreach (var item in grupo)
            {
                worksheet.Cell(currentRow, 1).Value = "   ↳";
                worksheet.Cell(currentRow, 1).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Right;
                worksheet.Cell(currentRow, 1).Style.Font.FontColor = XLColor.Gray;

                worksheet.Cell(currentRow, 2).Value = item.NomeModelo;
                worksheet.Cell(currentRow, 3).Value = item.GeminiRating;
                worksheet.Cell(currentRow, 4).Value = item.ChatGptRating;

                var cellTokensSeg = worksheet.Cell(currentRow, 5);
                cellTokensSeg.Value = item.TokensPorSegundo;
                cellTokensSeg.Style.NumberFormat.Format = "#,##0";

                worksheet.Cell(currentRow, 6).Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
                worksheet.Cell(currentRow, 6).Value = item.TempoPuroFormatado;

                worksheet.Cell(currentRow, 7).Value = item.TamanhoTokens;

                currentRow++;
            }

            int linhaFinalModelos = currentRow - 1;

            if (linhaFinalModelos >= linhaInicialModelos)
            {
                worksheet.Rows(linhaInicialModelos, linhaFinalModelos).Group();
            }

            currentRow++;
        }

        worksheet.Columns().AdjustToContents();
        worksheet.Column(2).Width = 80;

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        var content = stream.ToArray();

        var base64 = Convert.ToBase64String(content);
        var fileName = $"Benchmarks_Agrupados_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
        await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
    }

    private enum BenchmarkFilter { Todos, PorAvaliar, Avaliados }
    private BenchmarkFilter _filtroAtual = BenchmarkFilter.Todos;

    private Appearance GetAppearance(BenchmarkFilter filtro)
    {
        return _filtroAtual == filtro ? Appearance.Accent : Appearance.Stealth;
    }

    private void OpenDetailDialog(BenchmarkEvaluationModel? response)
    {
        if (response == null) return;
        _selectedBenchmarkResponse = response;
        _isDialogVisible = true;
    }

    private async Task AnalisarResultadosComModeloLocal()
    {
        var dadosFiltrados = FilteredBenchmarks.ToList();

        // ===================================
        // Verifica quantidade de grupos de prompts
        // só deverá ser analisado um grupo de cada vez
        // ===================================
        var gruposDePrompts = dadosFiltrados
            .GroupBy(b => b.PromptId)
            .ToList();

        if (gruposDePrompts.Count > 1)
        {
            string mensagemHtml = $@"
            <div style='padding: 8px; border-left: 5px solid #e73618;'>
                <strong style='color: #e73618; font-size: 16px;'>{L["Benchmarks.MultipleGroupsWarning"]}</strong><br><br>
                <span style='color: var(--neutral-foreground-rest);'>
                    {L["Benchmarks.MultipleGroupsMessage", gruposDePrompts.Count]}
                </span>
            </div>";

            var confirmacao = await DialogService.ShowConfirmationAsync(
                message: mensagemHtml,
                L["Common.Confirm"],
                L["Common.Cancel"],
                L["Benchmarks.MultipleGroupsTitle"]);

            if (confirmacao == null) return;

            var resultado = await confirmacao.Result;
            if (resultado?.Cancelled == true)
            {
                return;
            }
        }

        // === Verificação existente: benchmarks não avaliados ===
        bool todosAvaliados = dadosFiltrados.All(b =>
            b.GeminiRating > 0 && b.ChatGptRating > 0);

        if (!todosAvaliados)
        {
            var naoAvaliados = dadosFiltrados.Count(b => b.GeminiRating == 0 || b.ChatGptRating == 0);
            string mensagemHtml = $@"
        <div style='padding: 8px; border-left: 5px solid #e73618;'>
            <strong style='color: #e73618; font-size: 16px;'>{L["Benchmarks.AttentionWarning"]}</strong><br><br>
            <span style='color: var(--neutral-foreground-rest);'>
                {L["Benchmarks.NotEvaluatedMessage", naoAvaliados]}
            </span>
        </div>";

            var confirmacao = await DialogService.ShowConfirmationAsync(
                message: mensagemHtml,
                L["Common.Confirm"],
                L["Common.Cancel"],
                L["Benchmarks.NotEvaluatedTitle"]);

            if (confirmacao == null) return;
            var resultado = await confirmacao.Result;
            if (resultado?.Cancelled == true)
            {
                return;
            }
        }

        // === Prossegue com a análise ===
        _mostrarPainelAnalise = true;
        _isAnalyzing = true;
        _resultadoLocal = null;
        StateHasChanged();

        try
        {
            if (dadosFiltrados.Count == 0)
            {
                _resultadoLocal = new BenchmarkAnalysisResult
                {
                    Sumario = L["Benchmarks.NoDataForAnalysis"]
                };
                return;
            }

            _cts?.Dispose();
            _cts = new CancellationTokenSource();
            _resultadoLocal = await AnalysisService.AnalisarBenchmarksAsync(
                dadosFiltrados,
                _cts.Token
            );
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Análise cancelada pelo utilizador.");
            _resultadoLocal = new BenchmarkAnalysisResult
            {
                Sumario = L["Benchmarks.AnalysisCancelled"],
                LinhasAnaliseDetalhada = new List<string>
                {
                    L["Benchmarks.AnalysisCancelledDetail"]
                }
            };
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao tentar efetuar a análise dos benchmarks.");
            _resultadoLocal = new BenchmarkAnalysisResult
            {
                Sumario = L["Benchmarks.AnalysisError"],
                LinhasAnaliseDetalhada = new List<string>
                {
                    L["Benchmarks.AnalysisErrorDetail"]
                }
            };
        }
        finally
        {
            _isAnalyzing = false;
            StateHasChanged();
        }
    }
    private void OnPartial(string chunk)
    {
        _streamingLog += chunk;
        StateHasChanged(); // 🔥 Atualiza o UI
    }
    private void CancelarAnaliseDoPai()
    {
        _cts?.Cancel();
    }

    private void OnDoubleClick(FluentDataGridRow<BenchmarkEvaluationModel> row)
    {
        if (row?.Item == null) return;
        OpenDetailDialog(row.Item);
    }

}
<style>
    .page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--fill-color);
    }

    .toolbar {
        flex: 0 0 auto;
        padding: 10px 12px;
        border-bottom: 1px solid var(--neutral-stroke-rest);
        background: var(--fill-color);
        position: sticky;
        top: 0;
        z-index: 20;
    }

    .search-box {
        width: 100%;
        max-width: 520px;
    }

    .grid-container {
        margin-top: 1rem;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        display: flex;
    }

    fluent-data-grid {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
    }

    .prompt-cell {
        display: block;
        white-space: pre-wrap !important;
        overflow-wrap: break-word !important;
        word-break: break-word !important;
        min-width: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
        color: var(--neutral-foreground-rest);
    }

    fluent-data-grid-cell {
        white-space: normal !important;
        overflow: visible !important;
        text-overflow: unset !important;
    }

        fluent-data-grid-cell[grid-column="Prompt"] {
            white-space: normal !important;
            overflow: visible !important;
            text-overflow: unset !important;
        }

    .pager {
        flex: 0 0 auto;
        position: sticky;
        bottom: 0;
        z-index: 30;
        display: flex;
        gap: 6px;
        justify-content: center;
        padding: 8px 0;
        background: var(--fill-color);
        border-top: 1px solid var(--neutral-stroke-rest);
        backdrop-filter: blur(6px);
    }

    .toolbar-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .filter-bar {
        display: flex;
        gap: 10px;
        margin-top: 8px;
    }

        .filter-bar fluent-button {
            border-radius: 999px;
            min-width: 140px;
            transition: all .15s ease;
        }

    .filter-icon {
        margin-right: 6px;
    }

    @@media (max-width: 768px) {
        .filter-bar {
            flex-wrap: wrap;
        }

            .filter-bar fluent-button {
                min-width: auto;
            }
    }

    .header-blue {
        display:flex;
        justify-content:center;
        color: var(--accent-fill-rest, #0078d4) !important;
        font-weight: 700;
        font-size: 0.9rem;
        border-radius: 3px;
        border: 1px solid var(--neutral-stroke-rest);
        align-items:center;
    }

    .header-columns {
        color: var(--accent-fill-rest, #0078d4);
        font-weight: 700;
    }

</style>
