@page "/settings"
@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components.Extensions
@using OllamaFluentUIChat.Resources
@using OllamaFluentUIChat.Services.Interfaces.Services
@rendermode InteractiveServer
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS
@inject IOllamaGpuService OllamaService

<FluentDesignTheme @bind-Mode="@Mode"
                   @bind-OfficeColor="@OfficeColor"
                   OnLoaded="@OnLoaded"
                   OnLuminanceChanged="@OnLuminanceChanged"
                   StorageName="theme" />

<div style="min-height: 250px; padding: 20px;">
    <FluentGrid>
        @* Configuração do Tema *@
        <FluentGridItem>
            <FluentSelect Label="@L["Settings.ThemeLabel"]"
                          Class="settings-select"
                          Width="250px"
                          Items="@(Enum.GetValues<DesignThemeModes>())"
                          @bind-SelectedOption="@Mode" />
        </FluentGridItem>

        @* Configuração da Cor *@
        <FluentGridItem>
            <FluentSelect Label="@L["Settings.ColorLabel"]"
                          Class="settings-select"
                          Items="@(Enum.GetValues<OfficeColor>().Select(i => (OfficeColor?)i))"
                          Height="200px"
                          Width="250px"
                          @bind-SelectedOption="@OfficeColor">
                <OptionTemplate>
                    <FluentStack>
                        <FluentIcon Value="@(new Icons.Filled.Size20.RectangleLandscape())"
                                    Color="Color.Custom"
                                    CustomColor="@(@context.ToAttributeValue() != "default" ? context.ToAttributeValue() : "#036ac4" )" />
                        <FluentLabel>@context</FluentLabel>
                    </FluentStack>
                </OptionTemplate>
            </FluentSelect>
            <FluentButton Appearance="Appearance.Accent" OnClick="PickRandomColor">@L["Settings.FeelingLucky"]</FluentButton>
        </FluentGridItem>

        @* Configuração do Modelo do Ollama *@
        <FluentGridItem xs="12" Style="margin-top: 20px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Bottom" Style="gap: 12px; flex-wrap: wrap;">
                @if (_isLoading)
                {
                    <FluentProgressRing />
                }
                else
                {
                    <FluentSelect Label="@L["Settings.ModelLabel"]"
                                  Class="settings-select"
                                  Width="250px"
                                  Items="@_availableModels"
                                  @bind-SelectedOption="@_selectedModel" />

                    <FluentButton Appearance="Appearance.Accent" OnClick="SaveModelAsync">
                        @L["Settings.SaveModel"]
                    </FluentButton>
                }
            </FluentStack>
            @if (!_isLoading && _availableModels.Count == 0)
            {
                <FluentLabel Style="color: var(--neutral-foreground-hint); margin-top: 8px;">
                    @L["Settings.NoModels"]
                </FluentLabel>
            }
        </FluentGridItem>
    </FluentGrid>
</div>

@code
{
    public DesignThemeModes Mode { get; set; }
    public OfficeColor? OfficeColor { get; set; }

    private List<string> _availableModels = new();
    private string _selectedModel = "";
    private bool _isLoading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _availableModels = new List<string>();
            var response = await OllamaService.GetLocalModelsAsync();
            foreach (var model in response?.Models ?? new())
            {
                if (!string.IsNullOrWhiteSpace(model?.Name))
                    _availableModels.Add(model.Name);
            }

            _selectedModel = await LoadSelectedModelAsync() ?? string.Empty;
            if (string.IsNullOrEmpty(_selectedModel) && _availableModels.Count > 0)
            {
                _selectedModel = _availableModels[0];
            }
        }
        catch
        {
            _availableModels = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string?> LoadSelectedModelAsync()
    {
        try
        {
            return await JS.InvokeAsync<string>("localStorage.getItem", "ollama_model");
        }
        catch { return null; }
    }

    private async Task SaveModelAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "ollama_model", _selectedModel);
        }
        catch { }
    }

    void OnLoaded(LoadedEventArgs e) { Mode = e.Mode; }
    void OnLuminanceChanged(LuminanceChangedEventArgs e) { Mode = e.Mode; }
    void PickRandomColor() { OfficeColor = OfficeColorUtilities.GetRandom(); }
}
<style>
    .settings-select {
        width: 250px;
    }

    @@media (max-width: 768px) {
        .settings-select {
            width: 100%;
        }
    }
</style>
