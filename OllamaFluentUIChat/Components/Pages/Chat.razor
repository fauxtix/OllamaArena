@page "/chat"
@rendermode InteractiveServer
@layout MainLayout
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaFluentUIChat.Components.Pages.Components

@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Chat - Ollama</PageTitle>

<div style="display: flex; justify-content: center; padding: 20px;">
    <FluentCard Style="width: 1100px; height: 600px; display: flex; flex-direction: column; padding: 16px; border-radius: 12px;">

        @* Cabeçalho *@
        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalAlignment="HorizontalAlignment.Start"
                     VerticalAlignment="VerticalAlignment.Center"
                     Style="border-bottom: 1px solid var(--neutral-stroke-layer-rest); padding-bottom: 12px; margin-bottom: 12px;">

            <FluentPersona Name="Ollama Streaming AI"
                           Status="@(_isThinking ? PresenceStatus.Busy : PresenceStatus.Available)"
                           Initials="AI" />

            <span style="font-size: 0.8rem; background-color: var(--neutral-layer-3); padding: 4px 8px; border-radius: 6px; color: var(--neutral-foreground-rest); margin-left: 8px;">
                Modelo: <strong>@ModelName</strong>
            </span>

            @* @if (_isThinking)
            {
                <FluentProgressRing Size="ProgressRingSize.Small" />
            } *@

        </FluentStack>

        @* Botões *@
        <FluentStack Orientation="Orientation.Horizontal" Style="gap: 8px; margin-bottom: 12px;">
            <FluentButton Appearance="Appearance.Outline"
                          IconStart="@(new Icons.Regular.Size16.Add())"
                          OnClick="NewChat"
                          Disabled="@_isThinking">
                Novo Chat
            </FluentButton>

            <FluentButton Appearance="Appearance.Stealth"
                          OnClick="@OpenHistory">
                Histórico
            </FluentButton>
        </FluentStack>

        @* Área de Mensagens *@
        <div @ref="messagesDiv"
             @onscroll="OnScroll"
             class="messages"
             style="flex-grow: 1; overflow-y: auto; padding-right: 8px; margin-bottom: 16px; display: flex; flex-direction: column; gap: 12px;">

            @foreach (var msg in _messages)
            {
                <div style="display: flex; flex-direction: column; align-items: @(msg.IsCurrentUser ? "flex-end" : "flex-start"); width: 100%;">
                    <span style="font-size: 0.75rem; color: var(--neutral-foreground-hint); margin-bottom: 2px;">
                        @msg.User • @msg.Timestamp.ToString("HH:mm")
                    </span>

                    <div class="chat-content"
                         style="max-width: 75%; padding: 10px 14px; border-radius: 12px; font-size: 0.9rem;
                        background-color: @(msg.IsCurrentUser ? "var(--accent-fill-rest)" : "var(--neutral-layer-2)");
                        color: @(msg.IsCurrentUser ? "var(--foreground-on-accent-rest)" : "var(--neutral-foreground-rest)");">

                        @if (ModelName.ToLower().Contains("mistral"))
                        {
                            @((MarkupString)FormatMistralMessage(msg.Text, msg.IsCurrentUser))
                        }
                        else
                        {
                            @((MarkupString)FormatMessage(msg.Text))
                        }
                    </div>
                </div>
            }
        </div>

        @* Zona de Input *@
        <FluentStack Orientation="Orientation.Horizontal"
                     Width="100%"
                     VerticalAlignment="VerticalAlignment.Center"
                     Style="gap: 8px;">

            <FluentTextField @key="_inputKey"
                             @bind-Value="_currentMessage"
                             Immediate="true"
                             Disabled="@_isThinking"
                             Placeholder="@(_isThinking ? "A IA está a responder..." : "Escreve uma mensagem...")"
                             Style="flex-grow: 1;"
                             @onkeydown="HandleKeyDown" />

            @if (!_isThinking)
            {
                <FluentButton Appearance="Appearance.Accent"
                              OnClick="@SendMessage"
                              Disabled="@(string.IsNullOrWhiteSpace(_currentMessage))"
                              Style="border-radius: 50%; min-width: 40px; width: 40px; height: 40px; padding: 2px; display: flex; align-items: center; justify-content: center;">
                    <div style="transform: rotate(-45deg); display: flex; margin-left: 2px; margin-top: -2px; margin-bottom:2px">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Send())" Color="Color.Lightweight" />
                    </div>
                </FluentButton>
            }
            else
            {
                <FluentButton Appearance="Appearance.Stealth"
                              OnClick="@CancelRequest"
                              Style="border-radius: 50%; min-width: 40px; width: 40px; height: 40px; padding: 0;
                    background-color: var(--status-error-background, rgba(220, 38, 38, 0.15));
                    color: var(--status-error-foreground, #dc2626);
                    display: flex; align-items: center; justify-content: center;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Square())" Color="Color.Custom" CustomColor="currentColor" />
                </FluentButton>
            }
        </FluentStack>
    </FluentCard>
    <HistoryPanel @ref="historyPanel" />
</div>


<style>
    .cursor {
        display: inline-block;
        width: 8px;
        animation: blink 1s step-start infinite;
        color: #007bff;
    }

    .chat-content ul, .chat-content ol {
        padding-left: 20px;
        margin: 4px 0;
    }

    .chat-content code {
        background-color: rgba(0,0,0,0.1);
        padding: 2px 4px;
        border-radius: 4px;
        font-family: monospace;
    }

    .typing-dots {
        display: flex;
        align-items: center;
        gap: 4px;
        height: 20px;
    }

        .typing-dots span {
            width: 6px;
            height: 6px;
            background-color: currentColor;
            border-radius: 50%;
            display: inline-block;
            animation: bounce 1.4s infinite ease-in-out both;
        }

            .typing-dots span:nth-child(1) {
                animation-delay: -0.32s;
            }

            .typing-dots span:nth-child(2) {
                animation-delay: -0.16s;
            }

    @@keyframes bounce {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1.0);
        }
    }
</style>
