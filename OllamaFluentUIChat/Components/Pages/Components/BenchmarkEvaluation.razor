@using OllamaFluentUIChat.Models.Entities
@using OllamaFluentUIChat.Services.Helpers
@inject IJSRuntime JS

@if (Response is not null)
{
    <div class="assessment-grid">
        <!-- COLUNA GOOGLE GEMINI -->
        <div class="judge-column judge-column-style">
            <div class="judge-header">
                <div class="judge-label-wrapper">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Accent" />
                    <div class="judge-label">Google Gemini</div>
                </div>
            </div>

            <!-- Grupo de Ratings com cabeçalho unificado -->
            <div class="ratings-group-container">
                <div class="ratings-group-header">Métricas de Avaliação (Escala 1-5)</div>
                <div class="ratings-row">
                    <div class="rating-cell">
                        <span class="rating-label">Factual</span>
                        <FluentNumberField Min="1" Max="5"
                                           @bind-Value="Response.GeminiFactualRating"
                                           Disabled="@(Response.GeminiFactualRating != null)" />
                    </div>

                    <div class="rating-cell">
                        <span class="rating-label">Formatação</span>
                        <FluentNumberField Min="1" Max="5"
                                           @bind-Value="Response.GeminiFormattingRating"
                                           Disabled="@(Response.GeminiFormattingRating != null)" />
                    </div>

                    <div class="rating-cell">
                        <span class="rating-label-bold">Global</span>
                        <FluentNumberField Min="1" Max="5"
                                           @bind-Value="Response.GeminiRating"
                                           Class="final-rating-field"
                                           Disabled="@(Response.GeminiRating != null)" />
                    </div>
                </div>
            </div>

            <!-- Caixa de Feedback original (Rows="10") -->
            <FluentTextArea Value="@Response.GeminiFeedback"
                            ValueChanged="@OnGeminiInputChanged"
                            Label="Feedback (Cole aqui o output bruto do Gemini)"
                            Style="font-size:14px;font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; width: 100%;"
                            Rows="10"
                            Disabled="@(!string.IsNullOrWhiteSpace(Response.GeminiFeedback))" />
        </div>

        <!-- COLUNA OPENAI CHATGPT -->
        <div class="judge-column judge-column-style">
            <div class="judge-header">
                <div class="judge-label-wrapper">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Accent" />
                    <div class="judge-label">Open AI ChatGpt</div>
                </div>
            </div>

            <!-- Grupo de Ratings com cabeçalho unificado -->
            <div class="ratings-group-container">
                <div class="ratings-group-header">Métricas de Avaliação (Escala 1-5)</div>
                <div class="ratings-row">
                    <div class="rating-cell">
                        <span class="rating-label">Factual</span>
                        <FluentNumberField Min="1" Max="5"
                                           @bind-Value="Response.ChatGptFactualRating"
                                           Disabled="@(Response.ChatGptFactualRating != null)" />
                    </div>

                    <div class="rating-cell">
                        <span class="rating-label">Formatação</span>
                        <FluentNumberField Min="1" Max="5"
                                           @bind-Value="Response.ChatGptFormattingRating"
                                           Disabled="@(Response.ChatGptFormattingRating != null)" />
                    </div>

                    <div class="rating-cell">
                        <span class="rating-label-bold">Global</span>
                        <FluentNumberField Min="1" Max="5"
                                           @bind-Value="Response.ChatGptRating"
                                           Class="final-rating-field"
                                           Disabled="@(Response.ChatGptRating != null)" />
                    </div>
                </div>
            </div>

            <!-- Caixa de Feedback original (Rows="10") -->
            <FluentTextArea Value="@Response.ChatGptFeedback"
                            ValueChanged="@OnChatGptInputChanged"
                            Label="Feedback (Cole aqui o output bruto do ChatGPT)"
                            Style="font-size:14px;font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; width: 100%;"
                            Rows="10"
                            Disabled="@(!string.IsNullOrWhiteSpace(Response.ChatGptFeedback))" />
        </div>
    </div>
}

@code {
    [Parameter] public BenchmarkResponse Response { get; set; } = default!;
    [Parameter] public EventCallback OnEvaluationChanged { get; set; }

    private async Task OnGeminiInputChanged(string value)
    {
        if (Response is null) return;

        if (value.Contains("FACTUAL_SCORE:", StringComparison.OrdinalIgnoreCase))
        {
            EvaluationParser.ParseEvaluation(value, out int? factual, out int? formatting, out int? final, out string desc);
            Response.GeminiFactualRating = factual;
            Response.GeminiFormattingRating = formatting;
            Response.GeminiRating = final;
            Response.GeminiFeedback = desc;
        }
        else
        {
            Response.GeminiFeedback = value;
        }

        StateHasChanged();
        await OnEvaluationChanged.InvokeAsync();
    }

    private async Task OnChatGptInputChanged(string value)
    {
        if (Response is null) return;

        if (value.Contains("FACTUAL_SCORE:", StringComparison.OrdinalIgnoreCase))
        {
            EvaluationParser.ParseEvaluation(value, out int? factual, out int? formatting, out int? final, out string desc);
            Response.ChatGptFactualRating = factual;
            Response.ChatGptFormattingRating = formatting;
            Response.ChatGptRating = final;
            Response.ChatGptFeedback = desc;
        }
        else
        {
            Response.ChatGptFeedback = value;
        }

        StateHasChanged();
        await OnEvaluationChanged.InvokeAsync();
    }
}

<style>
    .assessment-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        min-height: 40vh;
        width: 100%;
        box-sizing: border-box;
    }

    .judge-column {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
    }

        .judge-column textarea {
            flex-grow: 1;
            width: 100%;
        }

    .judge-column-style {
        background-color: var(--neutral-layer-2);
        padding: 14px;
        border-radius: 4px;
        border: 1px solid var(--neutral-stroke-divider);
    }

    .judge-label-wrapper {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .judge-label {
        display: inline-block;
        padding: 2px 6px;
        border: 1px solid var(--neutral-stroke-strong, #666);
        border-radius: 4px;
        font-weight: 600;
        color: var(--neutral-foreground-rest);
    }

    .judge-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

    /* Container do grupo de Notas */
    .ratings-group-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        background-color: rgba(0, 0, 0, 0.1);
        padding: 10px;
        border-radius: 4px;
        border: 1px dashed var(--neutral-stroke-divider);
    }

    .ratings-group-header {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        color: var(--neutral-foreground-rest);
        opacity: 0.7;
    }

    /* Linha dos inputs */
    .ratings-row {
        display: flex !important;
        flex-direction: row !important;
        gap: 20px !important;
        width: 100%;
    }

    .rating-cell {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: 4px;
    }

    .rating-label {
        font-size: 12px;
        color: var(--neutral-foreground-rest);
    }

    .rating-label-bold {
        font-size: 12px;
        font-weight: 600;
        color: var(--accent-fill-rest, #0078d4);
    }

    /* Definição das caixas de número */
    .rating-cell fluent-number-field,
    .rating-cell > * {
        width: 55px !important;
        min-width: 55px !important;
        height: 32px;
    }

        /* Centraliza o número e arredonda */
        .rating-cell fluent-number-field::part(control) {
            text-align: center !important;
            font-weight: 600;
            border-radius: 4px;
        }

        .rating-cell fluent-number-field input {
            text-align: center !important;
        }

    /* Realce na borda do campo Global */
    .final-rating-field ::part(control) {
        border: 1.5px solid var(--accent-fill-rest, #0078d4) !important;
        color: var(--accent-fill-rest, #0078d4);
    }
</style>