@using Microsoft.Extensions.Localization
@using OllamaFluentUIChat.Models.Entities
@using OllamaFluentUIChat.Resources
@using OllamaFluentUIChat.Services.Helpers
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS

@if (Response is not null)
{
    <div class="assessment-grid">
        <!-- COLUNA GOOGLE GEMINI -->
        <div class="judge-column judge-column-style">
            <div class="judge-header">
                <div class="judge-label-wrapper">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Accent" />
                    <div class="judge-label">@L["Evaluation.JudgeGemini"]</div>
                </div>
            </div>

            <!-- Grupo de Ratings com grelha para as 10 métricas -->
            <div class="ratings-group-container">
                <div class="ratings-group-header">@L["Evaluation.MetricsHeader"]</div>
                <div class="ratings-grid">
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricFactual"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiFactualRating" Disabled="@(Response.GeminiFactualRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricFormatting"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiFormattingRating" Disabled="@(Response.GeminiFormattingRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricCompliance"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiComplianceRating" Disabled="@(Response.GeminiComplianceRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricRelevance"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiRelevanceRating" Disabled="@(Response.GeminiRelevanceRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricTone"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiToneRating" Disabled="@(Response.GeminiToneRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricConciseness"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiConcisenessRating" Disabled="@(Response.GeminiConcisenessRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricClarity"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiClarityRating" Disabled="@(Response.GeminiClarityRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricReadability"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiReadabilityRating" Disabled="@(Response.GeminiReadabilityRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricHaloEffect"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiHaloEffectRating" Disabled="@(Response.GeminiHaloEffectRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricSafety"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiSafetyRating" Disabled="@(Response.GeminiSafetyRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label-bold">@L["Evaluation.MetricOverall"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.GeminiRating" Class="final-rating-field" Disabled="@(Response.GeminiRating != null)" />
                    </div>
                </div>
            </div>

            <!-- Caixa de Feedback -->
            <FluentTextArea Value="@Response.GeminiFeedback"
                            ValueChanged="@OnGeminiInputChanged"
                            Label="@L["Evaluation.FeedbackGemini"]"
                            Style="font-size:14px;font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; width: 100%;"
                            Rows="8"
                            Disabled="@(!string.IsNullOrWhiteSpace(Response.GeminiFeedback))" />
        </div>

        <!-- COLUNA OPENAI CHATGPT -->
        <div class="judge-column judge-column-style">
            <div class="judge-header">
                <div class="judge-label-wrapper">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Sparkle())" Color="Color.Accent" />
                    <div class="judge-label">@L["Evaluation.JudgeChatGpt"]</div>
                </div>
            </div>

            <!-- Grupo de Ratings com grelha para as 10 métricas -->
            <div class="ratings-group-container">
                <div class="ratings-group-header">@L["Evaluation.MetricsHeader"]</div>
                <div class="ratings-grid">
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricFactual"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptFactualRating" Disabled="@(Response.ChatGptFactualRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricFormatting"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptFormattingRating" Disabled="@(Response.ChatGptFormattingRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricCompliance"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptComplianceRating" Disabled="@(Response.ChatGptComplianceRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricRelevance"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptRelevanceRating" Disabled="@(Response.ChatGptRelevanceRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricTone"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptToneRating" Disabled="@(Response.ChatGptToneRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricConciseness"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptConcisenessRating" Disabled="@(Response.ChatGptConcisenessRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricClarity"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptClarityRating" Disabled="@(Response.ChatGptClarityRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricReadability"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptReadabilityRating" Disabled="@(Response.ChatGptReadabilityRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricHaloEffect"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptHaloEffectRating" Disabled="@(Response.ChatGptHaloEffectRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label">@L["Evaluation.MetricSafety"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptSafetyRating" Disabled="@(Response.ChatGptSafetyRating != null)" />
                    </div>
                    <div class="rating-cell">
                        <span class="rating-label-bold">@L["Evaluation.MetricOverall"]</span>
                        <FluentNumberField Min="1" Max="5" @bind-Value="Response.ChatGptRating" Class="final-rating-field" Disabled="@(Response.ChatGptRating != null)" />
                    </div>
                </div>
            </div>

            <!-- Caixa de Feedback -->
            <FluentTextArea Value="@Response.ChatGptFeedback"
                            ValueChanged="@OnChatGptInputChanged"
                            Label="@L["Evaluation.FeedbackChatGpt"]"
                            Style="font-size:14px;font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; width: 100%;"
                            Rows="8"
                            Disabled="@(!string.IsNullOrWhiteSpace(Response.ChatGptFeedback))" />
        </div>
    </div>
}

@code {
    [Parameter] public BenchmarkResponse Response { get; set; } = default!;
    [Parameter] public EventCallback OnEvaluationChanged { get; set; }

    private async Task OnGeminiInputChanged(string value)
    {
        if (Response is null) return;

        if (value.Contains("FACTUAL_SCORE:", StringComparison.OrdinalIgnoreCase))
        {
            var parsed = EvaluationParser.ParseEvaluation(value);

            Response.GeminiFactualRating = parsed.FactualScore;
            Response.GeminiFormattingRating = parsed.FormattingScore;
            Response.GeminiComplianceRating = parsed.ComplianceScore;
            Response.GeminiRelevanceRating = parsed.RelevanceScore;
            Response.GeminiToneRating = parsed.ToneScore;
            Response.GeminiConcisenessRating = parsed.ConcisenessScore;
            Response.GeminiClarityRating = parsed.ClarityScore;
            Response.GeminiReadabilityRating = parsed.ReadabilityScore;
            Response.GeminiHaloEffectRating = parsed.HaloEffectScore;
            Response.GeminiSafetyRating = parsed.SafetyScore;

            Response.GeminiRating = parsed.FinalScore;
            Response.GeminiFeedback = parsed.Description;
        }
        else
        {
            Response.GeminiFeedback = value;
        }

        StateHasChanged();
        await OnEvaluationChanged.InvokeAsync();
    }

    private async Task OnChatGptInputChanged(string value)
    {
        if (Response is null) return;

        if (value.Contains("FACTUAL_SCORE:", StringComparison.OrdinalIgnoreCase))
        {
            var parsed = EvaluationParser.ParseEvaluation(value);

            Response.ChatGptFactualRating = parsed.FactualScore;
            Response.ChatGptFormattingRating = parsed.FormattingScore;
            Response.ChatGptComplianceRating = parsed.ComplianceScore;
            Response.ChatGptRelevanceRating = parsed.RelevanceScore;
            Response.ChatGptToneRating = parsed.ToneScore;
            Response.ChatGptConcisenessRating = parsed.ConcisenessScore;
            Response.ChatGptClarityRating = parsed.ClarityScore;
            Response.ChatGptReadabilityRating = parsed.ReadabilityScore;
            Response.ChatGptHaloEffectRating = parsed.HaloEffectScore;
            Response.ChatGptSafetyRating = parsed.SafetyScore;

            Response.ChatGptRating = parsed.FinalScore;
            Response.ChatGptFeedback = parsed.Description;
        }
        else
        {
            Response.ChatGptFeedback = value;
        }

        StateHasChanged();
        await OnEvaluationChanged.InvokeAsync();
    }
}

<style>
    .assessment-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        min-height: 40vh;
        width: 100%;
        box-sizing: border-box;
    }

    .judge-column {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
    }

        .judge-column textarea {
            flex-grow: 1;
            width: 100%;
        }

    .judge-column-style {
        background-color: var(--neutral-layer-2);
        padding: 14px;
        border-radius: 4px;
        border: 1px solid var(--neutral-stroke-divider);
    }

    .judge-label-wrapper {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .judge-label {
        display: inline-block;
        padding: 2px 6px;
        border: 1px solid var(--neutral-stroke-strong, #666);
        border-radius: 4px;
        font-weight: 600;
        color: var(--neutral-foreground-rest);
    }

    .judge-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

    /* Container do grupo de Notas */
    .ratings-group-container {
        display: flex;
        flex-direction: column;
        gap: 8px;
        background-color: rgba(0, 0, 0, 0.1);
        padding: 10px;
        border-radius: 4px;
        border: 1px dashed var(--neutral-stroke-divider);
    }

    .ratings-group-header {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        color: var(--neutral-foreground-rest);
        opacity: 0.7;
    }

    /* Grelha adaptativa para os 11 campos de rating */
    .ratings-grid {
        display: grid !important;
        grid-template-columns: repeat(auto-fill, minmax(75px, 1fr)) !important;
        gap: 10px !important;
        width: 100%;
    }

    .rating-cell {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
    }

    .rating-label {
        font-size: 11px;
        color: var(--neutral-foreground-rest);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 75px;
    }

    .rating-label-bold {
        font-size: 11px;
        font-weight: bold;
        color: var(--accent-fill-rest, #0078d4);
    }

    /* Ajuste no tamanho das caixas de texto/número */
    .rating-cell fluent-number-field,
    .rating-cell > * {
        width: 100% !important;
        min-width: 50px !important;
        height: 32px;
    }

        .rating-cell fluent-number-field::part(control) {
            text-align: center !important;
            font-weight: 600;
            border-radius: 4px;
        }

        .rating-cell fluent-number-field input {
            text-align: center !important;
        }

    /* Realce na borda do campo Global */
    .final-rating-field ::part(control) {
        border: 1.5px solid var(--accent-fill-rest, #0078d4) !important;
        color: var(--accent-fill-rest, #0078d4);
        font-weight: bold;
    }
</style>