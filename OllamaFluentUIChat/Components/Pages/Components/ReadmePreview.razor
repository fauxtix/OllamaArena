@using Microsoft.Extensions.Localization
@using OllamaFluentUIChat.Resources
@using OllamaFluentUIChat.Services.Helpers
@inject IStringLocalizer<SharedResources> L
@inject ReadMeService readmeService
@inject ILogger<App> logger
@rendermode InteractiveServer

<FluentDialog Hidden="!IsOpen"
              Modal="true"
              TrapFocus="true"
              Class="dialog-large"
              AriaLabel="@L["Readme.AriaLabel"]">
    <FluentDialogHeader Visible="true">
        <FluentStack Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size24.DataHistogram())" />
            <FluentLabel Typo="Typography.PaneHeader">
                @L["Readme.Title"]
            </FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        <div class="markdown-body" style="max-width:48vw; max-height:65vh; overflow-y:auto;">
            @if (HtmlContent is null)
            {
                <p>@L["Common.Loading"]</p>
            }
            else
            {
                @((MarkupString)HtmlContent)
            }
        </div>
    </FluentDialogBody>
    <FluentDialogFooter>
        <div style="width: 100%; display: flex; justify-content: flex-end;">
            <FluentButton Appearance="Appearance.Neutral" OnClick="@Close">@L["Common.Close"]</FluentButton>
        </div>
    </FluentDialogFooter>
</FluentDialog>

@code {
    public bool IsOpen { get; set; }
    public string? HtmlContent { get; set; }

    public async Task OpenAsync()
    {
        IsOpen = true;
        StateHasChanged(); 

        try
        {
            var md = await readmeService.LoadReadmeAsync();
            HtmlContent = readmeService.MarkdownRenderer.ToHtml(md);

        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error occurred while loading README");
        }

        StateHasChanged();
    }

    private void Close()
    {
        IsOpen = false;
        StateHasChanged(); 
    }
}

<style>
    .markdown-body {
        font-family: Segoe UI, sans-serif;
        line-height: 1.6;
        overflow-x: hidden;
    }

        .markdown-body h1, .markdown-body h2, .markdown-body h3 {
            margin-top: 1rem;
            border-bottom: 1px solid #ddd;
            padding-bottom: .3rem;
        }

        .markdown-body pre {
            background: #f6f8fa;
            color: black;
            padding: 12px;
            border-radius: 6px;
            overflow-x: auto;
        }

    fluent-dialog.dialog-large::part(control) {
        --dialog-width: 50vw !important;
        --dialog-height: 85vh !important;
        max-width: 100% !important;
    }

    .header-separator,
    .footer-separator {
        width: 100%;
        height: 1px;
        background: rgba(255,255,255,0.6);
    }

    @@media (max-width: 768px) {
        fluent-dialog.dialog-large::part(control) {
            --dialog-width: 94vw !important;
        }

        .markdown-body {
            max-width: 94vw !important;
        }
    }
</style>
