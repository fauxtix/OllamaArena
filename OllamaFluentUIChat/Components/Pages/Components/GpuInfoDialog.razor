<FluentDialog Hidden="@(!Visible)"
              Modal="true"
              Width="550px">

    <FluentDialogHeader Visible="true">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" Gap="10">
            <FluentIcon Value="@(new Icons.Regular.Size24.QuestionCircle())" Color="Color.Warning" />
            <FluentLabel Size="IconSize.Large"><b>Informação do Sistema</b></FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        <div style="display: flex; flex-direction: column; gap: 1rem; line-height: 1.5;">

            <div>
                <h4 style="margin-bottom: 4px; color: var(--neutral-foreground-rest);">
                    O que significa "CPU fallback"?
                </h4>
                <p style="margin: 0;">
                    Ocorre quando a GPU não tem VRAM suficiente para carregar o modelo. Nesse caso, o processamento passa parcial ou totalmente para a CPU.
                </p>
            </div>

            <div>
                <h4 style="margin-bottom: 4px; color: var(--neutral-foreground-rest);">
                    VRAM insuficiente
                </h4>
                <p style="margin: 0;">
                    A tua placa gráfica não possui memória de vídeo livre suficiente para suportar este modelo. Quanto maior o modelo, maior a VRAM necessária.
                </p>
            </div>

            <div>
                <h4 style="margin-bottom: 4px; color: var(--neutral-foreground-rest);">
                    Impacto na velocidade
                </h4>
                <ul style="margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 4px;">
                    <li>O processamento na CPU é significativamente mais lento do que na GPU.</li>
                    <li>O tempo de resposta aumenta proporcionalmente ao tamanho do modelo.</li>
                    <li>Modelos pequenos (2B, mini, etc.) continuam utilizáveis mesmo sem GPU.</li>
                </ul>
            </div>

        </div>
    </FluentDialogBody>

    <FluentDialogFooter>
        <div class="dialog-footer-right">
            <FluentButton Appearance="Appearance.Stealth"
                          OnClick="Close"
                          class="btn-fechar">
                Fechar
            </FluentButton>
        </div>
    </FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter, EditorRequired]
    public bool Visible { get; set; } = false;

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private Task OnVisibleChanged(bool value)
    {
        Visible = value;
        return Task.CompletedTask;
    }

    public void Open()
    {
        Visible = true;
    }

    public async Task Close()
    {
        await VisibleChanged.InvokeAsync(false);
    }
}
<style>
    .dialog-footer-right {
        width: 100%;
        display: flex;
        justify-content: flex-end;
        padding: 8px 0;
    }

    .btn-fechar {
        border-radius: 6px;
        border: 1px solid var(--neutral-stroke-rest);
        padding: 8px 20px;
        min-width: 90px;
    }

        .btn-fechar:hover {
            background-color: var(--neutral-layer-3);
            border-color: var(--neutral-stroke-strong);
        }
</style>