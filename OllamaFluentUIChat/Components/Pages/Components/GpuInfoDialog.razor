@using Microsoft.Extensions.Localization
@using OllamaFluentUIChat.Resources
@inject IStringLocalizer<SharedResources> L

<FluentDialog Hidden="@(!Visible)"
              Modal="true"
              Width="550px"
              Class="gpu-info-dialog">

    <FluentDialogHeader Visible="true">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" Gap="10">
            <FluentIcon Value="@(new Icons.Regular.Size24.QuestionCircle())" Color="Color.Warning" />
            <FluentLabel Size="IconSize.Large"><b>@L["GpuDialog.Title"]</b></FluentLabel>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>
        <div style="display: flex; flex-direction: column; gap: 1rem; line-height: 1.5;">

            <div>
                <h4 style="margin-bottom: 4px; color: var(--neutral-foreground-rest);">
                    @L["GpuDialog.CpuFallbackTitle"]
                </h4>
                <p style="margin: 0;">
                    @L["GpuDialog.CpuFallbackBody"]
                </p>
            </div>

            <div>
                <h4 style="margin-bottom: 4px; color: var(--neutral-foreground-rest);">
                    @L["GpuDialog.VramTitle"]
                </h4>
                <p style="margin: 0;">
                    @L["GpuDialog.VramBody"]
                </p>
            </div>

            <div>
                <h4 style="margin-bottom: 4px; color: var(--neutral-foreground-rest);">
                    @L["GpuDialog.SpeedTitle"]
                </h4>
                <ul style="margin: 0; padding-left: 1.2rem; display: flex; flex-direction: column; gap: 4px;">
                    <li>@L["GpuDialog.SpeedItem1"]</li>
                    <li>@L["GpuDialog.SpeedItem2"]</li>
                    <li>@L["GpuDialog.SpeedItem3"]</li>
                </ul>
            </div>

        </div>
    </FluentDialogBody>

    <FluentDialogFooter>
        <div class="dialog-footer-right">
            <FluentButton Appearance="Appearance.Stealth"
                          OnClick="Close"
                          class="btn-fechar">
                @L["Common.Close"]
            </FluentButton>
        </div>
    </FluentDialogFooter>
</FluentDialog>

@code {
    [Parameter, EditorRequired]
    public bool Visible { get; set; } = false;

    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private Task OnVisibleChanged(bool value)
    {
        Visible = value;
        return Task.CompletedTask;
    }

    public void Open()
    {
        Visible = true;
    }

    public async Task Close()
    {
        await VisibleChanged.InvokeAsync(false);
    }
}
<style>
    .dialog-footer-right {
        width: 100%;
        display: flex;
        justify-content: flex-end;
        padding: 8px 0;
    }

    .btn-fechar {
        border-radius: 6px;
        border: 1px solid var(--neutral-stroke-rest);
        padding: 8px 20px;
        min-width: 90px;
    }

        .btn-fechar:hover {
            background-color: var(--neutral-layer-3);
            border-color: var(--neutral-stroke-strong);
        }

    fluent-dialog.gpu-info-dialog::part(control) {
        max-width: 95vw !important;
        width: min(550px, 95vw) !important;
    }
</style>