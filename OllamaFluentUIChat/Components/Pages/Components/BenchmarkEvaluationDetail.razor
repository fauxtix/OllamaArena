@using OllamaFluentUIChat.Models.DTO

<FluentDialog Hidden="@(!Visible)"
              Modal="true"
              Class="evaluation-detail-benchmark"
              Style="--dialog-width: 800px; --dialog-height: auto;"
              TrapFocus="true"
              AriaLabel="Detalhes da Avaliação Benchmark">

    <FluentDialogHeader Visible="true">
        <FluentStack Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Center">

            <div style="display: flex; align-items: flex-start; gap: 10px;">
                <FluentIcon Value="@(new Icons.Regular.Size24.Eye())" />
                <FluentLabel Typo="Typography.Body">
                    Detalhes - @Response?.NomeModelo
                </FluentLabel>

                <blockquote class="prompt-citacao" style="flex: 1; margin: 0;">
                    "@Response?.TextoPrompt"
                </blockquote>
            </div>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>

        @if (Response != null)
        {
            <div class="detail-container">
                <div class="ratings-grid-container">
                    <div class="ratings-header">
                        <div class="metric-cell header-metric">Métrica</div>
                        <div class="rating-cell header-cell">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Sparkle())" Color="Color.Accent" />
                            <span>Google Gemini</span>
                        </div>
                        <div class="rating-cell header-cell">
                            <FluentIcon Value="@(new Icons.Regular.Size16.Chat())" Color="Color.Accent" />
                            <span>Open AI ChatGPT</span>
                        </div>
                    </div>

                    @* 1. FACTUAL *@
                    <div class="ratings-row">
                        <div class="metric-cell">Factual</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiFactualRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptFactualRating)
                        </div>
                    </div>

                    @* 2. FORMATAÇÃO *@
                    <div class="ratings-row">
                        <div class="metric-cell">Formatação</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiFormattingRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptFormattingRating)
                        </div>
                    </div>
                    @* PONTUAÇÃO GLOBAL *@
                    <div class="ratings-row global-row">
                        <div class="metric-cell global-metric">Global</div>
                        <div class="rating-cell">
                            @if (Response.GeminiRating > 0)
                            {
                                <span class="rating-value global-value">@Response.GeminiRating</span>
                            }
                            else
                            {
                                <span class="rating-empty">—</span>
                            }
                        </div>
                        <div class="rating-cell">
                            @if (Response.ChatGptRating > 0)
                            {
                                <span class="rating-value global-value">@Response.ChatGptRating</span>
                            }
                            else
                            {
                                <span class="rating-empty">—</span>
                            }
                        </div>
                    </div>

                    <hr />
                    <div class="ratings-row">
                        <div class="metric-cell">Compliance</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiComplianceRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptComplianceRating)
                        </div>
                    </div>

                    <div class="ratings-row">
                        <div class="metric-cell">Relevância</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiRelevanceRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptRelevanceRating)
                        </div>
                    </div>

                    <div class="ratings-row">
                        <div class="metric-cell">Tom</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiToneRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptToneRating)
                        </div>
                    </div>

                    <div class="ratings-row">
                        <div class="metric-cell">Concisão</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiConcisenessRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptConcisenessRating)
                        </div>
                    </div>

                    <div class="ratings-row">
                        <div class="metric-cell">Clareza</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiClarityRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptClarityRating)
                        </div>
                    </div>

                    <div class="ratings-row">
                        <div class="metric-cell">Legibilidade</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiReadabilityRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptReadabilityRating)
                        </div>
                    </div>

                    <div class="ratings-row">
                        <div class="metric-cell">Efeito Halo</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiHaloEffectRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptHaloEffectRating)
                        </div>
                    </div>

                    <div class="ratings-row">
                        <div class="metric-cell">Segurança</div>
                        <div class="rating-cell">
                            @RenderRating(Response.GeminiSafetyRating)
                        </div>
                        <div class="rating-cell">
                            @RenderRating(Response.ChatGptSafetyRating)
                        </div>
                    </div>

                </div>
            </div>
        }
    </FluentDialogBody>

    <FluentDialogFooter>
        <FluentSpacer />

        <FluentButton Appearance="Appearance.Outline" Color="Color.Neutral"
                      OnClick="Fechar">
            Fechar
        </FluentButton>

    </FluentDialogFooter>

</FluentDialog>

@code {
    [Parameter, EditorRequired] public BenchmarkEvaluationModel? Response { get; set; }

    [Parameter, EditorRequired] public bool Visible { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Fechar()
    {
        await OnClose.InvokeAsync();
        await VisibleChanged.InvokeAsync(false);
    }

    // Helper render fragment para evitar repetição massiva de if/else no HTML
    private RenderFragment RenderRating(int? rating) => builder =>
    {
        if (rating.HasValue && rating > 0)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "rating-value");
            builder.AddContent(2, rating.Value);
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "rating-empty");
            builder.AddContent(2, "—");
            builder.CloseElement();
        }
    };
}

<style>
    .evaluation-detail-benchmark {
        /* Dialog styling inherited from Fluent UI */
    }

    .detail-container {
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* RATINGS GRID - CSS Grid layout */
    .ratings-grid-container {
        display: flex;
        flex-direction: column;
        gap: 0;
        background-color: var(--neutral-layer-1);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 4px;
        overflow: hidden;
    }

    .ratings-header {
        display: grid;
        grid-template-columns: 140px 1fr 1fr;
        gap: 0;
        background-color: var(--neutral-layer-2);
        border-bottom: 2px solid var(--neutral-stroke-divider);
        padding: 0;
    }

    .ratings-row {
        display: grid;
        grid-template-columns: 140px 1fr 1fr;
        gap: 0;
        border-bottom: 1px solid var(--neutral-stroke-rest);
    }

        .ratings-row:last-child {
            border-bottom: none;
        }

        .ratings-row:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }

    .metric-cell {
        padding: 10px 12px;
        text-align: left;
        font-weight: 600;
        color: var(--neutral-foreground-secondary);
        display: flex;
        align-items: center;
        font-size: 13px;
    }

        .metric-cell.header-metric {
            color: var(--neutral-foreground-rest);
        }

        .metric-cell.global-metric {
            font-weight: 700;
            color: var(--neutral-foreground-rest);
        }

    .rating-cell {
        padding: 10px 12px;
        text-align: center;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--neutral-foreground-rest);
    }

        .rating-cell.header-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-weight: 600;
            color: var(--neutral-foreground-rest);
            font-size: 13px;
        }

    .rating-value {
        display: inline-block;
        font-weight: 700;
        color: var(--accent-fill-rest);
        font-size: 15px;
        min-width: 30px;
    }

        .rating-value.global-value {
            color: var(--accent-fill-rest);
            font-size: 16px;
        }

    .rating-empty {
        color: var(--neutral-foreground-hint);
        font-size: 14px;
    }

    .global-row {
        background-color: rgba(0, 120, 212, 0.05);
        border-top: 2px solid var(--accent-fill-rest);
        border-bottom: 2px solid var(--accent-fill-rest);
    }

        .global-row:hover {
            background-color: rgba(0, 120, 212, 0.08);
        }

    .prompt-citacao {
        max-height: 18.0em;
        overflow-y: auto;
        overflow-x: hidden;
        white-space: normal;
        padding-right: 6px;
        font-size: 14px;
        line-height: 1.5;
    }
</style>