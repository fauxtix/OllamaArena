@using OllamaFluentUIChat.Models.Entities
@using OllamaFluentUIChat.Services.Interfaces.Repositories
@using OllamaFluentUIChat.Services.Interfaces.Services

<FluentDialog Hidden="@(!Visible)"
              Modal="true"
              Class="evaluation-dialogue-benchmark"
              Style="--dialog-width: 1200px; --dialog-height: auto;"
              TrapFocus="true"
              AriaLabel="Avaliação Benchmark">

    <FluentDialogHeader Visible="true">
        <FluentStack Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Center">

            <div style="display: flex; align-items: flex-start; gap: 10px; margin-top: 10px;">
                <FluentIcon Value="@(new Icons.Regular.Size24.ClipboardCode())" />
                <FluentLabel Typo="Typography.Body">
                    Avaliação - @Response?.NomeModelo
                </FluentLabel>

                <blockquote class="prompt-citacao" style="flex: 1; margin: 0; height:5vw; overflow-y: auto;">
                    "@prompt"
                </blockquote>
            </div>
        </FluentStack>
    </FluentDialogHeader>

    <FluentDialogBody>

        @if (Response != null)
        {
            <BenchmarkEvaluation Response="Response" OnEvaluationChanged="StateHasChanged" />
            <div class="grelha-botoes-traducao">

                <div>
                    <FluentButton Appearance="Appearance.Stealth"
                                  Disabled="@isTranslating"
                                  OnClick="TraduzirGemini">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Translate())" />
                        Traduzir Feedback (Gemini)
                    </FluentButton>
                </div>

                <div>
                    <FluentButton Appearance="Appearance.Stealth"
                                  Disabled="@isTranslating"
                                  OnClick="TraduzirChatGpt">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Translate())" />
                        Traduzir Feedback (ChatGPT)
                    </FluentButton>
                </div>

            </div>
        }
    </FluentDialogBody>

    <FluentDialogFooter>

        @if (isTranslating)
        {
            <FluentProgressRing Style="margin-right:12px;" />
        }

        <FluentSpacer />

        <FluentButton Appearance="Appearance.Accent" Disabled="@isTranslating"
                      OnClick="Guardar">
            Guardar avaliação
        </FluentButton>

        <FluentButton Appearance="Appearance.Stealth"
                      OnClick="Fechar">
            Fechar
        </FluentButton>

    </FluentDialogFooter>

</FluentDialog>

<FluentMenuProvider />
<FluentDialogProvider />


<TranslationPreviewDialog Visible="@showTranslationDialog"
                          VisibleChanged="@(v => showTranslationDialog = v)"
                          TranslatedText="@translatedText"
                          ModelUsed="@modelUsed" JudgeName="@targetField"
                          TimeSpent="@timeSpent"
                          OnAccept="AplicarTraducao" />

@code {
    [Inject] IBenchmarkRepository BenchmarkRepository { get; set; } = default!;
    [Inject] public ITranslationService TranslationService { get; set; } = default!;
    [Inject] public ILogger<App> Logger { get; set; } = default!;

    [Inject] protected IDialogService DialogService { get; set; } = default!;


    [Parameter, EditorRequired] public BenchmarkResponse? Response { get; set; }

    [Parameter, EditorRequired] public bool Visible { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public EventCallback<BenchmarkResponse> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string? prompt;

    private bool showTranslationDialog;
    private string? translatedText;
    private string? targetField;
    private bool isTranslating = false;
    private bool translationOK = true;

    private string? modelUsed;
    private string? timeSpent;

    protected override void OnParametersSet()
    {
        if (Response is not null)
        {
            _ = CarregarPromptAsync(Response.PromptId);
        }
    }

    private async Task CarregarPromptAsync(int promptId)
    {
        var resp = await BenchmarkRepository.GetBenchmarkByIdAsync(promptId);
        prompt = resp?.TextoPrompt;
        StateHasChanged();
    }

    private async Task Guardar()
    {
        try
        {
            if (Response is not null)
            {
                if (Response is not null)
                    await OnSave.InvokeAsync(Response);

                await Fechar();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erro ao guardar avaliação do benchmark.");
            await DialogService.ShowErrorAsync("Erro ao guardar avaliação do benchmark.", "Guardar alterações");
        }

    }

    private async Task Fechar()
    {
        await OnClose.InvokeAsync();
        await VisibleChanged.InvokeAsync(false);
    }

    private bool IsDisabled()
    {
        return
            Response?.GeminiRating != null &&
            Response?.ChatGptRating != null &&
            Response?.GeminiFeedback != null &&
            Response?.ChatGptFeedback != null;
    }


    private async Task TraduzirChatGpt()
    {
        if (Response?.ChatGptFeedback is null)
            return;

        targetField = "chatgpt";
        isTranslating = true;
        StateHasChanged();
        try
        {
            var result = await TranslationService.TranslateAsync(
                Response.ChatGptFeedback,
                Response.NomeModelo
            );

            translatedText = result.TranslatedText;
            modelUsed = result.ModelUsed;
            timeSpent = result.TimeSpentFormatted;

            showTranslationDialog = true;
        }
        catch (Exception ex)
        {
            await DialogService.ShowErrorAsync("Erro ao traduzir feedback do ChatGPT. Verifique os logs, por favor.", "Tradução Gemini");
            Logger.LogError(ex, "Erro ao traduzir feedback do ChatGPT");
        }
        finally
        {
            isTranslating = false;
            StateHasChanged();
        }

    }

    private async Task TraduzirGemini()
    {
        if (Response?.GeminiFeedback is null)
            return;

        targetField = "gemini";
        isTranslating = true;
        StateHasChanged();
        try
        {
            var result = await TranslationService.TranslateAsync(
                Response.GeminiFeedback,
                Response.NomeModelo
            );

            translatedText = result.TranslatedText;
            modelUsed = result.ModelUsed;
            timeSpent = result.TimeSpentFormatted;

            showTranslationDialog = true;
        }
        catch (Exception ex)
        {
            await DialogService.ShowErrorAsync("Erro ao traduzir feedback do Gemini. Verifique Logs, por favor.", "Tradução Gemini");


            Logger.LogError(ex, "Erro ao traduzir feedback do Gemini");
        }
        finally
        {
            isTranslating = false;
            StateHasChanged();
        }

    }

    private async Task AplicarTraducao(string texto)
    {
        if (Response is null)
            return;

        if (targetField == "chatgpt")
            Response.ChatGptFeedback = texto;

        if (targetField == "gemini")
            Response.GeminiFeedback = texto;

        StateHasChanged();
    }
}

<style>
    .evaluation-dialogue-benchmark {
        border-radius: 10px;
        max-width: 95vw;
        display: flex;
        flex-direction: column;
    }

        .evaluation-dialogue-benchmark .fluent-dialog-body {
            padding: 16px;
            overflow-y: auto;
        }

    .prompt-citacao {
        margin: 8px 0 16px 0;
        padding-left: 12px;
        border-left: 3px solid var(--neutral-stroke-rest);
        font-style: italic;
        color: var(--neutral-foreground-hint);
    }

    .detalhe-header {
        flex: 0 0 auto;
        background-color: var(--neutral-layer-1);
        padding-bottom: 8px;
        border-bottom: 1px solid var(--neutral-stroke-divider);
        margin-bottom: 12px;
    }

        .detalhe-header h3 {
            margin-top: 0;
        }

    .grelha-botoes-traducao {
        margin-top: 20px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }
</style>
