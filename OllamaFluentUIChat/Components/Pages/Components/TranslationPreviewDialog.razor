<FluentDialog Hidden="@(!Visible)" 
              Modal="true"
              Style="width: 60%"
              TrapFocus="true">

    <FluentDialogHeader Visible="true">
        <FluentLabel Typo="Typography.Header">
            Tradução do Feedback (@JudgeName)
        </FluentLabel>
    </FluentDialogHeader>

    <FluentDialogBody>

        <FluentLabel Typo="Typography.Subject">
            Modelo usado: @ModelUsed
        </FluentLabel>

        <FluentLabel Typo="Typography.Body">
            Tempo gasto: @TimeSpent
        </FluentLabel>

        <FluentTextArea Value="@TranslatedText"
                        Rows="10"
                        Style="margin-top:16px; width:100%;  overflow-y: auto;" />
    </FluentDialogBody>

    <FluentDialogFooter>
        <FluentSpacer />

        <FluentButton Appearance="Appearance.Accent"
                      OnClick="Aceitar">
            Aceitar e continuar
        </FluentButton>

        <FluentButton Appearance="Appearance.Stealth"
                      OnClick="Cancelar">
            Sair
        </FluentButton>
    </FluentDialogFooter>
</FluentDialog>

<FluentDialogProvider />

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter, EditorRequired] public string? JudgeName { get; set; }
    [Parameter] public string? TranslatedText { get; set; }
    [Parameter] public string? ModelUsed { get; set; }
    [Parameter] public string? TimeSpent { get; set; }
    [Parameter] public EventCallback<string> OnAccept { get; set; }

    private async Task Aceitar()
    {
        if (TranslatedText is not null)
            await OnAccept.InvokeAsync(TranslatedText);

        await VisibleChanged.InvokeAsync(false);
    }

    private async Task Cancelar()
    {
        await VisibleChanged.InvokeAsync(false);
    }
}
