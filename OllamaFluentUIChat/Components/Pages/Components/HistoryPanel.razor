@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaFluentUIChat.Models.DTO
@using OllamaFluentUIChat.Services.Interfaces.Repositories
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="history-overlay" @onclick="Close"></div>
}

<div class="history-aside @(IsOpen ? "open" : "")" @onclick:stopPropagation>
    <div class="header">
        <h3>Histórico de Execuções</h3>
        <FluentButton Appearance="Appearance.Stealth" OnClick="@Close">Fechar</FluentButton>
    </div>

    @if (History == null)
    {
        <p>A carregar...</p>
    }
    else if (History.Count() == 0)
    {
        <p>Sem histórico.</p>
    }
    else
    {
        <FluentPaginator State="@pagination" SummaryTemplate="@template" />
        <FluentDivider Style="width: 100%;" Role="DividerRole.Separator"></FluentDivider>
        <div>
            <FluentDataGrid Items="@History.AsQueryable()"
                            Pagination="@pagination">
                <PropertyColumn Property="@(h => h.Prompt)"
                                Title="Prompt"
                                Width="250px"
                                Tooltip="true" />
                <PropertyColumn Property="@(h => h.Modelo)"
                                Title="Modelo" />
                <PropertyColumn Property="@(h => h.DateDisplay)"
                                Title="Data" />
                <PropertyColumn Property="@(h => h.DurationDisplay)"
                                Title="Tempo" />
            </FluentDataGrid>
        </div>
    }
</div>

@code {

    [Inject]
    public required IBenchmarkRepository BenchmarksRepo { get; set; }
    private IEnumerable<HistoryResponse> History { get; set; } = [];
    public bool IsOpen { get; set; }

    PaginationState pagination = new PaginationState() { ItemsPerPage = 12 };
    private RenderFragment template = @<span />;

    public async Task Open()
    {
        Console.WriteLine("HistoryPanel.Open() chamado");

        try
        {
            History = await BenchmarksRepo.HistoryResponseAsync() ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine("ERRO em Open() - HistoryPanel: " + ex.Message);
        }

        IsOpen = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsOpen = false;
    }

    public async Task ClearHistory()
    {
        History = [];
        StateHasChanged();
    }
}

<style>
    .history-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.35);
        z-index: 9998;
        animation: fadeIn 0.25s ease;
    }

    .history-aside {
        position: fixed;
        top: 0;
        right: 0;
        width: 40vw;
        height: 80vh;
        background: var(--neutral-layer-1);
        color: var(--neutral-foreground-rest);
        box-shadow: -4px 0 12px rgba(0,0,0,0.2);
        padding: 16px;
        overflow-y: auto;
        z-index: 9999;
        transform: translateX(100%);
        transition: transform 0.35s ease;
    }

        .history-aside.open {
            transform: translateX(0);
        }

        .history-aside .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>