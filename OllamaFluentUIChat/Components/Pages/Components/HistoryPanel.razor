@using Microsoft.Extensions.Localization
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaFluentUIChat.Models.DTO
@using OllamaFluentUIChat.Resources
@using OllamaFluentUIChat.Services.Interfaces.Repositories
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime JS
@inject ILogger<App> _logger

@if (IsOpen)
{
    <div class="history-overlay" @onclick="Close"></div>
}

<div class="history-aside @(IsOpen ? "open" : "")" @onclick:stopPropagation>
    <div class="header">
        <h3>@L["HistoryPanel.Title"]</h3>
        <FluentButton Appearance="Appearance.Stealth" OnClick="@Close">@L["Common.Close"]</FluentButton>
    </div>

    @if (History == null)
    {
        <p>@L["Common.Loading"]</p>
    }
    else if (History.Count() == 0)
    {
        <p>@L["HistoryPanel.NoHistory"]</p>
    }
    else
    {
        <FluentPaginator State="@pagination" SummaryTemplate="@template" />
        <FluentDivider Style="width: 100%;" Role="DividerRole.Separator"></FluentDivider>
        <div>
            <FluentDataGrid Items="@History.AsQueryable()"
                            Pagination="@pagination">
                <PropertyColumn Property="@(h => h.Descricao)"
                                Title="@L["HistoryPanel.ColPrompt"]"
                                Width="250px"
                                Tooltip="true" />
                <PropertyColumn Property="@(h => h.Modelo)"
                                Title="@L["HistoryPanel.ColModel"]" />
                <PropertyColumn Property="@(h => h.DateDisplay)" Align="Align.Center"
                                Title="@L["HistoryPanel.ColDate"]" />
                <PropertyColumn Property="@(h => h.DurationDisplay)" Align="Align.Center"
                                Title="@L["HistoryPanel.ColEvalTime"]" />
                <PropertyColumn Property="@(h => h.ProcessDurationDisplay)" Align="Align.Center"
                                Title="@L["HistoryPanel.ColProcessTime"]" />
            </FluentDataGrid>
        </div>
    }
</div>

@code {

    [Inject]
    public required IBenchmarkRepository BenchmarksRepo { get; set; }
    private IEnumerable<HistoryResponse> History { get; set; } = [];
    public bool IsOpen { get; set; }

    PaginationState pagination = new PaginationState() { ItemsPerPage = 12 };
    private RenderFragment template = @<span />;

    public async Task Open()
    {
        try
        {
            History = await BenchmarksRepo.HistoryResponseAsync() ?? [];
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "ERRO em Open() - HistoryPanel");
        }

        IsOpen = true;
        StateHasChanged();
    }

    public void Close()
    {
        IsOpen = false;
    }

    public async Task ClearHistory()
    {
        History = [];
        StateHasChanged();
    }
}

<style>
    .history-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.35);
        z-index: 9998;
        animation: fadeIn 0.25s ease;
    }

    .history-aside {
        position: fixed;
        top: 0;
        right: 0;
        width: min(92vw, 560px);
        height: 100dvh;
        background: var(--neutral-layer-1);
        color: var(--neutral-foreground-rest);
        box-shadow: -4px 0 12px rgba(0,0,0,0.2);
        padding: 16px;
        overflow-y: auto;
        overflow-x: hidden;
        z-index: 9999;
        transform: translateX(100%);
        transition: transform 0.35s ease;
    }

        .history-aside.open {
            transform: translateX(0);
        }

        .history-aside fluent-data-grid {
            min-width: 520px;
        }

        .history-aside .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }
</style>