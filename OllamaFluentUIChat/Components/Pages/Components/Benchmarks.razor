@page "/benchmarks"
@rendermode InteractiveServer

@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaFluentUIChat.Models.Entities
@using OllamaFluentUIChat.Services.Interfaces.Repositories
@inject IBenchmarkRepository BenchmarkRepo
@inject IDialogService DialogService
@inject ILogger<App> Logger

<div class="analise-container-horizontal">

    <div class="pagina-header">
        <h2>Análise de Qualidade e Métricas</h2>
        <FluentButton Appearance="Appearance.Accent" IconEnd="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="GetDataAsync">
            Atualizar Dados
        </FluentButton>
    </div>

    @if (_promptsList == null)
    {
        <div class="loading-state">
            <FluentProgressRing></FluentProgressRing>
            <p>A carregar o histórico do SQLite...</p>
        </div>
    }
    else if (!_promptsList.Any())
    {
        <div class="empty-state">
            <p>Nenhum registo de benchmark encontrado na Base de Dados.</p>
        </div>
    }
    else
    {
        <FluentSplitter Orientation="Orientation.Horizontal"
                        BarSize="6"
                        Panel1Size="33.3%"
                        Panel1MinSize="250px"
                        Panel2MinSize="400px"
                        Style="height: calc(100vh - 120px); width: 100%;">

            <Panel1>
                <div class="painel-esquerdo-scroll">
                    <div class="lista-cards-prompts">
                        @foreach (var prompt in _promptsList)
                        {
                            <FluentCard MinimalStyle="true"
                                        Class="@($"card-prompt-item {(prompt == _selectedPrompt ? "card-selecionado" : "")}")"
                                        @onclick="@(() => SeleccionarPrompt(prompt))">

                                <div class="card-prompt-header">
                                    <span class="prompt-id-badge">#@prompt.Id</span>
                                    <span class="prompt-data">@prompt.DataCriacaoFormatada</span>
                                </div>

                                <div class="card-prompt-body">
                                    <p class="prompt-texto-curto">@prompt.TextoPrompt</p>
                                </div>

                                <div class="card-prompt-footer">
                                    <FluentBadge Appearance="Appearance.Neutral">@(prompt.Answers?.Count ?? 0) modelos</FluentBadge>

                                    <FluentButton Appearance="Appearance.Stealth"
                                                  Color="Color.Error"
                                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                                  OnClick="@( async () => await ApagarPromptAsync(prompt))"
                                                  StopPropagation="true">
                                    </FluentButton>
                                </div>
                            </FluentCard>
                        }
                    </div>
                </div>
            </Panel1>

            <Panel2>
                <div class="painel-direito-container">
                    @if (_selectedPrompt == null)
                    {
                        <div class="placeholder-direito">
                            <FluentIcon Value="@(new Icons.Regular.Size32.DocumentSearch())" Color="Color.Neutral" />
                            <p>Selecione um prompt na lista da esquerda para analisar as respostas dos modelos.</p>
                        </div>
                    }
                    else
                    {
                        <div class="detalhe-header">
                            <h3>Respostas Geradas para o Prompt #@_selectedPrompt.Id</h3>
                            <blockquote class="prompt-citacao">"@_selectedPrompt.TextoPrompt"</blockquote>
                        </div>

                        @if (!_selectedPrompt.Answers.Any())
                        {
                            <FluentMessageBar Intent="MessageIntent.Warning" AllowClose="false">
                                Este prompt foi guardado, mas não existem respostas associadas na tabela.
                            </FluentMessageBar>
                        }
                        else
                        {
                            <div class="conteudo-respostas-scroll">
                                <div class="cartoes-respostas-container">
                                    @foreach (var resp in _selectedPrompt.Answers)
                                    {
                                        <div class="cartao-resposta">
                                            <div class="cartao-header">
                                                <div class="modelo-info">
                                                    <FluentIcon Value="@(new Icons.Regular.Size20.Bot())" Color="Color.Neutral" />
                                                    <h4>@resp.ModeloNome</h4>
                                                </div>
                                                <div class="metricas-tags">
                                                    <FluentBadge Appearance="Appearance.Accent">@resp.TokensPorSegundo T/s</FluentBadge>
                                                    <FluentBadge Appearance="Appearance.Neutral">Eval: @(resp.TempoPuroMs)ms</FluentBadge>
                                                    <FluentBadge Appearance="Appearance.Neutral">Load: @(resp.TempoCargaMs)ms</FluentBadge>
                                                    <FluentBadge Appearance="Appearance.Neutral">Tokens: @resp.TamanhoTokens</FluentBadge>
                                                </div>
                                            </div>

                                            <div class="cartao-corpo">
                                                <div class="texto-resposta-raw">
                                                    @((MarkupString)ConverterQuebrasLinha(resp.TextoResposta))
                                                </div>
                                            </div>

                                            <hr class="divisor-avaliacao" />
                                            <div class="zona-avaliacao-editavel">
                                                <h5>Avaliação Externa (Juiz de IA)</h5>

                                                <div class="grelha-avaliacao">
                                                    <div class="coluna-juiz">
                                                        <div class="juiz-titulo">
                                                            <FluentIcon Value="@(new Icons.Regular.Size16.Sparkle())" Color="Color.Accent" />
                                                            <span>Google Gemini</span>
                                                        </div>
                                                        <FluentNumberField Min="1" Max="5" @bind-Value="resp.GeminiRating" Label="Rating (1-5)" Style="width: 100%;" />
                                                        <FluentTextArea @bind-Value="resp.GeminiFeedback"
                                                                        Label="Problemas Encontrados"
                                                                        Rows="3"
                                                                        Placeholder="Insira o feedback resumido..."
                                                                        Style="width: 100%; resize: vertical;" />
                                                    </div>

                                                    <div class="coluna-juiz">
                                                        <div class="juiz-titulo">
                                                            <FluentIcon Value="@(new Icons.Regular.Size16.Lightbulb())" Color="Color.Warning" />
                                                            <span>OpenAI ChatGPT</span>
                                                        </div>
                                                        <FluentNumberField Min="1" Max="5" @bind-Value="resp.ChatGptRating" Label="Rating (1-5)" Style="width: 100%;" />

                                                        <FluentTextArea @bind-Value="resp.ChatGptFeedback"
                                                                        Label="Problemas Encontrados"
                                                                        Rows="3"
                                                                        Placeholder="Insira o feedback resumido..."
                                                                        Style="width: 100%; resize: vertical;" />
                                                    </div>
                                                </div>

                                                <div class="acoes-avaliacao">
                                                    <FluentButton Appearance="Appearance.Lightweight"
                                                                  IconStart="@(new Icons.Regular.Size16.Save())"
                                                                  OnClick="@(async () => await GuardarAvaliacaoAsync(resp))">
                                                        Gravar Avaliação
                                                    </FluentButton>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </Panel2>

        </FluentSplitter>
    }
</div>

<FluentDialogProvider />

@code {
    private List<BenchmarkPrompt>? _promptsList;
    private BenchmarkPrompt? _selectedPrompt;
    private IQueryable<BenchmarkPrompt>? _promptsQueryable;
    private PaginationState _pagination = new() { ItemsPerPage = 5 };

    protected override async Task OnInitializedAsync() => await GetDataAsync();

    private async Task GetDataAsync()
    {
        _promptsList = null;
        StateHasChanged();
        _promptsList = await BenchmarkRepo.GetAllBenchmarksAsync();
        _promptsQueryable = _promptsList?.AsQueryable();
        if (_selectedPrompt != null && _promptsList != null)
        {
            _selectedPrompt = _promptsList.FirstOrDefault(p => p.Id == _selectedPrompt.Id);
        }
        StateHasChanged();
    }

    private void SeleccionarPrompt(BenchmarkPrompt prompt)
    {
        _selectedPrompt = prompt;
        StateHasChanged();
    }

    private async Task ApagarPromptAsync(BenchmarkPrompt prompt)
    {
        if (prompt == null || DialogService == null) return;
        try
        {
            int totalRespostas = prompt.Answers?.Count ?? 0;
            var confirmacao = await DialogService.ShowConfirmationAsync(
                $"Tem a certeza que deseja apagar o Prompt #{prompt.Id}? " +
                $"Isto irá remover permanentemente todas as {totalRespostas} respostas associadas (Cascading Delete).",
                "Sim, Apagar",
                "Cancelar",
                "Apagar Prompt");

            if (confirmacao == null) return;
            var resultado = await confirmacao.Result;

            if (resultado != null && !resultado.Cancelled)
            {
                bool eliminado = await BenchmarkRepo.DeletePromptAndHistoryAsync(prompt.Id);
                if (eliminado)
                {
                    if (_selectedPrompt?.Id == prompt.Id) _selectedPrompt = null;
                    await GetDataAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Erro ao apagar o Prompt #{prompt.Id}");
        }
    }

    private string ConverterQuebrasLinha(string? texto) => texto?.Replace("\n", "<br />") ?? "";

    private async Task GuardarAvaliacaoAsync(BenchmarkResponse resposta)
    {
        if (resposta == null || BenchmarkRepo == null) return;

        try
        {
            if (resposta.GeminiRating is < 1 or > 5 || resposta.ChatGptRating is < 1 or > 5)
            {
                if (DialogService != null)
                {
                    await DialogService.ShowErrorAsync("O rating introduzido deve situar-se estritamente entre 1 e 5.", "Erro de Validação");
                }
                return;
            }

            bool guardado = await BenchmarkRepo.UpdateResponseEvaluationAsync(resposta);

            if (guardado && DialogService != null)
            {
                Logger.LogInformation($"[BENCHMARK] Avaliação do modelo {resposta.ModeloNome} guardada com sucesso.");

                await DialogService.ShowInfoAsync($"Avaliação do modelo {resposta.ModeloNome} atualizada com sucesso no SQLite.", "Sucesso");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"[SQLITE ERROR] Falha ao atualizar avaliação: {ex.Message}");
        }
    }
}

<style>
    .analise-container-horizontal {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 40px);
        overflow: hidden;
    }

    .pagina-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        background-color: var(--neutral-layer-1);
        flex: 0 0 auto;
    }

    /* O painel de 1/3 ajusta os cartões de forma limpa */
    .painel-esquerdo-scroll {
        height: 100%;
        overflow-y: auto;
        padding: 16px;
        box-sizing: border-box;
        background-color: var(--neutral-layer-2);
        border-right: 1px solid var(--neutral-stroke-rest);
    }

    /* O painel de 2/3 mantém o cabeçalho fixo */
    .painel-direito-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px;
        box-sizing: border-box;
        overflow: hidden;
    }

    .detalhe-header {
        flex: 0 0 auto;
        background-color: var(--neutral-layer-1);
        padding-bottom: 8px;
        border-bottom: 1px solid var(--neutral-stroke-divider);
        margin-bottom: 12px;
    }

    .conteudo-respostas-scroll {
        flex: 1 1 auto;
        overflow-y: auto;
        padding-right: 4px;
    }

    .lista-cards-prompts {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .card-prompt-item {
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease;
        padding: 12px;
        border: 1px solid var(--neutral-stroke-rest);
        width: 100%; /* Garante que o card ocupa o 1/3 total disponível */
        box-sizing: border-box;
    }

        .card-prompt-item:hover {
            transform: translateY(-2px);
            box-shadow: var(--elevation-shadow-card-hover);
        }

    .card-selecionado {
        border-left: 4px solid var(--accent-fill-rest) !important;
        background-color: var(--neutral-layer-3) !important;
    }

    .card-prompt-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .prompt-id-badge {
        font-weight: bold;
        color: var(--accent-fill-rest);
    }

    .prompt-data {
        font-size: 11px;
        color: var(--neutral-foreground-hint);
    }

    .prompt-texto-curto {
        margin: 4px 0 10px 0;
        font-size: 13px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-prompt-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .placeholder-direito {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 70%;
        color: var(--neutral-foreground-hint);
    }

    .cartoes-respostas-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 4px;
    }

    .cartao-resposta {
        background: var(--neutral-layer-1);
        border: 1px solid var(--neutral-stroke-rest);
        border-radius: 4px;
        padding: 16px;
    }

    .cartao-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--neutral-stroke-divider);
        padding-bottom: 8px;
        margin-bottom: 12px;
    }

    .modelo-info {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .modelo-info h4 {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
        }

    .metricas-tags {
        display: flex;
        gap: 6px;
    }

    .detalhe-header h3 {
        margin-top: 0;
    }

    .prompt-citacao {
        margin: 8px 0 16px 0;
        padding-left: 12px;
        border-left: 3px solid var(--neutral-stroke-rest);
        font-style: italic;
        color: var(--neutral-foreground-hint);
    }

    .cartao-corpo {
        font-size: 13.5px;
        line-height: 1.5;
    }

    .texto-resposta-raw {
        word-break: break-word;
        max-width: 850px;
    }

    /* --- SECÇÃO DE AVALIAÇÃO EDITÁVEL --- */
    .divisor-avaliacao {
        border: 0;
        border-top: 1px dashed var(--neutral-stroke-divider);
        margin: 16px 0 12px 0;
    }

    .zona-avaliacao-editavel h5 {
        margin: 0 0 12px 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--neutral-foreground-hint);
    }

    .grelha-avaliacao {
        display: flex;
        gap: 20px;
        margin-bottom: 12px;
    }

    .coluna-juiz {
        flex: 1; /* Divide o espaço igualmente (50% Gemini, 50% ChatGPT) */
        background-color: var(--neutral-layer-2);
        padding: 12px;
        border-radius: 4px;
        border: 1px solid var(--neutral-stroke-divider);
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .juiz-titulo {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: bold;
    }

    .acoes-avaliacao {
        display: flex;
        justify-content: flex-end;
        margin-top: 8px;
    }
</style>
