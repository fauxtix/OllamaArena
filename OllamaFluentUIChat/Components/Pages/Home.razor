@page "/"
@using System.Text.Json
@using OllamaFluentUIChat.Components.Pages.Components
@using OllamaFluentUIChat.Services
@using OllamaFluentUIChat.Services.Helpers
@using OllamaFluentUIChat.Services.Interfaces.Services
@using static OllamaFluentUIChat.Models.DTO.OllamaModels

@inject IDialogService DialogService
@inject OllamaModelsInitializer ModelsInitializer
@rendermode InteractiveServer


<PageTitle>Home</PageTitle>

<div class="home-container">
    <FluentStack Orientation="Orientation.Vertical"
                 HorizontalAlignment="HorizontalAlignment.Center"
                 VerticalAlignment="VerticalAlignment.Center"
                 Style="width: 100%; gap: 30px;">
        <FluentStack Orientation="Orientation.Horizontal"
                     HorizontalAlignment="HorizontalAlignment.Center"
                     VerticalAlignment="VerticalAlignment.Center"
                     Style="gap: 50px;">

            <FluentCard Style="padding: 12px; width: max-content; height: max-content;">
                <img src="images/OllamaAsAJudge.png"
                     alt="Imagem gerada por IA"
                     style="box-shadow: var(--elevation-shadow-card-hover);
                width: 28vw;
                height: 36vh;
                object-fit: cover;
                display: block;
                overflow: hidden;
                border-radius: calc(var(--layer-corner-radius) * 1px);" />
            </FluentCard>

            <FluentCard Style="padding: 12px; width: max-content; height: max-content;">
                <img src="images/OllamaWithFluentUI.jpg"
                     alt="Imagem gerada por IA"
                     style="box-shadow: var(--elevation-shadow-card-hover);
                width: 28vw;
                height: 36vh;
                object-fit: cover;
                display: block;
                overflow: hidden;
                border-radius: calc(var(--layer-corner-radius) * 1px);" />
            </FluentCard>

        </FluentStack>

        <div>
            <FluentButton Appearance="Appearance.Outline" OnClick="ShowReadme">Ver README</FluentButton>
        </div>

        @if (showOllamaError)
        {
            <div style="background-color: rgba(0, 0, 0, 0.2); z-index: 9999;">
                <FluentMessageBar Title="Não foi possível carregar os modelos"
                                  Style="width: 500px; border: 2px solid var(--accent-fill-rest);"
                                  Intent="MessageIntent.Error"
                                  Type="@MessageType.Notification">
                    O serviço Ollama não está em execução. Inicie o serviço e recarregue a página.
                </FluentMessageBar>
            </div>
        }

    </FluentStack>
</div>
<ReadmePreview @ref="preview" />

@code {
    [Inject] public required InternetConnectivityService Internet { get; set; }
    [Inject] public IJSRuntime JS { get; set; } = default!;
    [Inject] public IOllamaGpuService? GpuService { get; set; }
    [Inject] public ILogger<App>? _logger { get; set; }

    private ReadmePreview? preview;
    private List<string> _models = new();
    private List<ModelDetails> _fullModels = new();
    private DotNetObjectReference<Home>? _dotNetRef;

    private bool showOllamaError = false;
    private string ollamaErrorMessage = "";

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = false
    };

    protected override async Task OnInitializedAsync()
    {
        showOllamaError = false;

        var isOllamaRunning = await OllamaChecker.IsOllamaRunningAsync();
        if (!isOllamaRunning)
        {
            showOllamaError = true;
            ollamaErrorMessage = "O servidor Ollama não está em execução. Por favor, inicie o Ollama.";
            _logger?.LogError("Ollama server is not running.");
        }
    }

    private async Task ShowReadme()
    {
        var hasInternet = await Internet.HasInternetAsync();
        if (!hasInternet)
        {
            await DialogService.ShowErrorAsync("Internet indisponível. Verifique, por favor.", "Acesso ao ficheiro");
            return;
        }

        if (preview is not null)
        {
            await preview.OpenAsync();
        }
    }
}
<style>
    .home-container {
        display: flex;
        justify-content: center;
        align-items: center;
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
        width: 100%;
    }
</style>