@page "/modelos-ollama"
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaFluentUIChat.Services.Interfaces.Services
@using static OllamaFluentUIChat.Models.DTO.OllamaModels
@inject IOllamaGpuService OllamaGpuService
@rendermode InteractiveServer

<PageTitle>Modelos Disponíveis - Ollama</PageTitle>

<FluentDesignTheme StorageName="theme" />

<h2 class="fluent-h2" style="margin-bottom: 4px;">Modelos Locais Instalados</h2>
<p class="fluent-body" style="margin-bottom: 25px; color: var(--neutral-foreground-hint);">
    Consulte os modelos guardados no seu disco, a capacidade nativa de contexto do ficheiro e a compatibilidade estimada com a sua placa gráfica.
</p>

<div style="margin-top: 15px;">
    @if (_isLoading)
    {
        <FluentProgressRing />
    }
    else if (_localModels is null || !_localModels.Any())
    {
        <FluentBadge Appearance="Appearance.Accent">
            Nenhum modelo local detetado ou Ollama inacessível.
        </FluentBadge>
    }
    else
    {
        <FluentDataGrid Items="@_localModels.AsQueryable()" TGridItem="ModelDetails" ResizableColumns="true">
            <PropertyColumn Property="@(m => m.Name)" Title="Nome" Sortable="true" Style="color:steelblue; font-weight:700; font-size: 1rem;" />

            <TemplateColumn Title="Família">
                @context.Details?.Family
            </TemplateColumn>
            <TemplateColumn Title="Parâmetros" Align="Align.Center">
                @context.Details?.ParameterSize
            </TemplateColumn>
            <TemplateColumn Title="Quantização">
                @context.Details?.QuantizationLevel
            </TemplateColumn>
            <TemplateColumn Title="Ano de Treino"
                            Style="color:cadetblue; font-weight:500; font-size: 0.9rem;">
                @context.TrainingYear
            </TemplateColumn>

            <TemplateColumn Title="Contexto Máximo" Sortable="true" Width="150px">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right"
                             VerticalAlignment="VerticalAlignment.Center" Style="gap: 6px;">
                   @*  <FluentIcon Value="@(new Icons.Regular.Size16.BroadActivityFeed())"
                                Color="Color.Neutral" /> *@
                    <span>@context.ContextLength.ToString("N0") tokens</span>
                </FluentStack>
            </TemplateColumn>

            <TemplateColumn Title="Tamanho no Disco" Align="Align.Center">
                @context.SizeInGB GB
            </TemplateColumn>

            <TemplateColumn Title="Compatibilidade GPU">
                @{
                    var gpuCheck = OllamaGpuService.CheckGpuCompatibility(context.SizeInBytes);
                    if (gpuCheck.AvailableVramGB == 0)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">Leitura VRAM Indisponível</FluentBadge>
                    }
                    else if (gpuCheck.FitsInGpu)
                    {
                        <FluentBadge Appearance="Appearance.Accent" Color="Color.Success">Compatível (~@gpuCheck.EstimatedRequiredMemoryGB GB)</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Accent" Color="Color.Warning">Excede VRAM (~@gpuCheck.EstimatedRequiredMemoryGB GB)</FluentBadge>
                    }
                }
            </TemplateColumn>
        </FluentDataGrid>
    }

</div>

@code {
    private List<ModelDetails>? _localModels = null;
    private bool _isLoading { get; set; }
    public string TrainingYear { get; set; } = "Desconhecido";

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        await Task.Delay(100);
        var tagsResponse = await OllamaGpuService.GetLocalModelsAsync();
        _localModels = tagsResponse.Models;

        if (_localModels != null && _localModels.Any())
        {
            foreach (var model in _localModels)
            {
                var metadata = await OllamaGpuService.GetExtendedModelMetadataAsync(model.Model);

                model.ContextLength = metadata.ContextLength;
                model.TrainingYear = metadata.TrainingYear;
            }
        }
        _isLoading = false;
        StateHasChanged();

    }
}
<style>
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        text-align: center;
        min-height: 120px;
    }

</style>