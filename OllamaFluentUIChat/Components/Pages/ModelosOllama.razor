@page "/modelos-ollama"
@using System.Text.Json
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaFluentUIChat.Services.Interfaces.Services
@using static OllamaFluentUIChat.Models.DTO.OllamaModels
@inject IOllamaGpuService OllamaGpuService
@inject IJSRuntime JS
@inject ILogger<ModelosOllama>? Logger
@rendermode InteractiveServer

<PageTitle>Modelos Disponíveis - Ollama</PageTitle>

<FluentDesignTheme StorageName="theme" />

<h2 class="fluent-h2" style="margin-bottom: 4px;">Modelos Locais Instalados</h2>
<p class="fluent-body" style="margin-bottom: 25px; color: var(--neutral-foreground-hint);">
    Consulte os modelos guardados no seu disco, a capacidade nativa de contexto do ficheiro e a compatibilidade estimada com a sua placa gráfica.
</p>

<div style="margin-top: 15px;">
    @if (_isLoading)
    {
        <FluentProgressRing />
    }
    else if (_localModels is null || !_localModels.Any())
    {
        <FluentBadge Appearance="Appearance.Accent">
            Nenhum modelo local detetado ou Ollama inacessível.
        </FluentBadge>
    }
    else
    {
        <FluentDataGrid Items="@_localModels.AsQueryable()" TGridItem="ModelDetails" ResizableColumns="true">
            <PropertyColumn Property="@(m => m.Name)" Title="Nome" Sortable="true"
                            Style="color:steelblue; font-weight:700; font-size: 1rem;" />

            <TemplateColumn Title="Família" Width="180px">
                @context.Details?.Family
            </TemplateColumn>

            <TemplateColumn Title="Parâmetros" Align="Align.Center" Width="120px">
                @context.Details?.ParameterSize
            </TemplateColumn>

            <TemplateColumn Title="Quantização" Width="130px" Align="Align.Center">
                @context.Details?.QuantizationLevel
            </TemplateColumn>

            <TemplateColumn Title="Ano de Treino" Align="Align.Center" Width="140px"
                            Style="color:cadetblue; font-weight:500; font-size: 0.9rem;">
                @context.TrainingYear
            </TemplateColumn>

            <TemplateColumn Title="Contexto Máximo" Width="170px">
                <FluentStack Orientation="Orientation.Horizontal"
                             HorizontalAlignment="HorizontalAlignment.Right"
                             VerticalAlignment="VerticalAlignment.Center"
                             Style="gap: 6px;">
                    <span>@context.ContextLength.ToString("N0") tokens</span>
                </FluentStack>
            </TemplateColumn>

            <TemplateColumn Title="Tamanho no Disco" Align="Align.Center" Width="170px">
                @context.SizeInGB GB
            </TemplateColumn>

            <TemplateColumn Title="Compatibilidade GPU" Width="180px">
                @{
                    var gpuCheck = OllamaGpuService.CheckGpuCompatibility(context.SizeInBytes);
                    if (gpuCheck.AvailableVramGB == 0)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">Leitura VRAM Indisponível</FluentBadge>
                    }
                    else if (gpuCheck.FitsInGpu)
                    {
                        <FluentBadge Appearance="Appearance.Accent" Fill="success">
                            Compatível (~@gpuCheck.EstimatedRequiredMemoryGB GB)
                        </FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Fill="warning">
                            Excede VRAM (~@gpuCheck.EstimatedRequiredMemoryGB GB)
                        </FluentBadge>
                    }
                }
            </TemplateColumn>
        </FluentDataGrid>
    }
</div>

@code {
    private List<ModelDetails>? _localModels;
    private bool _isLoading = true;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = false
    };

    private const string NamesKey = "ollamaModels"; 
    private const string FullKey = "ollamaModelsFull"; 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            if (_localModels is null || !_localModels.Any())
            {
                // 1. Tentar carregar a cache completa guardada pela Home (localStorage)
                _localModels = await LoadFullFromStorageAsync();

                if (_localModels is null || !_localModels.Any())
                {
                    // Cache vazia → ir ao Ollama, filtrar, enriquecer e gravar
                    var names = await LoadNamesFromStorageAsync() ?? [];

                    var response = await OllamaGpuService.GetLocalModelsAsync();
                    var allModels = response.Models ?? [];

                    // Filtrar só os que estão nos nomes guardados (ou usar todos se a lista de nomes estiver vazia)
                    _localModels = names.Any()
                        ? allModels.Where(m => names.Contains(m.Model)).ToList()
                        : allModels;

                    // Enriquecer
                    foreach (var model in _localModels)
                    {
                        var metadata = await OllamaGpuService.GetExtendedModelMetadataAsync(model.Model);
                        model.ContextLength = metadata.ContextLength;
                        model.TrainingYear = metadata.TrainingYear;
                    }

                    // Guardar a versão completa para próximas visitas
                    await SaveFullToStorageAsync(_localModels);
                }
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Erro ao carregar modelos na página Modelos Ollama");
            _localModels = [];
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<List<string>?> LoadNamesFromStorageAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", NamesKey);
            if (string.IsNullOrWhiteSpace(json)) return null;
            return JsonSerializer.Deserialize<List<string>>(json);
        }
        catch { return null; }
    }

    private async Task<List<ModelDetails>?> LoadFullFromStorageAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", FullKey);
            if (string.IsNullOrWhiteSpace(json)) return null;
            return JsonSerializer.Deserialize<List<ModelDetails>>(json, JsonOptions);
        }
        catch { return null; }
    }

    private async Task SaveFullToStorageAsync(List<ModelDetails> models)
    {
        var json = JsonSerializer.Serialize(models, JsonOptions);
        await JS.InvokeVoidAsync("localStorage.setItem", FullKey, json);
    }
}

<style>
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        text-align: center;
        min-height: 120px;
    }

    fluent-badge {
        --badge-fill-warning: #ff3c2e;
        --badge-color-warning: blue;
    }

    fluent-badge {
        --badge-fill-success: green;
        --badge-color-success: #fff;
    }

</style>