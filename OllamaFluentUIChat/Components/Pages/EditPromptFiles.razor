@page "/edit-prompts"
@using Microsoft.FluentUI.AspNetCore.Components
@using OllamaFluentUIChat.Services.Interfaces.Services
@using OllamaFluentUIChat.Services
@rendermode InteractiveServer

@inject ILogger<App> Logger
@inject IToastService ToastService
@inject ISystemPromptService SystemPromptService
@inject PromptFilesService PromptFilesService
@inject NavigationManager NavigationManager

<PageTitle>Editor de Prompts</PageTitle>

<div class="edit-prompts-main">
    <div class="prompt-editor-pane">
        <div class="prompt-header-row">
            <div class="prompt-title">
                <FluentHeader Style="background-color:transparent; color: green; font-size:1.5rem;margin: 0;">
                    Prompt do sistema
                </FluentHeader>
            </div>

            <div class="prompt-actions">
                <FluentButton Appearance="Appearance.Accent"
                              Style="border-radius:10px"
                              IconStart="@(new Icons.Regular.Size16.Save())"
                              OnClick="OnSave">
                    Gravar
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline"
                              Style="border-radius:10px"
                              IconStart="@(new Icons.Regular.Size16.Dismiss())"
                              OnClick="OnCancel">
                    Cancelar
                </FluentButton>
                <FluentButton Appearance="Appearance.Lightweight"
                              Style="border-radius:10px"
                              IconStart="@(new Icons.Regular.Size16.ArrowExit())"
                              OnClick="@(() => NavigationManager.NavigateTo("/"))">
                    Sair
                </FluentButton>

            </div>
        </div>  
        <hr />
        @if (_isLoading)
        {
            <FluentProgressRing>A carregar o prompt...</FluentProgressRing>
        }
        else
        {
            <FluentTextArea @bind-Value="EditorContent"
                            Rows="30"
                            Resize="TextAreaResize.Vertical"
                            Style="width: 100%;" />
        }
    </div>

</div>
<FluentToastProvider />
<FluentMenuProvider />

<style>

    /* ===== Layout ===== */

    .edit-prompts-main {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        width: calc(100% - 1.5rem);
        box-sizing: border-box;
        height: calc(100vh - 64px);
        overflow: hidden;
        max-width: 100%;
        align-items: stretch;
    }

        .edit-prompts-main > * {
            min-width: 0;
            box-sizing: border-box;
            overflow: visible;
        }

    /* ===== LEFT: Prompt Editor ===== */

    .prompt-editor-pane {
        flex: 0 0 60%;
        min-width: 0;
        height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
        padding-right: 0.5rem;
        padding-left: 0.5rem;
        box-sizing: border-box;
    }

    .prompt-header-row {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .dropdown-container {
        width: 100%;
        max-width: 400px;
        box-sizing: border-box;
    }

        .dropdown-container fluent-select {
            width: 100% !important;
        }

    .prompt-actions {
        margin-left: 10px;
        margin-right: 10px;
        display: flex;
        gap: 0.8rem;
        justify-content: flex-end;
        align-items: center;
    }

    /* Forçar FluentTextArea a ocupar toda a largura disponível */
    .prompt-editor-pane fluent-text-area {
        width: 100% !important;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 1rem;
    }

    @@media (max-width: 900px) {

        .edit-prompts-main {
            flex-direction: column;
            gap: 1rem;
        }

        .prompt-editor-pane,
        .readme-pane {
            width: 100%;
            max-width: 100%;
            height: auto;
            border-right: none;
            padding: 1rem;
        }

        .dropdown-container {
            width: 100%;
        }

        .prompt-header-row {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }

        .prompt-actions {
            justify-content: flex-end;
        }
    }
</style>
